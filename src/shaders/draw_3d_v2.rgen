//! Ray generation shader for draw_3d_v2
//!
//! Implements ray generation and tracing.

struct CameraUniform
{
    float4x4 projectionView;
    float4x4 inverseProjectionView;
    float3 cameraPosition;
    uint _pad0;
};

struct Payload
{
    float3 color;
    float2 texcoord;
    uint hit;
};

// Set 0: Output image
[[vk::binding(0, 0)]]
RWTexture2D<float4> outputImage;

// Set 1: Acceleration structure
[[vk::binding(0, 1)]]
RaytracingAccelerationStructure topLevelAS;

// Set 2: Camera uniform
[[vk::binding(0, 2)]]
ConstantBuffer<CameraUniform> cameraUniform;

[shader("raygeneration")]
void main()
{
    uint2 launchID = DispatchRaysIndex().xy;
    uint2 launchSize = DispatchRaysDimensions().xy;
    
    // Compute normalized device coordinates
    float2 ndc = (float2(launchID) + 0.5) / float2(launchSize) * 2.0 - 1.0;
    ndc.y = -ndc.y; // Flip Y for Vulkan
    
    // Transform NDC to world space ray
    float4 origin = mul(cameraUniform.inverseProjectionView, float4(ndc, 0.0, 1.0));
    float4 target = mul(cameraUniform.inverseProjectionView, float4(ndc, 1.0, 1.0));
    origin.xyz /= origin.w;
    target.xyz /= target.w;
    
    float3 direction = normalize(target.xyz - origin.xyz);
    
    // Setup ray description
    RayDesc ray;
    ray.Origin = origin.xyz;
    ray.Direction = direction;
    ray.TMin = 0.001;
    ray.TMax = 10000.0;
    
    // Trace ray
    Payload payload;
    payload.color = float3(0.1, 0.1, 0.2); // Background color
    payload.texcoord = float2(0.0, 0.0);
    payload.hit = 0;
    
    TraceRay(
        topLevelAS,
        RAY_FLAG_NONE,
        0xFF, // cull mask
        0,    // sbt ray contribution offset
        0,    // sbt ray contribution stride
        0,    // miss index
        ray,
        payload
    );
    
    // Write output
    outputImage[launchID] = float4(payload.color, 1.0);
}
