export {
	ImageData,
	image_write_png,
	image_read_png,
	image_free,
};

import { "status.resin" };

struct ImageData { width: uint, height: uint, channels: uint, pixels: Ptr<ubyte> };

def image_write_png(path: Ptr<ubyte>, width: uint, height: uint, channels: uint, pixels: Ptr<ubyte>, stride: ulong) -> Result<(), RuntimeError> = {
	status(resin_image_write_png(path, width, height, channels, pixels, stride))
};

def image_read_png(path: Ptr<ubyte>, channels: uint) -> Result<ImageData, RuntimeError> = {
	var width = uint(0);
	var height = uint(0);
	var actual_channels = uint(0);
	var pixels = Ptr<ubyte>(ulong(0));
	status(resin_image_read_png(path, channels, &width, &height, &actual_channels, &pixels))?;
	ok(ImageData { width = width, height = height, channels = actual_channels, pixels = pixels })
};

def image_free(pixels: Ptr<ubyte>) = {
	resin_image_free(pixels)
};

extern "resin_runtime.h" def resin_image_write_png(path: Ptr<ubyte>, width: uint, height: uint, channels: uint, pixels: Ptr<ubyte>, stride: ulong) -> int;
extern "resin_runtime.h" def resin_image_read_png(path: Ptr<ubyte>, channels: uint, width: Ptr<uint>, height: Ptr<uint>, actual_channels: Ptr<uint>, pixels: Ptr<Ptr<ubyte>>) -> int;
extern "resin_runtime.h" def resin_image_free(pixels: Ptr<ubyte>) -> ();
