export {
	read_byte,
	input,
	InputLine,
	InputError,
	EndOfInput,
	InputReadError,
	InputOutOfMemory,
	InputWriteError,
	print_input,
};

extern "stdio.h" def getchar() -> int;
extern "resin_runtime/console.h" def resin_console_byte(byte: int) -> ubyte;
extern "resin_runtime/console.h" def resin_console_putchar(byte: ubyte) -> int;
extern "resin_runtime/console.h" def resin_stdin_error() -> int;
extern "resin_runtime/console.h" def resin_stdout_flush() -> int;
extern "stdlib.h" def realloc(memory: Ptr<ubyte>, bytes: ulong) -> Ptr<ubyte>;
extern "stdlib.h" def free(memory: Ptr<ubyte>);

// Owns length bytes followed by a NUL. Copies retain the allocation.
struct InputLineOwner { data: Ptr<ubyte>, length: ulong };
type InputLine = Arc<InputLineOwner>;
impl InputLineOwner {
	def drop(self: Ptr<InputLineOwner>) = {
		free(self.data);
	};
}
struct EndOfInput {};
struct InputReadError {};
struct InputOutOfMemory {};
struct InputWriteError {};
type InputError = EndOfInput | InputReadError | InputOutOfMemory;

def read_byte() -> Result<ubyte, EndOfInput | InputReadError> = {
	var byte = getchar();
	check_input_end(byte, 0L)?;
	ok(resin_console_byte(byte))
};

def resize_input(memory: Ptr<ubyte>, capacity: ulong) -> Result<Ptr<ubyte>, InputOutOfMemory> = {
	var resized = realloc(memory, capacity);
	if (ulong(resized) == 0L) {
		err(InputOutOfMemory {})
	} else {
		ok(resized)
	}
};

def check_input_end(byte: int, length: ulong) -> Result<(), EndOfInput | InputReadError> = {
	if (byte < 0 && resin_stdin_error() != 0) {
		err(InputReadError {})
	} else {
		if (byte < 0 && length == 0L) {
			err(EndOfInput {})
		} else {
			ok(())
		}
	}
};

// Reads bytes through LF or EOF; only CR immediately before LF is stripped.
def input() -> Result<InputLine, InputError> = {
	var buffer = InputLine {
		data = resize_input(Ptr<ubyte>(0L), 128L)?,
		length = 128L,
	};
	var length = 0L;
	var byte = getchar();
	while (byte >= 0 && byte != 10) {
		if (length == buffer.length - 1L) {
			// Reserve the terminator and reject growth that would wrap.
			var grown: Result<ulong, InputOutOfMemory>;
			grown := if (buffer.length > 18446744073709551615L / 2L) {
				err(InputOutOfMemory {})
			} else {
				ok(buffer.length * 2L)
			};
			var capacity = grown?;
			buffer.data := resize_input(buffer.data, capacity)?;
			buffer.length := capacity;
		};
		Span<ubyte> { data = buffer.data, length = buffer.length }(length).* := resin_console_byte(byte);
		length := length + 1L;
		byte := getchar();
	};
	check_input_end(byte, length)?;
	if (byte == 10 && length > 0L) {
		if (Span<ubyte> { data = buffer.data, length = buffer.length }(length - 1L).* == 13B) {
			length := length - 1L;
		};
	};
	Span<ubyte> { data = buffer.data, length = buffer.length }(length).* := 0B;
	buffer.length := length;
	ok(buffer)
};

// Writes every byte (including embedded NULs), flushes, and adds no newline.
def print_input(line: InputLine) -> Result<(), InputWriteError> = {
	var bytes = Span<ubyte> { data = line.data, length = line.length };
	var index = 0L;
	var written = 0;
	while (index < line.length && written >= 0) {
		written := resin_console_putchar(bytes(index).*);
		index := index + 1L;
	};
	var flushed = resin_stdout_flush();
	if (written < 0 || flushed != 0) {
		err(InputWriteError {})
	} else {
		ok(())
	}
};
