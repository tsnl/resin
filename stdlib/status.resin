export {
    resin_status_incomplete,
    resin_status_string,
    check,
};

def resin_status_incomplete() -> int = { 7 };

extern "resin_runtime.h" def resin_status_string(status: int) -> Ptr<ubyte>;

extern "stdlib.h" def exit(status: int) -> ();

def check(status: int) -> () = {
    if (status != 0) {
        print("runtime error {0}\n", (status,));
        exit(status)
    } else { () }
};
