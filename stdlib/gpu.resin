export {
	Gpu,
	GpuBuffer,
	GpuImage,
	GpuPipeline,
	GpuCommands,
	ResinGpu,
	ResinGpuDeviceInfo,
	ResinAllocation,
	ResinImage,
	ResinPipeline,
	ResinCommandBuffer,
	memory_default,
	memory_gpu,
	memory_readback,
	gpu_device_count,
	gpu_enumerate_devices,
	gpu_create,
	gpu_create_at,
	gpu_malloc,
	allocation_host_pointer,
	allocation_device_pointer,
	allocation_size,
	gpu_host_to_device_pointer,
	gpu_create_compute_pipeline,
	gpu_create_graphics_pipeline,
	gpu_create_image,
	image_width,
	image_height,
	gpu_start_command_recording,
	gpu_set_pipeline,
	gpu_dispatch,
	gpu_begin_rendering,
	gpu_end_rendering,
	gpu_draw,
	gpu_copy_image_to_buffer,
	gpu_submit,
	gpu_cancel_command_buffer,
};

import { "status.resin", "resources.resin" };

def memory_default() -> int = {
	0
};
def memory_gpu() -> int = {
	1
};
def memory_readback() -> int = {
	2
};

def gpu_device_count() -> Result<uint, RuntimeError> = {
	var count = uint(0);
	status(resin_gpu_device_count(&count))?;
	ok(count)
};

def gpu_enumerate_devices(infos: Ptr<ResinGpuDeviceInfo>, count: uint) -> Result<(), RuntimeError> = {
	status(resin_gpu_enumerate_devices(infos, count))
};

def gpu_create() -> Result<Gpu, RuntimeError> = {
	var gpu = Ptr<ResinGpu>(ulong(0));
	status(resin_gpu_create(&gpu))?;
	ok(Gpu { handle = gpu, window = None })
};

def gpu_create_at(index: uint) -> Result<Gpu, RuntimeError> = {
	var gpu = Ptr<ResinGpu>(ulong(0));
	status(resin_gpu_create_at(index, &gpu))?;
	ok(Gpu { handle = gpu, window = None })
};

def gpu_malloc(gpu: Gpu, bytes: ulong, alignment: ulong, memory: int) -> Result<GpuBuffer, RuntimeError> = {
	var allocation = Ptr<ResinAllocation>(ulong(0));
	status(resin_gpu_malloc(gpu.handle, bytes, alignment, memory, &allocation))?;
	ok(GpuBuffer { handle = allocation, gpu = gpu })
};

// Returned addresses borrow the allocation. Keep the caller's buffer alive while using them.
def allocation_host_pointer(allocation: Ptr<GpuBuffer>) -> Ptr<ubyte> = {
	resin_allocation_host_pointer(allocation.handle)
};

def allocation_device_pointer(allocation: Ptr<GpuBuffer>) -> ulong = {
	resin_allocation_device_pointer(allocation.handle)
};

def allocation_size(allocation: GpuBuffer) -> ulong = {
	resin_allocation_size(allocation.handle)
};

def gpu_host_to_device_pointer(gpu: Gpu, host: Ptr<ubyte>) -> Result<ulong, RuntimeError> = {
	var device = ulong(0);
	status(resin_gpu_host_to_device_pointer(gpu.handle, host, &device))?;
	ok(device)
};

def gpu_create_compute_pipeline(gpu: Gpu, code: Span<ubyte>) -> Result<GpuPipeline, RuntimeError> = {
	var pipeline = Ptr<ResinPipeline>(ulong(0));
	status(resin_gpu_create_compute_pipeline(gpu.handle, code.data, code.length, &pipeline))?;
	ok(GpuPipeline { handle = pipeline, gpu = gpu })
};

def gpu_create_graphics_pipeline(gpu: Gpu, vertex: Span<ubyte>, fragment: Span<ubyte>) -> Result<GpuPipeline, RuntimeError> = {
	var pipeline = Ptr<ResinPipeline>(ulong(0));
	status(resin_gpu_create_graphics_pipeline(gpu.handle, vertex.data, vertex.length, fragment.data, fragment.length, &pipeline))?;
	ok(GpuPipeline { handle = pipeline, gpu = gpu })
};

def gpu_create_image(gpu: Gpu, width: uint, height: uint) -> Result<GpuImage, RuntimeError> = {
	var image = Ptr<ResinImage>(ulong(0));
	status(resin_gpu_create_image(gpu.handle, width, height, &image))?;
	ok(GpuImage { handle = image, gpu = gpu })
};

def image_width(image: GpuImage) -> uint = {
	resin_image_width(image.handle)
};

def image_height(image: GpuImage) -> uint = {
	resin_image_height(image.handle)
};

def gpu_start_command_recording(gpu: Gpu) -> Result<GpuCommands, RuntimeError> = {
	var commands = Ptr<ResinCommandBuffer>(ulong(0));
	status(resin_gpu_start_command_recording(gpu.handle, &commands))?;
	ok(GpuCommands { handle = commands, gpu = gpu, retained = None })
};

def gpu_set_pipeline(commands: GpuCommands, pipeline: GpuPipeline) -> Result<(), RuntimeError> = {
	status(resin_gpu_set_pipeline(commands.handle, pipeline.handle))?;
	commands.retain(pipeline, None, None);
	ok(())
};

def gpu_dispatch(commands: GpuCommands, root: ulong, x: uint, y: uint, z: uint) -> Result<(), RuntimeError> = {
	status(resin_gpu_dispatch(commands.handle, root, x, y, z))
};

def gpu_begin_rendering(commands: GpuCommands, image: GpuImage, r: float32, g: float32, b: float32, a: float32) -> Result<(), RuntimeError> = {
	status(resin_gpu_begin_rendering(commands.handle, image.handle, r, g, b, a))?;
	commands.retain(None, image, None);
	ok(())
};

def gpu_end_rendering(commands: GpuCommands) -> Result<(), RuntimeError> = {
	status(resin_gpu_end_rendering(commands.handle))
};

def gpu_draw(commands: GpuCommands, root: ulong, count: uint) -> Result<(), RuntimeError> = {
	status(resin_gpu_draw(commands.handle, root, count))
};

def gpu_copy_image_to_buffer(commands: GpuCommands, image: GpuImage, buffer: GpuBuffer) -> Result<(), RuntimeError> = {
	status(resin_gpu_copy_image_to_buffer(commands.handle, image.handle, buffer.handle))?;
	commands.retain(None, image, buffer);
	ok(())
};

def gpu_submit(gpu: Gpu, commands: Ptr<GpuCommands>) -> Result<(), RuntimeError> = {
	var recording = replace(&commands.handle, Ptr<ResinCommandBuffer>(0L));
	var code = resin_gpu_submit(commands.gpu.handle, recording);
	commands.retained := None;
	status(code)
};

def gpu_cancel_command_buffer(gpu: Gpu, commands: Ptr<GpuCommands>) = {
	var recording = replace(&commands.handle, Ptr<ResinCommandBuffer>(0L));
	resin_gpu_cancel_command_buffer(commands.gpu.handle, recording);
	commands.retained := None;
};

extern "resin_runtime.h" def resin_gpu_device_count(count: Ptr<uint>) -> int;
extern "resin_runtime.h" def resin_gpu_enumerate_devices(infos: Ptr<ResinGpuDeviceInfo>, count: uint) -> int;
extern "resin_runtime.h" def resin_gpu_create(gpu: Ptr<Ptr<ResinGpu>>) -> int;
extern "resin_runtime.h" def resin_gpu_create_at(index: uint, gpu: Ptr<Ptr<ResinGpu>>) -> int;
extern "resin_runtime.h" def resin_gpu_destroy(gpu: Ptr<ResinGpu>) -> ();
extern "resin_runtime.h" def resin_gpu_malloc(gpu: Ptr<ResinGpu>, bytes: ulong, alignment: ulong, memory: int, allocation: Ptr<Ptr<ResinAllocation>>) -> int;
extern "resin_runtime.h" def resin_gpu_free(gpu: Ptr<ResinGpu>, allocation: Ptr<ResinAllocation>) -> ();
extern "resin_runtime.h" def resin_allocation_host_pointer(allocation: Ptr<ResinAllocation>) -> Ptr<ubyte>;
extern "resin_runtime.h" def resin_allocation_device_pointer(allocation: Ptr<ResinAllocation>) -> ulong;
extern "resin_runtime.h" def resin_allocation_size(allocation: Ptr<ResinAllocation>) -> ulong;
extern "resin_runtime.h" def resin_gpu_host_to_device_pointer(gpu: Ptr<ResinGpu>, host: Ptr<ubyte>, device: Ptr<ulong>) -> int;
extern "resin_runtime.h" def resin_gpu_create_compute_pipeline(gpu: Ptr<ResinGpu>, code: Ptr<ubyte>, length: ulong, pipeline: Ptr<Ptr<ResinPipeline>>) -> int;
extern "resin_runtime.h" def resin_gpu_create_graphics_pipeline(gpu: Ptr<ResinGpu>, vertex: Ptr<ubyte>, vertex_length: ulong, fragment: Ptr<ubyte>, fragment_length: ulong, pipeline: Ptr<Ptr<ResinPipeline>>) -> int;
extern "resin_runtime.h" def resin_gpu_free_pipeline(gpu: Ptr<ResinGpu>, pipeline: Ptr<ResinPipeline>) -> ();
extern "resin_runtime.h" def resin_gpu_create_image(gpu: Ptr<ResinGpu>, width: uint, height: uint, image: Ptr<Ptr<ResinImage>>) -> int;
extern "resin_runtime.h" def resin_gpu_free_image(gpu: Ptr<ResinGpu>, image: Ptr<ResinImage>) -> ();
extern "resin_runtime.h" def resin_image_width(image: Ptr<ResinImage>) -> uint;
extern "resin_runtime.h" def resin_image_height(image: Ptr<ResinImage>) -> uint;
extern "resin_runtime.h" def resin_gpu_start_command_recording(gpu: Ptr<ResinGpu>, commands: Ptr<Ptr<ResinCommandBuffer>>) -> int;
extern "resin_runtime.h" def resin_gpu_set_pipeline(commands: Ptr<ResinCommandBuffer>, pipeline: Ptr<ResinPipeline>) -> int;
extern "resin_runtime.h" def resin_gpu_dispatch(commands: Ptr<ResinCommandBuffer>, root: ulong, x: uint, y: uint, z: uint) -> int;
extern "resin_runtime.h" def resin_gpu_begin_rendering(commands: Ptr<ResinCommandBuffer>, image: Ptr<ResinImage>, r: float32, g: float32, b: float32, a: float32) -> int;
extern "resin_runtime.h" def resin_gpu_end_rendering(commands: Ptr<ResinCommandBuffer>) -> int;
extern "resin_runtime.h" def resin_gpu_draw(commands: Ptr<ResinCommandBuffer>, root: ulong, count: uint) -> int;
extern "resin_runtime.h" def resin_gpu_copy_image_to_buffer(commands: Ptr<ResinCommandBuffer>, image: Ptr<ResinImage>, buffer: Ptr<ResinAllocation>) -> int;
extern "resin_runtime.h" def resin_gpu_submit(gpu: Ptr<ResinGpu>, commands: Ptr<ResinCommandBuffer>) -> int;
extern "resin_runtime.h" def resin_gpu_cancel_command_buffer(gpu: Ptr<ResinGpu>, commands: Ptr<ResinCommandBuffer>) -> ();
