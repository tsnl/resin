export { Window, ResinWindow, ButtonState, KeyCodes, MouseButtons };

import { "status.resin" };

struct ButtonState { down: bool, pressed: bool, released: bool };

def button_state(bits: uint) -> ButtonState = {
	ButtonState { down = (bits & 1I) != 0I, pressed = (bits & 2I) != 0I, released = (bits & 4I) != 0I }
};

extern type ResinWindow;
struct WindowOwner { handle: Ptr<ResinWindow> };
type Window = Arc<WindowOwner>;
impl WindowOwner {
	def drop(self: Ptr<WindowOwner>) = {
		resin_window_destroy(self.handle);
	};

	def key_escape() -> int = {
		256
	};
	def new(width: uint, height: uint, title: String) -> Result<Window, RuntimeError> = {
		var window = Ptr<ResinWindow>(ulong(0));
		RuntimeStatus.from_code(resin_window_create(width, height, title.bytes.data, &window))?;
		ok(Window { handle = window })
	};
	def poll_events(self: Window) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_window_poll_events(self.handle))
	};
	def should_close(self: Window) -> bool = {
		resin_window_should_close(self.handle) != 0
	};
	def set_should_close(self: Window, close: bool) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(
			resin_window_set_should_close(
				self.handle,
				if (close) {
					1
				} else {
					0
				}
			)
		)
	};
	def framebuffer_size(self: Window) -> Result<(uint, uint), RuntimeError> = {
		var width = uint(0);
		var height = uint(0);
		RuntimeStatus.from_code(resin_window_framebuffer_size(self.handle, &width, &height))?;
		ok((width, height))
	};
	def set_size(self: Window, width: uint, height: uint) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_window_set_size(self.handle, width, height))
	};
	def key_pressed(self: Window, key: int) -> bool = {
		resin_window_key_pressed(self.handle, key) != 0
	};
	def key_state(self: Window, key: int) -> ButtonState = {
		button_state(resin_window_key_state(self.handle, key))
	};
	def mouse_button_state(self: Window, button: int) -> ButtonState = {
		button_state(resin_window_mouse_button_state(self.handle, button))
	};
	def cursor_position(self: Window) -> Result<(float64, float64), RuntimeError> = {
		var x = 0.0d;
		var y = 0.0d;
		RuntimeStatus.from_code(resin_window_cursor_position(self.handle, &x, &y))?;
		ok((x, y))
	};
	def scroll_delta(self: Window) -> Result<(float64, float64), RuntimeError> = {
		var x = 0.0d;
		var y = 0.0d;
		RuntimeStatus.from_code(resin_window_scroll_delta(self.handle, &x, &y))?;
		ok((x, y))
	};
	def focused(self: Window) -> bool = {
		resin_window_focused(self.handle) != 0
	};
	def capture_cursor(self: Window, capture: bool) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(
			resin_window_capture_cursor(
				self.handle,
				if (capture) {
					1
				} else {
					0
				}
			)
		)
	};
	def keys() -> KeyCodes = {
		KeyCodes {
			unknown = -1,
			space = 32,
			apostrophe = 39,
			comma = 44,
			minus = 45,
			period = 46,
			slash = 47,
			digit_0 = 48,
			digit_1 = 49,
			digit_2 = 50,
			digit_3 = 51,
			digit_4 = 52,
			digit_5 = 53,
			digit_6 = 54,
			digit_7 = 55,
			digit_8 = 56,
			digit_9 = 57,
			semicolon = 59,
			equal = 61,
			a = 65,
			b = 66,
			c = 67,
			d = 68,
			e = 69,
			f = 70,
			g = 71,
			h = 72,
			i = 73,
			j = 74,
			k = 75,
			l = 76,
			m = 77,
			n = 78,
			o = 79,
			p = 80,
			q = 81,
			r = 82,
			s = 83,
			t = 84,
			u = 85,
			v = 86,
			w = 87,
			x = 88,
			y = 89,
			z = 90,
			left_bracket = 91,
			backslash = 92,
			right_bracket = 93,
			grave_accent = 96,
			world_1 = 161,
			world_2 = 162,
			escape = 256,
			enter = 257,
			tab = 258,
			backspace = 259,
			insert = 260,
			delete = 261,
			right = 262,
			left = 263,
			down = 264,
			up = 265,
			page_up = 266,
			page_down = 267,
			home = 268,
			end = 269,
			caps_lock = 280,
			scroll_lock = 281,
			num_lock = 282,
			print_screen = 283,
			pause = 284,
			f1 = 290,
			f2 = 291,
			f3 = 292,
			f4 = 293,
			f5 = 294,
			f6 = 295,
			f7 = 296,
			f8 = 297,
			f9 = 298,
			f10 = 299,
			f11 = 300,
			f12 = 301,
			f13 = 302,
			f14 = 303,
			f15 = 304,
			f16 = 305,
			f17 = 306,
			f18 = 307,
			f19 = 308,
			f20 = 309,
			f21 = 310,
			f22 = 311,
			f23 = 312,
			f24 = 313,
			f25 = 314,
			keypad_0 = 320,
			keypad_1 = 321,
			keypad_2 = 322,
			keypad_3 = 323,
			keypad_4 = 324,
			keypad_5 = 325,
			keypad_6 = 326,
			keypad_7 = 327,
			keypad_8 = 328,
			keypad_9 = 329,
			keypad_decimal = 330,
			keypad_divide = 331,
			keypad_multiply = 332,
			keypad_subtract = 333,
			keypad_add = 334,
			keypad_enter = 335,
			keypad_equal = 336,
			left_shift = 340,
			left_control = 341,
			left_alt = 342,
			left_super = 343,
			right_shift = 344,
			right_control = 345,
			right_alt = 346,
			right_super = 347,
			menu = 348,
		}
	};
	def mouse_buttons() -> MouseButtons = {
		MouseButtons { left = 0, right = 1, middle = 2, button_4 = 3, button_5 = 4, button_6 = 5, button_7 = 6, button_8 = 7 }
	};
}

