export { main };
import { "$/string.resin", "$/stdio.resin" };

const (
	can_read: u32 = 1 << iota;
	can_write: u32 = 1 << iota;
	_ = iota;
	can_execute: u32 = 1 << iota;
);

struct Pair<T> {
	first: T,
	second: T,
}
const pair_bytes = sizeof(Pair<i32>);

fn main() {
	const permissions = can_read | can_write;
	let message = fmt("read/write = {0}, execute = {1}, pair bytes = {2}\n", (permissions, can_execute, pair_bytes));
	print(message);
}
