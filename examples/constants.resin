export { main };
import { "$/string.resin" };

const (
	read: uint = 1 << iota;
	write;
	_;
	execute;
);

struct Pair<T> { first: T, second: T };
const pair_bytes = sizeof(Pair<int>);

def main() = {
	const permissions = read | write;
	print(fmt("read/write = {0}, execute = {1}, pair bytes = {2}\n", (permissions, execute, pair_bytes)));
};
