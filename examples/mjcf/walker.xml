<mujoco model="planar walker">
  <option timestep="0.005"/>
  <worldbody>
    <geom type="plane" size="20 20 1"/>
    <body name="torso" pos="0 0 1.05">
      <freejoint/>
      <geom type="box" size="0.12 0.08 0.25" density="800"/>
      <body name="left_thigh" pos="0 0.09 -0.3">
        <joint name="left_hip" type="hinge" pos="0 0 0.15" axis="0 1 0"/>
        <geom type="box" size="0.05 0.04 0.15" density="900"/>
        <body name="left_shin" pos="0 0 -0.32">
          <joint name="left_knee" type="hinge" pos="0 0 0.16" axis="0 1 0"/>
          <geom type="box" size="0.04 0.035 0.16" density="900"/>
        </body>
      </body>
      <body name="right_thigh" pos="0 -0.09 -0.3">
        <joint name="right_hip" type="hinge" pos="0 0 0.15" axis="0 1 0"/>
        <geom type="box" size="0.05 0.04 0.15" density="900"/>
        <body name="right_shin" pos="0 0 -0.32">
          <joint name="right_knee" type="hinge" pos="0 0 0.16" axis="0 1 0"/>
          <geom type="box" size="0.04 0.035 0.16" density="900"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="left_hip" joint="left_hip" gear="40" ctrlrange="-1 1"/>
    <motor name="left_knee" joint="left_knee" gear="30" ctrlrange="-1 1"/>
    <motor name="right_hip" joint="right_hip" gear="40" ctrlrange="-1 1"/>
    <motor name="right_knee" joint="right_knee" gear="30" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
