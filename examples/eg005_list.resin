export { main };

import { "$/string.resin", "$/stdio.resin", "$/shared.resin" };

struct List {
	value: i32,
	next: PtrMut<List>,
}

fn cons(value: i32, next: PtrMut<List>) -> List {
	List { value = value, next = next }
}

fn car(node: Ref<List>) -> i32 {
	node.value
}

fn cdr(node: Ref<List>) -> PtrMut<List> {
	node.next
}

fn at(p: PtrMut<List>) -> i32 {
	p.value
}

fn main() -> () | Err<_> {
	let tail = arc_ptr_alloc(cons(2, PtrMut<List>(u64(0))))?;
	let mut head = cons(1, tail:get());
	let text = fmt("list = {0}, {1}\n", (car(head), at(cdr(head))));
	print(text);
}
