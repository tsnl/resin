export { main };

import { "$/string.resin", "$/stdio.resin", "$/shared.resin" };

struct List {
	value: int,
	next: Ptr<List>,
}

fn cons(value: int, next: Ptr<List>) -> List {
	List { value = value, next = next }
}

fn car(node: Ref<List>) -> int {
	node.value
}

fn cdr(node: Ref<List>) -> Ptr<List> {
	node.next
}

fn at(p: Ptr<List>) -> int {
	p.value
}

fn main() -> () | Err<_> {
	let tail = arc_ptr_alloc(cons(2, Ptr<List>(ulong(0))))?;
	let mut head = cons(1, tail:get());
	print(fmt("list = {0}, {1}\n", (car(head), at(cdr(head)))));
}
