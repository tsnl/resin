List = { value: int, next: Ptr (List) };
cons (value: int, next: Ptr (List)) -> List = { List { value = value, next = next } };
car (node: List) -> int = { node.value };
cdr (node: List) -> Ptr (List) = { node.next };
at (p: Ptr (List)) -> int = { p.value };

main () -> () = {
    tail = cons(2, Ptr (List) (ulong (0)));
    head = cons(1, &tail);
    print("list = {0}, {1}\n", (car(head), at(cdr(head))));
};
