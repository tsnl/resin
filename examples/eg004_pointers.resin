export { main };

import { "$/string.resin", "$/stdio.resin", "$/shared.resin" };

fn set(p: Ptr<int>) -> int {
	p.* = 1;
	p.*
}

struct Point {
	x: int,
	y: int,
}

fn get_x(p: Ptr<Point>) -> int {
	p.x
}

fn set_x(p: Ptr<Point>, n: int) -> int {
	p.x = n;
	p.x
}

fn main() -> () | Err<_> {
	let n = arc_ptr_alloc(0_i)?;
	let point = arc_ptr_alloc(Point { x = 0, y = 2 })?;
	set(n:get());
	set_x(point:get(), 42);
	print(fmt("n = {0}, point.x = {1}\n", (n:get().*, get_x(point:get()))));
}
