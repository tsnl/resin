set(p: Ptr<int>) -> int = { p.* := 1; p.* };

Point = { x: int, y: int };
get_x(p: Ptr<Point>) -> int = { p.x };
set_x(p: Ptr<Point>, n: int) -> int = { p.x := n; p.x };

main() -> () = {
    n = 0;
    point = Point { x = 0, y = 2 };
    set(&n);
    set_x(&point, 42);
    print("n = {0}, point.x = {1}\n", (n, get_x(&point)));
};
