export { main };

def set(p: Ptr<int>) -> int = { p.* := 1; p.* };

type Point = { x: int, y: int };
def get_x(p: Ptr<Point>) -> int = { p.x };
def set_x(p: Ptr<Point>, n: int) -> int = { p.x := n; p.x };

def main() -> () = {
    var n = 0;
    var point = Point { x = 0, y = 2 };
    set(&n);
    set_x(&point, 42);
    print("n = {0}, point.x = {1}\n", (n, get_x(&point)));
};
