export { main };

import { "$/string.resin" };

fn set(p: Ptr<int>) -> int {
	p.* = 1;
	p.*
}

struct Point {
	x: int,
	y: int,
}

fn get_x(p: Ptr<Point>) -> int {
	p.x
}

fn set_x(p: Ptr<Point>, n: int) -> int {
	p.x = n;
	p.x
}

fn main() -> () {
	let mut n = 0;
	let mut point = Point { x = 0, y = 2 };
	set(&n);
	set_x(&point, 42);
	print(fmt("n = {0}, point.x = {1}\n", (n, get_x(&point))));
}
