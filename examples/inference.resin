export { main };

import { "$/string.resin", "$/stdio.resin", "$/shared.resin" };

fn fibonacci(n: int) -> _ {
	if (n <= 1) {
		n
	} else {
		fibonacci(n - 1) + fibonacci(n - 2)
	}
}

fn main() -> () | Err<_> {
	let mut n: _;
	let mut pointer: Ptr<_>;
	n = arc_ptr_alloc(fibonacci(10))?;
	pointer = n:get();
	print(fmt("fibonacci(10) = {0}\n", (pointer.*,)));
}
