export { main };
import { "$/string.resin", "$/stdio.resin" };

struct Vec2<T> {
	x: T,
	y: T,
}
fn __add__<T>(left: Ref<Vec2<T>>, right: Ref<Vec2<T>>) -> Vec2<T> {
	Vec2<T> { x = left.x + right.x, y = left.y + right.y }
}

fn __sub__<T>(left: Ref<Vec2<T>>, right: Ref<Vec2<T>>) -> Vec2<T> {
	Vec2<T> { x = left.x - right.x, y = left.y - right.y }
}

fn __neg__<T>(value: Ref<Vec2<T>>) -> Vec2<T> {
	Vec2<T> { x = -value.x, y = -value.y }
}

fn __mul__<T>(value: Ref<Vec2<T>>, scale: Ref<T>) -> Vec2<T> {
	Vec2<T> { x = value.x * scale, y = value.y * scale }
}

fn __eq__<T>(left: Ref<Vec2<T>>, right: Ref<Vec2<T>>) -> bool {
	left.x == right.x && left.y == right.y
}

// The same helper uses primitive addition or a struct's overload.
fn twice<T>(value: Ref<T>) -> _ {
	value + value
}

fn main() {
	let mut position = Vec2<i32> { x = 1, y = 2 };
	let mut velocity = Vec2<i32> { x = 3, y = 4 };
	let scale = 2;
	let step = velocity * scale;
	let mut next = position + step;
	let mut displacement = next - position;
	let mut reverse = -velocity;
	let position_text = fmt("position = ({0}, {1}), displacement = ({2}, {3})\n", (next.x, next.y, displacement.x, displacement.y));
	print(position_text);
	let number = 21;
	let reverse_text = fmt("reverse = ({0}, {1}), twice(21) = {2}\n", (reverse.x, reverse.y, twice(number)));
	print(reverse_text);
	let doubled = twice(velocity);
	if (doubled == displacement) {
		print("generic vector addition agrees\n");
	};
}
