export { main };
import { "$/string.resin" };

struct Vec2<T> {
	x: T,
	y: T,
}
fn __add__<T>(left: Vec2<T>, right: Vec2<T>) -> Vec2<T> {
	Vec2<T> { x = left.x + right.x, y = left.y + right.y }
}

fn __sub__<T>(left: Vec2<T>, right: Vec2<T>) -> Vec2<T> {
	Vec2<T> { x = left.x - right.x, y = left.y - right.y }
}

fn __neg__<T>(value: Vec2<T>) -> Vec2<T> {
	Vec2<T> { x = -value.x, y = -value.y }
}

fn __mul__<T>(value: Vec2<T>, scale: T) -> Vec2<T> {
	Vec2<T> { x = value.x * scale, y = value.y * scale }
}

fn __eq__<T>(left: Vec2<T>, right: Vec2<T>) -> bool {
	left.x == right.x && left.y == right.y
}

// The same helper uses primitive addition or a struct's overload.
fn twice<T>(value: T) -> _ {
	value + value
}

fn main() {
	let mut position = Vec2<int> { x = 1, y = 2 };
	let mut velocity = Vec2<int> { x = 3, y = 4 };
	let mut next = position + velocity * 2;
	let mut displacement = next - position;
	let mut reverse = -velocity;
	print(fmt("position = ({0}, {1}), displacement = ({2}, {3})\n", (next.x, next.y, displacement.x, displacement.y)));
	print(fmt("reverse = ({0}, {1}), twice(21) = {2}\n", (reverse.x, reverse.y, twice(21))));
	if (twice(velocity) == displacement) {
		print("generic vector addition agrees\n");
	};
}
