export { main };

import { "$/string.resin", "$/stdio.resin" };

fn add(x: i32, y: i32) -> i32 {
	x + y
}

fn apply(f: (i32, i32) -> i32, x: i32, y: i32) -> i32 {
	f(x, y)
}

fn inc(n: i32) -> i32 {
	apply(add, n, 1)
}

fn main() -> () {
	let text = fmt("inc(41) = {0}\n", (inc(41),));
	print(text);
}
