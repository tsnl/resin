export { kernel, main };

import { "std/gpu.resin", "std/image.resin" };

struct Root { pixels: Span<uint> };

def pixel(index: uint) -> uint = {
	0xff400000_ui | (index & 0xffff_ui)
};

@compute_shader
def kernel(index: ulong, root: Ptr<Root>) = {
	if (index < root.pixels.length) {
		root.pixels.at(index).* := pixel(uint(index));
	};
};

def main() -> Result<(), _> = {
	var gpu = Gpu.new()?;

	var pipeline = gpu.create_compute_pipeline(kernel.spirv)?;

	var width = 256_ui;
	var height = 256_ui;
	var count = ulong(width) * ulong(height);
	var pixels = gpu.malloc(count * size_of(uint), align_of(uint), Memory.default())?;

	var root = gpu.malloc(size_of(Root), align_of(Root), Memory.default())?;

	var data = Ptr<Root>(root.host_pointer());
	data.* := Root { pixels = Span<uint> { data = Ptr<uint>(pixels.device_pointer()), length = count } };
	var commands = gpu.start_command_recording()?;

	commands.set_pipeline(pipeline)?;
	// Compute shaders use 64 invocations per workgroup.
	var groups = uint((data.pixels.length + 63_ul) / 64_ul);
	commands.dispatch(root.device_pointer(), groups, 1, 1)?;
	commands.submit()?;

	var path = "gradient.png";
	ImageData.write_pixels(path.data, width, height, 4, pixels.host_pointer(), 0)?;
	print("wrote gradient.png\n");
	ok(())
};
