export { kernel, main };

import { "std/gpu.resin", "std/image.resin" };

struct Root { count: uint, pixels: Ptr<uint> };

def pixel(index: uint) -> uint = {
	0xff400000I | (index & 0xffffI)
};

@compute_shader
def kernel(index: uint, root: Ptr<Root>) = {
	if (index < root.count) {
		var pixels = Span<uint> { data = root.pixels, length = 65536L };
		pixels(index).* := pixel(index);
	};
};

def main() -> Result<(), _> = {
	var gpu = gpu_create()?;
	defer gpu_destroy(gpu);

	var pipeline = gpu_create_compute_pipeline(gpu, kernel.spirv)?;
	defer gpu_free_pipeline(gpu, pipeline);
	var pixels = gpu_malloc(gpu, 262144, 4, memory_default())?;
	defer gpu_free(gpu, pixels);
	var root = gpu_malloc(gpu, 16, 8, memory_default())?;
	defer gpu_free(gpu, root);
	var data = Ptr<Root>(allocation_host_pointer(root));
	data.* := Root { count = 65536I, pixels = Ptr<uint>(allocation_device_pointer(pixels)) };
	var commands = gpu_start_command_recording(gpu)?;
	defer gpu_cancel_command_buffer(gpu, &commands);
	gpu_set_pipeline(commands, pipeline)?;
	gpu_dispatch(commands, allocation_device_pointer(root), 1024, 1, 1)?;
	gpu_submit(gpu, &commands)?;

	var path = "gradient.png";
	image_write_png(Ptr<ubyte>(&path), 256, 256, 4, allocation_host_pointer(pixels), 0)?;
	print("wrote gradient.png\n", ());
	ok(())
};
