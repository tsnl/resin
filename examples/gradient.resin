export { kernel, main };

import { "std/gpu.resin", "std/image.resin" };

struct Root { count: uint, pixels: Ptr<uint> };

def pixel(index: uint) -> uint = {
	0xff400000I | (index & 0xffffI)
};

@compute_shader
def kernel(index: uint, root: Ptr<Root>) = {
	if (index < root.count) {
		var pixels = Span<uint> { data = root.pixels, length = 65536L };
		pixels(index).* := pixel(index);
	};
};

def main() -> Result<(), _> = {
	var gpu = Gpu.new()?;

	var pipeline = gpu.create_compute_pipeline(kernel.spirv)?;

	var pixels = gpu.malloc(65536L * size_of(uint), align_of(uint), Memory.default())?;

	var root = gpu.malloc(size_of(Root), align_of(Root), Memory.default())?;

	var data = Ptr<Root>(root.host_pointer());
	data.* := Root { count = 65536I, pixels = Ptr<uint>(pixels.device_pointer()) };
	var commands = gpu.start_command_recording()?;

	commands.set_pipeline(pipeline)?;
	commands.dispatch(root.device_pointer(), 1024, 1, 1)?;
	commands.submit()?;

	var path = "gradient.png";
	ImageData.write_pixels(Ptr<ubyte>(&path), 256, 256, 4, pixels.host_pointer(), 0)?;
	print("wrote gradient.png\n", ());
	ok(())
};
