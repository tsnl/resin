export { kernel, main };

import { "$/span.resin", "$/string.resin", "$/gpu.resin", "$/shared.resin", "$/image.resin" };

struct HostRoot { width: uint; height: uint; pixels: GpuSpan<uint>; }
struct Root { width: uint; height: uint; pixels: Span<uint>; }

fn pixel(index: uint) -> uint  {
	0xff400000_ui | (index & 0xffff_ui)
}

@compute_shader
fn kernel(index: ulong, root: Ptr<Root>)  {
	if (index < ulong(root.width) * ulong(root.height) && index < root.pixels.length) {
		root.pixels:at(index) = pixel(uint(index));
	};
}

fn main() -> (() | Err<_>)  {
	let mut gpu = gpu_new()?;

	let mut pipeline = gpu:create_compute_pipeline(kernel)?;

	let mut width = 256_ui;
	let mut height = 256_ui;
	let mut count = ulong(width) * ulong(height);
	let mut pixels = gpu:alloc::<uint>(count)?;
	let mut root = HostRoot { width = width, height = height, pixels = pixels };
	let mut commands = gpu:start_command_recording()?;

	let mut workgroup_size = gpu:compute_workgroup_size();
	let mut groups = uint((pixels.length + workgroup_size - 1_ul) / workgroup_size);
	commands:dispatch(pipeline, root, groups, 1, 1)?;
	commands:submit()?;

	let mut path = "gradient.png";
	let mut host = arc_span_alloc::<uint>(count, 0_ui)?;
	pixels:copy_to(host:get());
	image_data_write_pixels(path.data, width, height, 4, host:get():as_bytes(), 0)?;
	print("wrote gradient.png\n");
	(())
}
