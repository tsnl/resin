export { kernel, main };

import { "$/gpu.resin", "$/host.resin", "$/image.resin" };

struct Root { width: uint, height: uint, pixels: Span<uint> };

def pixel(index: uint) -> uint = {
	0xff400000_ui | (index & 0xffff_ui)
};

@compute_shader
def kernel(index: ulong, root: Ptr<Root>) = {
	if (index < ulong(root.width) * ulong(root.height) && index < root.pixels.length) {
		root.pixels.at(index).* := pixel(uint(index));
	};
};

def main() -> Result<(), _> = {
	var gpu = Gpu.new()?;

	var pipeline = gpu.create_compute_pipeline(kernel)?;

	var width = 256_ui;
	var height = 256_ui;
	var count = ulong(width) * ulong(height);
	var pixels = GpuSpan<uint>.allocate(gpu, count)?;
	var root = { width = width, height = height, pixels = pixels };
	var commands = gpu.start_command_recording()?;

	// Compute shaders use 64 invocations per workgroup.
	var groups = uint((pixels.length + 63_ul) / 64_ul);
	commands.dispatch(pipeline, root, groups, 1, 1)?;
	commands.submit()?;

	var path = "gradient.png";
	var host = Host.malloc(count * size_of(uint))?;
	pixels.copy_to(Span<uint> { data = Ptr<uint>(host), length = count });
	var written = ImageData.write_pixels(path.data, width, height, 4, host, 0);
	Host.free(host);
	written?;
	print("wrote gradient.png\n");
	ok(())
};
