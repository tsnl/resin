export { Options, parse_options, print_help };

import { "$/argparse.resin", "$/span.resin", "$/string.resin", "$/stdio.resin" };

struct Options {
	use_gpu: bool,
	width: uint,
	height: uint,
	iterations: int,
	samples: int,
	real: float32,
	imag: float32,
	span: float32,
	// Paths borrow the immutable, NUL-terminated process argument snapshot.
	output: Ptr<ubyte> | None,
	screenshot: Ptr<ubyte>,
	help: bool,
}

fn parse_options(args: Ref<Span<Ptr<ubyte>>>) -> Options | Err<_> {
	let mut options = Options {
		use_gpu = true,
		width = 960,
		height = 720,
		iterations = 256,
		samples = 4,
		real = -0.5_f,
		imag = 0.0_f,
		span = 3.0_f,
		output = None,
		screenshot = "mandelbrot.png".data,
		help = false,
	};
	let parser = argparse(args, "--help|-h --cpu --gpu --width= --height= --iterations= --samples= --real= --imag= --span= --output= --screenshot=");
	while (true) {
		let item = match (parser:next()?) {
			Argument(item) => {
				item
			},
			None => {
				break;
			},
		};
		if (item:named("--help")) {
			options.help = true;
			return options;
		};
		if (item:named("--cpu") || item:named("--gpu")) {
			options.use_gpu = item:named("--gpu");
			continue;
		};
		let value: Ref<Span<ubyte>> = item.value;
		if (item:named("--width")) {
			options.width = argument_integer(value)?;
		} else if (item:named("--height")) {
			options.height = argument_integer(value)?;
		} else if (item:named("--iterations")) {
			let count = argument_integer(value)?;
			if (count < 32_ui || count > 4096_ui) {
				return Err(string_from_str("Iterations must be between 32 and 4096"));
			};
			options.iterations = int(count);
		} else if (item:named("--samples")) {
			let count = argument_integer(value)?;
			if (count < 1_ui || count > 16_ui) {
				return Err(string_from_str("Samples must be between 1 and 16"));
			};
			options.samples = int(count);
		} else if (item:named("--real")) {
			options.real = argument_number(value)?;
		} else if (item:named("--imag")) {
			options.imag = argument_number(value)?;
		} else if (item:named("--span")) {
			options.span = argument_number(value)?;
		} else {
			if (value.length == 0_ul) {
				return Err(fmt("Empty path for {0}", (item.name:bytes(),)));
			};
			if (item:named("--output")) {
				options.output = value.data;
			} else {
				options.screenshot = value.data;
			};
		};
	};
	if (options.width == 0_ui || options.width > 8192_ui || options.height == 0_ui || options.height > 8192_ui) {
		return Err(string_from_str("Width and height must be between 1 and 8192"));
	};
	if (options.span < float32(options.height) * 1.0e-6_f || options.span > 8.0_f) {
		return Err(string_from_str("Span must be between height * 1e-6 and 8 (float32 precision limit)"));
	};
	options
}

fn print_help() {
	print("Mandelbrot explorer\n\n");
	print("Usage: resin examples/eg011_mandelbrot.resin -- [options]\n\n");
	print("  --cpu / --gpu        Solver (default: GPU)\n");
	print("  --width N           Image/window width, 1-8192 (default: 960)\n");
	print("  --height N          Image/window height, 1-8192 (default: 720)\n");
	print("  --iterations N      Iterations per sample, 32-4096 (default: 256)\n");
	print("  --samples N         Halton samples per pixel, 1-16 (default: 4)\n");
	print("  --real X --imag Y   View center (default: -0.5, 0)\n");
	print("  --span N            Vertical span (default: 3)\n");
	print("  --output PATH       Write a PNG and exit without opening a window\n");
	print("  --screenshot PATH   Interactive screenshot path (default: mandelbrot.png)\n");
	print("  --help / -h         Show this help\n\n");
	print("Arrows/WASD: pan | scroll/+/-: zoom | [/]: iterations | R/Home: reset | P: screenshot | Esc: quit\n");
	print("CPU --output mode needs no Vulkan device. Interactive mode uses Vulkan in both solver modes.\n");
}
