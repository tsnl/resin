export { main };
import { "fractal.resin", "$/math.resin" };

// ANCHOR: assertions
fn main() {
	assert(escape_iterations(complex(0.0_f, 0.0_f), 256) == 0);
	assert(escape_iterations(complex(-1.0_f, 0.0_f), 256) == 0);
	assert(escape_iterations(complex(-2.0_f, 0.0_f), 256) == 0);
	assert(escape_iterations(complex(0.0_f, 1.0_f), 256) == 0);
	assert(escape_iterations(complex(1.0_f, 0.0_f), 256) == 3);
	assert(escape_iterations(complex(2.0_f, 0.0_f), 256) == 2);
	assert(escape_iterations(complex(3.0_f, 0.0_f), 256) == 1);
	assert(escape_iterations(complex(2.0_f, 0.0_f), 1) == 0);
}
// ANCHOR_END: assertions
