export { main };

import { "$/string.resin", "$/stdio.resin" };

fn fibonacci(n: i32) -> i32 {
	if (n <= 1) {
		n
	} else {
		let mut f0 = fibonacci(n - 1);
		let mut f1 = fibonacci(n - 2);
		f0 + f1
	}
}

fn main() -> () {
	let text = fmt("fibonacci(10) = {0}\n", (fibonacci(10),));
	print(text);
}
