# Resin is a pure functional, statically typed, residualization-oriented programming language.
#
# It allows users to write computational graphs that can then be run on the GPU or CPU.
#
# Key elements:
# - Resin-Core: minimal FP calculus
#   All types are values, all functions are pure. Types use uppercase IDs by convention.
#   - Compile-time evaluation forced at specific sites, e.g. when used as types.
#   - Shape polymorphism achieved using total functions on shape parameters.
#     E.g. consider `matmul`.
#   - Properly tail-recursive: all non-tail-calls are inlined at comptime, may overflow a stack.
#   - `struct` is a regular builtin function
#   - Functions are not first-class. No closures supported at this time.
# - Backends: builtin operations that compilers support
#
# Comparison with `main-v9`
# - No hard distinction between types and values.
# - Simplified type checking, type inference.
# - Simplified syntax, no whitespace sensitivity, more ML style.

def factorial(n: int): int = {
  factorial_inner(n, 1)
};
def factorial_inner(n: int, a: int): int = {
  if n < 0 { panic("bad input") }
  else if n <= 1 { a }
  else { factorial_inner(n - 1, a * n) }
};

def Linear(T: type, i: usize, o: usize) = struct .{
  w: Ten(T, [o, i]),
  b: Ten(T, [o])
};

for T: type, i: usize, o: usize
def linear(model: Linear(T, i, o), input: Ten(T, [i])): Ten(T, [o]) = {
  let output = model.w @ input;
  let output = model.b + output;
  output
};
