# This is an example of a custom frontend for resin.
# Similar to Elm, but with more robust let-polymorphism support and basic dependent 
# types.
#
# Not on the critical path now, but an opportunity to explore a platonic language for
# data-parallel GPGPU programming.
#
# In the future, we will compile this to the same graph IR that is constructed 
# programmatically in Python, and then execute it on the same runtime.
#
# Key gaps between Python and this language:
# - How are records handled? Can we have an array of records? Is this dense?
# - Control-flow divergence, especially in the context of tail recursion?
#   Consider tail recursion for data-parallel execution, e.g. parallel factorial.
#   Compare with tail recursion for a training loop.

Linear =
  { w: [o][i]Fp32,
    b: [o]Fp32 }

linear model input =
    model.w @ input + model.b

relu x =
    max(0, x)

Mlp =
  { l1: Linear{o: h, i: i},
    l2: Linear{o: h, i: h},
    l3: Linear{o: o, i: h} }

mlp model input =
    h1 = relu (linear model.l1 input)
    h2 = relu (linear model.l2 h1)
    linear model.l3 h2

mlp_train_loss model input target =
    pred = mlp model input
    loss = cross_entropy pred target
    loss

mlp_train model inputs targets lr epochs =
    if epochs <= 0 then
        model
    else
        loss = mlp_train_loss model inputs targets
        grad = grad mlp_train_loss model inputs targets   # NOTE: (grad mlp_train_loss)
        model = model - lr * grad
        mlp_train model inputs targets lr (epochs - 1)
