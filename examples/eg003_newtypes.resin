export { main };

import { "$/string.resin", "$/stdio.resin" };

struct Meters {
	value: int,
}
type Distance = Meters;

fn to_meters(n: int) -> Meters {
	Meters { value = n }
}

fn to_distance(m: Meters) -> Distance {
	m
}

fn to_int(d: Distance) -> int {
	d.value
}

fn main() -> () {
	let mut distance = to_distance(to_meters(42));
	print(fmt("distance = {0}, as int = {1}\n", (distance.value, to_int(distance))));
}
