export {
	main,
};

import { "$/string.resin", "$/stdio.resin" };

struct FibonacciMismatch {
	index: u64,
	slow: u64,
	fast: u64,
}

fn fibonacci(n: u64) -> u64 {
	if (n <= u64(1)) {
		n
	} else {
		let mut f0 = fibonacci(n - 2);
		let mut f1 = fibonacci(n - 1);
		f0 + f1
	}
}

fn fast_fibonacci(n: u64) -> u64 {
	if (n <= u64(1)) {
		n
	} else {
		let mut f0: u64 = 0;
		let mut f1: u64 = 1;
		let mut i: u64 = 1;

		while (i < n) {
			// Compute new f0, f1:
			let mut new_f0 = f1;
			let mut new_f1 = f0 + f1;

			// Update:
			f0 = new_f0;
			f1 = new_f1;
			i = i + 1;
		};

		// Done:
		f1
	}
}

fn compare_fibonacci(index: u64, slow: u64, fast: u64) -> (() | Err<FibonacciMismatch>) {
	if (slow == fast) {
		(())
	} else {
		Err(FibonacciMismatch { index = index, slow = slow, fast = fast })
	}
}

fn test_fibonacci(n: u64) -> (() | Err<_>) {
	let mut i: u64 = 0;
	while (i < n) {
		let mut slow_f = fibonacci(i);
		let mut fast_f = fast_fibonacci(i);
		let text = fmt("slow_fibonacci({0}) = {1}, fast_fibonacci({1}) = {2}\n", (i, slow_f, fast_f));
		print(text);
		compare_fibonacci(i, slow_f, fast_f)?;
		i = i + 1;
	};
	(())
}

fn main() -> (() | Err<_>) {
	test_fibonacci(30)?;

	let mut n: u64 = 100;
	let text = fmt("fibonacci({0}) = {1}\n", (n, fast_fibonacci(n)));
	print(text);
	(())
}
