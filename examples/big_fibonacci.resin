export {
	main,
};

import { "$/string.resin" };

struct FibonacciMismatch {
	index: ulong,
	slow: ulong,
	fast: ulong,
}

fn fibonacci(n: ulong) -> ulong {
	if (n <= ulong(1)) {
		n
	} else {
		let mut f0 = fibonacci(n - 2);
		let mut f1 = fibonacci(n - 1);
		f0 + f1
	}
}

fn fast_fibonacci(n: ulong) -> ulong {
	if (n <= ulong(1)) {
		n
	} else {
		let mut f0 = ulong(0);
		let mut f1 = ulong(1);
		let mut i = ulong(1);

		while (i < n) {
			// Compute new f0, f1:
			let mut new_f0 = f1;
			let mut new_f1 = f0 + f1;

			// Update:
			f0 = new_f0;
			f1 = new_f1;
			i = i + 1;
		};

		// Done:
		f1
	}
}

fn compare_fibonacci(index: ulong, slow: ulong, fast: ulong) -> (() | Err<FibonacciMismatch>) {
	if (slow == fast) {
		(())
	} else {
		Err(FibonacciMismatch { index = index, slow = slow, fast = fast })
	}
}

fn test_fibonacci(n: ulong) -> (() | Err<_>) {
	let mut i = ulong(0);
	while (i < n) {
		let mut slow_f = fibonacci(i);
		let mut fast_f = fast_fibonacci(i);
		print(fmt("slow_fibonacci({0}) = {1}, fast_fibonacci({1}) = {2}\n", (i, slow_f, fast_f)));
		compare_fibonacci(i, slow_f, fast_f)?;
		i = i + 1;
	};
	(())
}

fn main() -> (() | Err<_>) {
	test_fibonacci(30)?;

	let mut n = ulong(100);
	print(fmt("fibonacci({0}) = {1}\n", (n, fast_fibonacci(n))));
	(())
}
