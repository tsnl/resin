export { main };

import { "$/shared.resin", "$/string.resin", "$/stdio.resin" };

struct Tracked {
	value: i32,
}
fn read(self: PtrMut<Tracked>) -> i32 {
	self.value
}

fn drop(self: RefMut<Tracked>) {
	if (self.value != i32(0)) {
		let text = fmt("released {0}\n", (self.value,));
		print(text);
	};
}

fn main() -> (() | Err<_>) {
	let mut weak = {
		// Allocate an inert payload, then initialize it through the borrowed pointer.
		let mut shared = arc_ptr_alloc::<Tracked>(Tracked { value = 0 })?;
		shared:get().value = 42;
		let mut alias = shared;
		let text = fmt("{0}\n", (alias:get():read(),));
		print(text);
		alias:downgrade()
	};
	match (weak:upgrade()) {
		ArcPtr<Tracked>(owner) => {
			let text = fmt("still alive: {0}\n", (owner:get():read(),));
			print(text);
		},
		None => {
			print("expired\n");
		},
	};
	(())
}
