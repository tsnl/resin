export { main };

struct Tracked {
	value: int,
	def read(self: Ptr<Tracked>) -> int = {
		self.value
	};
	def drop(self: Ptr<Tracked>) = {
		print(fmt("released {0}\n", (self.value,)));
	};
};

def main() = {
	var weak = {
		var shared = ArcPtr<Tracked> { value = 42 };
		var alias = shared;
		print(fmt("{0}\n", (alias.read(),)));
		alias.downgrade()
	};
	match (weak.upgrade()) {
		ArcPtr<Tracked>(owner) => {
			print(fmt("still alive: {0}\n", (owner.read(),)));
		},
		None => {
			print("expired\n");
		},
	};
};
