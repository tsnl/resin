export { main };

import { "$/shared.resin", "$/string.resin" };

struct Tracked {
	value: int,
}
fn read(self: Ptr<Tracked>) -> int {
	self.value
}

fn drop(self: Ref<Tracked>) {
	if (self.value != 0_i) {
		print(fmt("released {0}\n", (self.value,)));
	};
}

fn main() -> (() | Err<_>) {
	let mut weak = {
		// Allocate an inert payload, then initialize it through the borrowed pointer.
		let mut shared = arc_ptr_alloc::<Tracked>(Tracked { value = 0 })?;
		shared:get().value = 42;
		let mut alias = shared;
		print(fmt("{0}\n", (alias:get():read(),)));
		alias:downgrade()
	};
	match (weak:upgrade()) {
		ArcPtr<Tracked>(owner) => {
			print(fmt("still alive: {0}\n", (owner:get():read(),)));
		},
		None => {
			print("expired\n");
		},
	};
	(())
}
