export { main, failure };

import { "$/host.resin", "$/status.resin" };

struct Failed {};

struct Allocation {
	data: ArcSpan<int>,
	def drop(self: Ptr<Allocation>) = {
		// The owned elements are released automatically after this hook.
		print("releasing allocation\n");
	};
};

def allocate() -> Result<ArcPtr<Allocation>, OutOfMemory> = {
	var memory = Host.alloc(1, 0_i)?;
	ok(ArcPtr<Allocation> { data = memory })
};

def fail_if(fail: bool) -> Result<(), Failed> = {
	if (fail) {
		err(Failed {})
	} else {
		ok(())
	}
};

def work(fail: bool) -> Result<int, _> = {
	var value = allocate()?;
	value.data.get().at(0).* := 42;
	fail_if(fail)?;
	ok(value.data.get().at(0).*)
};

def main() -> Result<(), _> = {
	var answer = work(1 == 0)?;
	print(fmt("answer = {0}\n", (answer,)));
	ok(())
};

def failure() -> Result<(), _> = {
	work(1 == 1)?;
	ok(())
};
