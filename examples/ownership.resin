export { main, failure };

extern "stdlib.h" def malloc(bytes: ulong) -> Ptr<ubyte>;
extern "stdlib.h" def free(memory: Ptr<ubyte>);

struct OutOfMemory {};
struct Failed {};

struct Allocation { data: Ptr<int> };
impl Allocation {
	def drop(self: Ptr<Allocation>) = {
		free(Ptr<ubyte>(self.data));
		print("freed memory\n", ());
	};
}

def allocate() -> Result<Arc<Allocation>, OutOfMemory> = {
	var memory = malloc(ulong(4));
	if (ulong(memory) == ulong(0)) {
		err(OutOfMemory {})
	} else {
		ok(Arc<Allocation> { data = Ptr<int>(memory) })
	}
};

def fail_if(fail: bool) -> Result<(), Failed> = {
	if (fail) {
		err(Failed {})
	} else {
		ok(())
	}
};

def work(fail: bool) -> Result<int, _> = {
	var value = allocate()?;
	value.data.* := 42;
	fail_if(fail)?;
	ok(value.data.*)
};

def main() -> Result<(), _> = {
	var answer = work(1 == 0)?;
	print("answer = {0}\n", (answer,));
	ok(())
};

def failure() -> Result<(), _> = {
	work(1 == 1)?;
	ok(())
};
