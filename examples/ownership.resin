export { main, failure };

import { "$/span.resin", "$/string.resin", "$/shared.resin", "$/status.resin" };

struct Failed {};

struct Allocation {
	data: ArcSpan<int> | None,
	def get(self: Ptr<Allocation>) -> Span<int> = {
		self.data!.get()
	};
	def drop(self: Ptr<Allocation>) = {
		// The owned elements are released automatically after this hook.
		match (self.data) {
			ArcSpan<int>(data) => {
				print("releasing allocation\n");
			},
			None => {},
		};
	};
};

def allocate() -> Result<ArcPtr<Allocation>, OutOfMemory> = {
	var allocation = ArcPtr<Allocation>.alloc(Allocation { data = None })?;
	allocation.get().data := ArcSpan<int>.alloc(1, 0_i)?;
	ok(allocation)
};

def fail_if(fail: bool) -> Result<(), Failed> = {
	if (fail) {
		err(Failed {})
	} else {
		ok(())
	}
};

def work(fail: bool) -> Result<int, _> = {
	var value = allocate()?;
	value.get().get().at(0).* := 42;
	fail_if(fail)?;
	ok(value.get().get().at(0).*)
};

def main() -> Result<(), _> = {
	var answer = work(1 == 0)?;
	print(fmt("answer = {0}\n", (answer,)));
	ok(())
};

def failure() -> Result<(), _> = {
	work(1 == 1)?;
	ok(())
};
