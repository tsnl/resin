export { main, kernel, vertex, fragment };

import {
	"std/gpu.resin",
	"std/window.resin",
	"std/graphics.resin",
};

struct Particle { x: float32, y: float32, vx: float32, vy: float32, color: Color };
struct Params { count: uint, dt: float32, radius: float32, particles: Span<Particle> };

def advance(p: Ptr<Particle>, dt: float32) -> () = {
	p.x := p.x + p.vx * dt;
	p.y := p.y + p.vy * dt;
	if (p.x > 0.9f || p.x < -0.9f) {
		p.vx := -p.vx;
	};
	if (p.y > 0.9f || p.y < -0.9f) {
		p.vy := -p.vy;
	};
};

@compute_shader
def kernel(index: uint, root: Ptr<Params>) -> () = {
	if (index < root.count) {
		advance(root.particles(index), root.dt)
	}
};

@vertex_shader
def vertex(index: int, root: Ptr<Params>) -> Vertex = {
	var particle = 0;
	var corner = index;
	while (corner >= 3) {
		corner := corner - 3;
		particle := particle + 1;
	};
	var p = root.particles(particle);
	var dx = 0.0f;
	var dy = -root.radius;
	if (corner == 1) {
		dx := -root.radius;
		dy := root.radius;
	} else {
		if (corner == 2) {
			dx := root.radius;
			dy := root.radius;
		}
	};
	Vertex {
		position = Position { x = p.x + dx, y = p.y + dy, z = 0.0f, w = 1.0f },
		color = p.color,
	}
};

@fragment_shader
def fragment(color: Color) -> Color = {
	color
};

def initialize(particles: Span<Particle>) -> () = {
	var index = 0L;
	var row = 0;
	var x = -0.75f;
	var y = -0.75f;
	while (index < particles.length) {
		var vx = 0.35f;
		if ((index & 1L) == 0L) {
			vx := -vx;
		};
		particles(index).* := Particle {
			x = x,
			y = y,
			vx = vx,
			vy = 0.27f,
			color = Color {
				r = x + 0.85f,
				g = y + 0.85f,
				b = 0.8f,
				a = 1.0f,
			},
		};
		index := index + 1L;
		row := row + 1;
		x := x + 0.2f;
		if (row == 8) {
			row := 0;
			x := -0.75f;
			y := y + 0.2f;
		};
	};
};

def main() -> Result<(), _> = {
	var title = "Resin particles";
	var window = window_create(640, 480, Ptr<ubyte>(&title))?;
	defer window_destroy(window);
	var gpu = gpu_create_for_window(window)?;
	defer gpu_destroy(gpu);

	var compute = gpu_create_compute_pipeline(gpu, kernel.spirv)?;
	defer gpu_free_pipeline(gpu, compute);
	var graphics = gpu_create_graphics_pipeline(
		gpu,
		vertex.spirv,
		fragment.spirv,
	)?;
	defer gpu_free_pipeline(gpu, graphics);
	// Particle: 32 bytes, alignment 4. Params: 32 bytes, alignment 8.
	var particles = gpu_malloc(gpu, 64 * 32, 4, memory_default())?;
	defer gpu_free(gpu, particles);
	var root = gpu_malloc(gpu, 32, 8, memory_default())?;
	defer gpu_free(gpu, root);
	initialize(Span<Particle> { data = Ptr<Particle>(allocation_host_pointer(particles)), length = 64L });
	var params = Ptr<Params>(allocation_host_pointer(root));
	params.* := Params {
		count = 64I,
		dt = 0.016667f,
		radius = 0.018f,
		particles = Span<Particle> { data = Ptr<Particle>(allocation_device_pointer(particles)), length = 64L },
	};
	var address = allocation_device_pointer(root);
	var image = gpu_create_image(gpu, 640, 480)?;
	defer gpu_free_image(gpu, image);

	window_poll_events(window)?;
	while (!window_should_close(window) && !window_key_pressed(window, key_escape())) {
		var commands = gpu_start_command_recording(gpu)?;
		defer gpu_cancel_command_buffer(gpu, &commands);
		gpu_set_pipeline(commands, compute)?;
		gpu_dispatch(commands, address, 1, 1, 1)?;
		gpu_begin_rendering(commands, image, 0.0, 0.0, 0.0, 1.0)?;
		gpu_set_pipeline(commands, graphics)?;
		gpu_draw(commands, address, 192)?;
		gpu_end_rendering(commands)?;
		gpu_submit(gpu, &commands)?;
		gpu_present(gpu, image)?;
		window_poll_events(window)?;
	};
	print("particles demo complete\n", ());
	ok(())
};
