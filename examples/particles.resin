export { main, kernel, vertex, fragment };

import {
    "std/gpu.resin",
    "std/window.resin",
    "std/status.resin",
    "std/graphics.resin",
    "lib/particles.resin",
};

def initialize(particles: Ptr<Particle>) -> () = {
    var index = 0;
    var row = 0;
    var x = float32(-0.75);
    var y = float32(-0.75);
    while (index < 64) {
        var vx = float32(0.35);
        if ((index & 1) == 0) { vx := -vx; () } else { () };
        (particles + index).* := Particle {
            x = x, y = y, vx = vx, vy = float32(0.27),
            color = Color { r = x + float32(0.85), g = y + float32(0.85), b = float32(0.8), a = float32(1.0) }
        };
        index := index + 1;
        row := row + 1;
        x := x + float32(0.2);
        if (row == 8) { row := 0; x := float32(-0.75); y := y + float32(0.2); () } else { () };
    };
};

def main() -> () = {
    var title = "Resin particles";
    var window = Ptr<ResinWindow>(ulong(0));
    check(resin_window_create(640, 480, Ptr<ubyte>(&title), &window));
    var gpu = Ptr<ResinGpu>(ulong(0));
    check(resin_gpu_create_for_window(window, &gpu));

    var compute_code = shader(kernel, "compute");
    var compute = Ptr<ResinPipeline>(ulong(0));
    check(resin_gpu_create_compute_pipeline(gpu, compute_code.data, compute_code.length, &compute));
    var vertex_code = shader(vertex, "vertex");
    var fragment_code = shader(fragment, "fragment");
    var graphics = Ptr<ResinPipeline>(ulong(0));
    check(resin_gpu_create_graphics_pipeline(gpu, vertex_code.data, vertex_code.length, fragment_code.data, fragment_code.length, &graphics));

    var particles = Ptr<ResinAllocation>(ulong(0));
    var root = Ptr<ResinAllocation>(ulong(0));
    // Particle: 32 bytes, alignment 4. Params: 24 bytes, alignment 8.
    check(resin_gpu_malloc(gpu, 64 * 32, 4, resin_memory_default(), &particles));
    check(resin_gpu_malloc(gpu, 24, 8, resin_memory_default(), &root));
    initialize(Ptr<Particle>(resin_allocation_host_pointer(particles)));
    var params = Ptr<Params>(resin_allocation_host_pointer(root));
    params.* := Params {
        count = uint(64), dt = float32(0.016667), radius = float32(0.018),
        particles = Ptr<Particle>(resin_allocation_device_pointer(particles))
    };
    var address = resin_allocation_device_pointer(root);
    var image = Ptr<ResinImage>(ulong(0));
    check(resin_gpu_create_image(gpu, 640, 480, &image));

    check(resin_window_poll_events(window));
    while (resin_window_should_close(window) == 0 && resin_window_key_pressed(window, resin_key_escape()) == 0) {
        var commands = Ptr<ResinCommandBuffer>(ulong(0));
        check(resin_gpu_start_command_recording(gpu, &commands));
        check(resin_gpu_set_pipeline(commands, compute));
        check(resin_gpu_dispatch(commands, address, 1, 1, 1));
        check(resin_gpu_begin_rendering(commands, image, 0.0, 0.0, 0.0, 1.0));
        check(resin_gpu_set_pipeline(commands, graphics));
        check(resin_gpu_draw(commands, address, 192));
        check(resin_gpu_end_rendering(commands));
        check(resin_gpu_submit(gpu, commands));
        var status = resin_gpu_present(gpu, image);
        if (status != resin_status_incomplete()) { check(status) } else { () };
        check(resin_window_poll_events(window));
    };

    resin_gpu_free_image(gpu, image);
    resin_gpu_free(gpu, root);
    resin_gpu_free(gpu, particles);
    resin_gpu_free_pipeline(gpu, graphics);
    resin_gpu_free_pipeline(gpu, compute);
    resin_gpu_destroy(gpu);
    resin_window_destroy(window);
    print("particles demo complete\n", ());
};
