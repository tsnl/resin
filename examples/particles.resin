export { main, kernel, vertex, fragment };

import {
	"$/gpu.resin",
	"$/window.resin",
	"$/graphics.resin",
};

struct Particle {
	x: float32,
	y: float32,
	z: float32,
	vx: float32,
	vy: float32,
	vz: float32,
};

struct Params {
	dt: float32,
	yaw_cos: float32,
	yaw_sin: float32,
	pitch_cos: float32,
	pitch_sin: float32,
	zoom: float32,
	aspect: float32,
	radius: float32,
	particles: Span<Particle>,
};

// Relax the initial random velocities toward the Lorenz attractor's flow.
// Two small, fixed substeps keep the simulation stable, independently of camera motion.
def advance(p: Particle, dt: float32) -> Particle = {
	var vx = 0.15_f * p.vx + 0.85_f * (10.0_f * (p.y - p.x));
	var vy = 0.15_f * p.vy + 0.85_f * (p.x * (28.0_f - p.z) - p.y);
	var vz = 0.15_f * p.vz + 0.85_f * (p.x * p.y - 2.666667_f * p.z);
	Particle {
		x = p.x + vx * dt,
		y = p.y + vy * dt,
		z = p.z + vz * dt,
		vx = vx,
		vy = vy,
		vz = vz,
	}
};

@compute_shader
def kernel(index: ulong, root: Ptr<Params>) -> () = {
	if (index < root.particles.length) {
		var p = root.particles.at(index);
		p.* := advance(advance(p.*, root.dt), root.dt);
	}
};

// Float division is available in shaders. Correct rounding at the upper end of
// the 24-million-vertex draw, where adjacent integers no longer fit in float32.
def particle_index(index: int) -> int = {
	var particle = int(float32(index) / 24.0_f);
	if (particle * 24 > index) {
		particle := particle - 1;
	};
	particle
};

def positive(value: float32) -> float32 = {
	if (value > 0.0_f) {
		value
	} else {
		0.0_f
	}
};

// Approximate settled speed percentiles: 5/25/50/75/95% at 20/45/65/115/220
// units per simulation second. Fixed anchors keep colors stable across frames
// and reseeds. Interpolate squared speeds to avoid a square root per vertex.
def speed_heat(squared_speed: float32) -> float32 = {
	var heat = if (squared_speed < 2025.0_f) {
		0.25_f * (squared_speed - 400.0_f) / 1625.0_f
	} else if (squared_speed < 4225.0_f) {
		0.25_f + 0.25_f * (squared_speed - 2025.0_f) / 2200.0_f
	} else if (squared_speed < 13225.0_f) {
		0.5_f + 0.25_f * (squared_speed - 4225.0_f) / 9000.0_f
	} else {
		0.75_f + 0.25_f * (squared_speed - 13225.0_f) / 35175.0_f
	};
	if (heat < 0.0_f) {
		0.0_f
	} else if (heat > 1.0_f) {
		1.0_f
	} else {
		heat
	}
};

def heat_color(heat: float32) -> Color = {
	// Blue, cyan, warm yellow, orange, coral red. These are albedo colors;
	// the fragment shader applies lighting and distance fog afterwards.
	var colors = [
		Color { r = 0.16_f, g = 0.30_f, b = 0.90_f, a = 1.0_f },
		Color { r = 0.08_f, g = 0.75_f, b = 0.82_f, a = 1.0_f },
		Color { r = 0.95_f, g = 0.88_f, b = 0.38_f, a = 1.0_f },
		Color { r = 0.98_f, g = 0.46_f, b = 0.12_f, a = 1.0_f },
		Color { r = 0.88_f, g = 0.10_f, b = 0.16_f, a = 1.0_f },
	];
	var scaled = heat * 4.0_f;
	var segment = if (scaled < 3.0_f) {
		int(scaled)
	} else {
		3
	};
	var blend = scaled - float32(segment);
	var low = colors(segment).*;
	var high = colors(segment + 1).*;
	Color {
		r = low.r + (high.r - low.r) * blend,
		g = low.g + (high.g - low.g) * blend,
		b = low.b + (high.b - low.b) * blend,
		a = 1.0_f,
	}
};

@vertex_shader
def vertex(index: int, root: Ptr<Params>) -> Vertex = {
	var particle = particle_index(index);
	var local = index - particle * 24;
	var sector = int(float32(local) / 3.0_f);
	var corner = local - sector * 3;
	var p = root.particles.at(ulong(particle)).*;
	var horizontal_depth = -p.x * root.yaw_sin + p.y * root.yaw_cos;
	var height = (p.z - 25.0_f) * 0.9_f;
	var depth = horizontal_depth * root.pitch_cos - height * root.pitch_sin;
	var perspective = root.zoom / (1.0_f + depth * 0.012_f);
	var x = (p.x * root.yaw_cos + p.y * root.yaw_sin) * 0.036_f;
	var y = (height * root.pitch_cos + horizontal_depth * root.pitch_sin) * 0.036_f;

	// Eight triangles form a camera-facing octagon. Interpolated disk coordinates
	// let the fragment shader light a smooth hemisphere without a sphere mesh.
	var nx = 0.0_f;
	var ny = 0.0_f;
	if (corner != 0) {
		var rim = (sector + corner - 1) & 7;
		var xs = [1.0_f, 0.707107_f, 0.0_f, -0.707107_f, -1.0_f, -0.707107_f, 0.0_f, 0.707107_f];
		var ys = [0.0_f, 0.707107_f, 1.0_f, 0.707107_f, 0.0_f, -0.707107_f, -1.0_f, -0.707107_f];
		nx := xs(rim).*;
		ny := ys(rim).*;
	};
	var squared_speed = p.vx * p.vx + p.vy * p.vy + p.vz * p.vz;
	var heat = speed_heat(squared_speed);
	var distance = positive(1.0_f + depth * 0.025_f);
	var visibility = 1.0_f / (1.0_f + 0.4_f * distance * distance);
	Vertex {
		position = Position {
			x = (x + nx * root.radius) * perspective * root.aspect,
			y = -(y + ny * root.radius) * perspective,
			z = 0.0_f,
			w = 1.0_f,
		},
		// The fixed Color varying carries disk coordinates, speed, and fog to fragment.
		color = Color { r = nx, g = ny, b = heat, a = visibility },
	}
};

@fragment_shader
def fragment(color: Color) -> Color = {
	var nx = color.r;
	var ny = color.g;
	var squared_z = positive(1.0_f - nx * nx - ny * ny);
	// Five bounded Newton steps approximate sqrt on [0, 1], including the rim.
	var nz = 1.0_f;
	var step = 0_i;
	while (step < 5) {
		nz := 0.5_f * (nz + squared_z / nz);
		step := step + 1;
	};
	// Camera-space light from the upper left; a tight, pale specular highlight.
	var diffuse = positive(-0.4_f * nx + 0.55_f * ny + 0.733_f * nz);
	var specular = positive(-0.215_f * nx + 0.295_f * ny + 0.931_f * nz);
	specular := specular * specular;
	specular := specular * specular;
	specular := specular * specular;
	specular := specular * specular;
	specular := specular * specular;
	var light = 0.16_f + 0.64_f * diffuse;
	var shine = 0.2_f * specular;
	var albedo = heat_color(color.b);
	var fog = color.a;
	Color {
		r = 0.004_f * (1.0_f - fog) + (albedo.r * light + shine) * fog,
		g = 0.008_f * (1.0_f - fog) + (albedo.g * light + shine) * fog,
		b = 0.02_f * (1.0_f - fog) + (albedo.b * light + shine) * fog,
		a = 1.0_f,
	}
};

// Host-only xorshift32: reproducible random positions and independent velocities.
def random(state: Ptr<uint>) -> float32 = {
	var x = state.*;
	x := x ^ (x << 13_ui);
	x := x ^ (x >> 17_ui);
	x := x ^ (x << 5_ui);
	state.* := x;
	float32(x & 0xffffff_ui) / 16777216.0_f
};

def initialize(particles: Span<Particle>, seed: uint) -> () = {
	var state = seed | 1_ui;
	var index = 0_ul;
	while (index < particles.length) {
		particles(index).* := Particle {
			x = random(&state) * 48.0_f - 24.0_f,
			y = random(&state) * 60.0_f - 30.0_f,
			z = random(&state) * 50.0_f,
			vx = random(&state) * 12.0_f - 6.0_f,
			vy = random(&state) * 12.0_f - 6.0_f,
			vz = random(&state) * 12.0_f - 6.0_f,
		};
		index := index + 1_ul;
	};
};

// Camera math runs on the host; shaders receive only the resulting basis and zoom.
extern "math.h" def sinf(angle: float32) -> float32;
extern "math.h" def cosf(angle: float32) -> float32;
extern "math.h" def expf(value: float32) -> float32;

struct Camera { yaw: float32, pitch: float32, zoom: float32 };
struct MousePosition { x: float64, y: float64 };
def mouse_position(x: float64, y: float64) -> MousePosition = {
	MousePosition { x = x, y = y }
};
def default_camera() -> Camera = {
	Camera { yaw = 0.0_f, pitch = 0.24_f, zoom = 1.0_f }
};

def clamp(value: float32, low: float32, high: float32) -> float32 = {
	if (value < low) {
		low
	} else if (value > high) {
		high
	} else {
		value
	}
};

def move_camera(camera: Ptr<Camera>, dx: float64, dy: float64, scroll: float64) = {
	camera.yaw := camera.yaw + float32(dx) * 0.006_f;
	// Stop short of the poles so dragging never flips the view upside down.
	camera.pitch := clamp(camera.pitch + float32(dy) * 0.006_f, -1.4_f, 1.4_f);
	camera.zoom := clamp(camera.zoom * expf(clamp(float32(scroll), -20.0_f, 20.0_f) * 0.12_f), 0.35_f, 3.0_f);
};

def apply_camera(camera: Camera, params: Ptr<Params>) = {
	params.yaw_cos := cosf(camera.yaw);
	params.yaw_sin := sinf(camera.yaw);
	params.pitch_cos := cosf(camera.pitch);
	params.pitch_sin := sinf(camera.pitch);
	params.zoom := camera.zoom;
};

def main() -> Result<(), _> = {
	var count = 1000000_ui;
	var title = "Resin | 1,000,000 particles | Drag: orbit | Scroll: zoom | Home: reset view | Space: pause | R: reseed | Esc: quit";
	var window = Window.new(1280, 800, String.from_str(title))?;

	var gpu = Gpu.new_for_window(window)?;

	var compute = gpu.create_compute_pipeline(kernel.spirv)?;

	var graphics = gpu.create_graphics_pipeline(vertex.spirv, fragment.spirv)?;

	// One shared 24 MB buffer: initialization writes host memory; compute and graphics use its device address.
	var particles = gpu.malloc(ulong(count) * size_of(Particle), align_of(Particle), Memory.default())?;

	var root = gpu.malloc(size_of(Params), align_of(Params), Memory.default())?;

	var host_particles = Span<Particle> { data = Ptr<Particle>(particles.host_pointer()), length = ulong(count) };
	var seed = 0x9e3779b9_ui;
	initialize(host_particles, seed);
	var params = Ptr<Params>(root.host_pointer());
	params.* := Params {
		dt = 0.005_f,
		yaw_cos = 1.0_f,
		yaw_sin = 0.0_f,
		pitch_cos = 1.0_f,
		pitch_sin = 0.0_f,
		zoom = 1.0_f,
		aspect = 0.625_f,
		radius = 0.004_f,
		particles = Span<Particle> { data = Ptr<Particle>(particles.device_pointer()), length = ulong(count) },
	};
	var image = gpu.create_image(1280, 800)?;

	var paused = 1 == 0;
	var camera = default_camera();
	var automatic = 1 == 1;
	var was_dragging = 1 == 0;
	var previous_cursor = mouse_position(window.cursor_position()?);

	window.poll_events()?;
	while (!window.should_close() && !window.key_pressed(Window.key_escape())) {
		var space = window.key_state(Window.keys().space);
		var reset = window.key_state(Window.keys().r);
		if (space.pressed) {
			paused := !paused;
		};
		if (reset.pressed) {
			seed := seed * 1664525_ui + 1013904223_ui;
			initialize(host_particles, seed);
		};
		var cursor = mouse_position(window.cursor_position()?);
		var left = window.mouse_button_state(Window.mouse_buttons().left);
		var dragging = window.focused() && left.down;
		var scroll = mouse_position(window.scroll_delta()?);
		if (automatic && !paused) {
			camera.yaw := camera.yaw + 0.0015_f;
		};
		if (window.focused()) {
			if (dragging || scroll.y != 0.0_d) {
				automatic := 1 == 0;
			};
			// A fresh press/focus starts a drag without jumping from the old cursor position.
			if (dragging && was_dragging && !left.pressed) {
				move_camera(&camera, cursor.x - previous_cursor.x, cursor.y - previous_cursor.y, 0.0_d);
			};
			move_camera(&camera, 0.0_d, 0.0_d, scroll.y);
			if (window.key_state(Window.keys().home).pressed) {
				camera := default_camera();
				automatic := 1 == 1;
			};
		};
		previous_cursor := cursor;
		was_dragging := dragging;
		apply_camera(camera, params);
		var commands = gpu.start_command_recording()?;

		if (!paused) {
			commands.set_pipeline(compute)?;
			commands.dispatch(root, (count + 63_ui) / 64_ui, 1, 1)?;
		};
		commands.begin_rendering(image, 0.004_f, 0.008_f, 0.02_f, 1.0_f)?;
		commands.set_pipeline(graphics)?;
		commands.draw(root, count * 24_ui)?;
		commands.end_rendering()?;
		commands.submit()?;
		gpu.present(image)?;
		window.poll_events()?;
	};
	print("particles demo complete\n");
	ok(())
};
