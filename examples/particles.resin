export { main, kernel, vertex, fragment };

extern {
	"math.h": {
		fn sinf(angle: float32) -> float32;
		fn cosf(angle: float32) -> float32;
		fn expf(value: float32) -> float32;
	},
};

import {
	"$/shared.resin",
	"$/span.resin",
	"$/string.resin",
	"$/stdio.resin",
	"$/gpu.resin",
	"$/window.resin",
	"$/graphics.resin",
};

struct Particle {
	x: float32,
	y: float32,
	z: float32,
	vx: float32,
	vy: float32,
	vz: float32,
}

struct Params {
	dt: float32,
	yaw_cos: float32,
	yaw_sin: float32,
	pitch_cos: float32,
	pitch_sin: float32,
	zoom: float32,
	aspect: float32,
	radius: float32,
	particles: Span<Particle>,
}

struct HostParams {
	dt: float32,
	yaw_cos: float32,
	yaw_sin: float32,
	pitch_cos: float32,
	pitch_sin: float32,
	zoom: float32,
	aspect: float32,
	radius: float32,
	particles: GpuSpan<Particle>,
}

// Relax the initial random velocities toward the Lorenz attractor's flow.
// Two small, fixed substeps keep the simulation stable, independently of camera motion.
fn advance(p: Particle, dt: float32) -> Particle {
	let mut vx = 0.15_f * p.vx + 0.85_f * (10.0_f * (p.y - p.x));
	let mut vy = 0.15_f * p.vy + 0.85_f * (p.x * (28.0_f - p.z) - p.y);
	let mut vz = 0.15_f * p.vz + 0.85_f * (p.x * p.y - 2.666667_f * p.z);
	Particle {
		x = p.x + vx * dt,
		y = p.y + vy * dt,
		z = p.z + vz * dt,
		vx = vx,
		vy = vy,
		vz = vz,
	}
}

@compute_shader
fn kernel(index: ulong, root: Ptr<Params>) -> () {
	if (index < root.particles.length) {
		let mut p: Ref<Particle> = root.particles:at(index);
		p = advance(advance(p:clone(), root.dt), root.dt);
	}
}

fn clone(p: Ref<Particle>) -> Particle {
	Particle { x = p.x, y = p.y, z = p.z, vx = p.vx, vy = p.vy, vz = p.vz }
}

fn clone(color: Ref<Color>) -> Color {
	Color { r = color.r, g = color.g, b = color.b, a = color.a }
}

fn clone(params: Ref<HostParams>) -> HostParams {
	HostParams {
		dt = params.dt,
		yaw_cos = params.yaw_cos,
		yaw_sin = params.yaw_sin,
		pitch_cos = params.pitch_cos,
		pitch_sin = params.pitch_sin,
		zoom = params.zoom,
		aspect = params.aspect,
		radius = params.radius,
		particles = params.particles:clone(),
	}
}

// Float division is available in shaders. Correct rounding at the upper end of
// the 24-million-vertex draw, where adjacent integers no longer fit in float32.
fn particle_index(index: int) -> int {
	let mut particle = int(float32(index) / 24.0_f);
	if (particle * 24 > index) {
		particle = particle - 1;
	};
	particle
}

fn positive(value: float32) -> float32 {
	if (value > 0.0_f) {
		value
	} else {
		0.0_f
	}
}

// Approximate settled speed percentiles: 5/25/50/75/95% at 20/45/65/115/220
// units per simulation second. Fixed anchors keep colors stable across frames
// and reseeds. Interpolate squared speeds to avoid a square root per vertex.
fn speed_heat(squared_speed: float32) -> float32 {
	let mut heat = if (squared_speed < 2025.0_f) {
		0.25_f * (squared_speed - 400.0_f) / 1625.0_f
	} else if (squared_speed < 4225.0_f) {
		0.25_f + 0.25_f * (squared_speed - 2025.0_f) / 2200.0_f
	} else if (squared_speed < 13225.0_f) {
		0.5_f + 0.25_f * (squared_speed - 4225.0_f) / 9000.0_f
	} else {
		0.75_f + 0.25_f * (squared_speed - 13225.0_f) / 35175.0_f
	};
	if (heat < 0.0_f) {
		0.0_f
	} else if (heat > 1.0_f) {
		1.0_f
	} else {
		heat
	}
}

fn heat_color(heat: float32) -> Color {
	// Blue, cyan, warm yellow, orange, coral red. These are albedo colors;
	// the fragment shader applies lighting and distance fog afterwards.
	let mut colors = [
		(0.16_f, 0.30_f, 0.90_f),
		(0.08_f, 0.75_f, 0.82_f),
		(0.95_f, 0.88_f, 0.38_f),
		(0.98_f, 0.46_f, 0.12_f),
		(0.88_f, 0.10_f, 0.16_f),
	];
	let mut scaled = heat * 4.0_f;
	let mut segment = if (scaled < 3.0_f) {
		int(scaled)
	} else {
		3
	};
	let mut blend = scaled - float32(segment);
	let mut low = colors(segment);
	let mut high = colors(segment + 1);
	Color {
		r = low.0 + (high.0 - low.0) * blend,
		g = low.1 + (high.1 - low.1) * blend,
		b = low.2 + (high.2 - low.2) * blend,
		a = 1.0_f,
	}
}

@vertex_shader
fn vertex(index: int, root: Ptr<Params>) -> Vertex {
	let mut particle = particle_index(index);
	let mut local = index - particle * 24;
	let mut sector = int(float32(local) / 3.0_f);
	let mut corner = local - sector * 3;
	let p: Ref<Particle> = root.particles:at(ulong(particle));
	let mut horizontal_depth = -p.x * root.yaw_sin + p.y * root.yaw_cos;
	let mut height = (p.z - 25.0_f) * 0.9_f;
	let mut depth = horizontal_depth * root.pitch_cos - height * root.pitch_sin;
	let mut perspective = root.zoom / (1.0_f + depth * 0.012_f);
	let mut x = (p.x * root.yaw_cos + p.y * root.yaw_sin) * 0.036_f;
	let mut y = (height * root.pitch_cos + horizontal_depth * root.pitch_sin) * 0.036_f;

	// Eight triangles form a camera-facing octagon. Interpolated disk coordinates
	// let the fragment shader light a smooth hemisphere without a sphere mesh.
	let mut nx = 0.0_f;
	let mut ny = 0.0_f;
	if (corner != 0) {
		let mut rim = (sector + corner - 1) & 7;
		let mut xs = [1.0_f, 0.707107_f, 0.0_f, -0.707107_f, -1.0_f, -0.707107_f, 0.0_f, 0.707107_f];
		let mut ys = [0.0_f, 0.707107_f, 1.0_f, 0.707107_f, 0.0_f, -0.707107_f, -1.0_f, -0.707107_f];
		nx = xs(rim);
		ny = ys(rim);
	};
	let mut squared_speed = p.vx * p.vx + p.vy * p.vy + p.vz * p.vz;
	let mut heat = speed_heat(squared_speed);
	let mut distance = positive(1.0_f + depth * 0.025_f);
	let mut visibility = 1.0_f / (1.0_f + 0.4_f * distance * distance);
	Vertex {
		position = Position {
			x = (x + nx * root.radius) * perspective * root.aspect,
			y = -(y + ny * root.radius) * perspective,
			z = 0.0_f,
			w = 1.0_f,
		},
		// The fixed Color varying carries disk coordinates, speed, and fog to fragment.
		color = Color { r = nx, g = ny, b = heat, a = visibility },
	}
}

@fragment_shader
fn fragment(color: Color) -> Color {
	let mut nx = color.r;
	let mut ny = color.g;
	let mut squared_z = positive(1.0_f - nx * nx - ny * ny);
	// Five bounded Newton steps approximate sqrt on [0, 1], including the rim.
	let mut nz = 1.0_f;
	let mut step = 0_i;
	while (step < 5) {
		nz = 0.5_f * (nz + squared_z / nz);
		step = step + 1;
	};
	// Camera-space light from the upper left; a tight, pale specular highlight.
	let mut diffuse = positive(-0.4_f * nx + 0.55_f * ny + 0.733_f * nz);
	let mut specular = positive(-0.215_f * nx + 0.295_f * ny + 0.931_f * nz);
	specular = specular * specular;
	specular = specular * specular;
	specular = specular * specular;
	specular = specular * specular;
	specular = specular * specular;
	let mut light = 0.16_f + 0.64_f * diffuse;
	let mut shine = 0.2_f * specular;
	let mut albedo = heat_color(color.b);
	let mut fog = color.a;
	Color {
		r = 0.004_f * (1.0_f - fog) + (albedo.r * light + shine) * fog,
		g = 0.008_f * (1.0_f - fog) + (albedo.g * light + shine) * fog,
		b = 0.02_f * (1.0_f - fog) + (albedo.b * light + shine) * fog,
		a = 1.0_f,
	}
}

// Host-only xorshift32: reproducible random positions and independent velocities.
fn random(state: Ref<uint>) -> float32 {
	let mut x = state;
	x = x ^ (x << 13_ui);
	x = x ^ (x >> 17_ui);
	x = x ^ (x << 5_ui);
	state = x;
	float32(x & 0xffffff_ui) / 16777216.0_f
}

fn random_particle(state: Ref<uint>) -> Particle {
	Particle {
		x = random(state) * 48.0_f - 24.0_f,
		y = random(state) * 60.0_f - 30.0_f,
		z = random(state) * 50.0_f,
		vx = random(state) * 12.0_f - 6.0_f,
		vy = random(state) * 12.0_f - 6.0_f,
		vz = random(state) * 12.0_f - 6.0_f,
	}
}

fn initialize(particles: Ref<GpuSpan<Particle>>, seed: uint) {
	let mut state = seed | 1_ui;
	let mut index = 0_ul;
	while (index < particles.length) {
		particles:at(index):store(random_particle(state));
		index = index + 1_ul;
	};
}

// Camera math runs on the host; shaders receive only the resulting basis and zoom.

struct Camera {
	yaw: float32,
	pitch: float32,
	zoom: float32,
}
struct MousePosition {
	x: float64,
	y: float64,
}
fn mouse_position(position: (float64, float64)) -> MousePosition {
	MousePosition { x = position.0, y = position.1 }
}
fn default_camera() -> Camera {
	Camera { yaw = 0.0_f, pitch = 0.24_f, zoom = 1.0_f }
}

fn clamp(value: float32, low: float32, high: float32) -> float32 {
	if (value < low) {
		low
	} else if (value > high) {
		high
	} else {
		value
	}
}

fn move_camera(camera: Ref<Camera>, dx: float64, dy: float64, scroll: float64) {
	camera.yaw = camera.yaw + float32(dx) * 0.006_f;
	// Stop short of the poles so dragging never flips the view upside down.
	camera.pitch = clamp(camera.pitch + float32(dy) * 0.006_f, -1.4_f, 1.4_f);
	camera.zoom = clamp(camera.zoom * expf(clamp(float32(scroll), -20.0_f, 20.0_f) * 0.12_f), 0.35_f, 3.0_f);
}

fn apply_camera<P>(camera: Ref<Camera>, params: Ref<P>) {
	params.yaw_cos = cosf(camera.yaw);
	params.yaw_sin = sinf(camera.yaw);
	params.pitch_cos = cosf(camera.pitch);
	params.pitch_sin = sinf(camera.pitch);
	params.zoom = camera.zoom;
}

fn main() -> (() | Err<_>) {
	let mut count = 1000000_ui;
	let mut title = "Resin | 1,000,000 particles | Drag: orbit | Scroll: zoom | Home: reset view | Space: pause | R: reseed | Esc: quit";
	let mut window = window_new(1280, 800, string_from_str(title))?;

	let mut gpu = gpu_new_for_window(window)?;
	let mut workgroup_size = gpu:compute_workgroup_size();
	let mut groups = uint((ulong(count) + workgroup_size - 1_ul) / workgroup_size);

	let mut compute = gpu:create_compute_pipeline(kernel)?;

	let mut graphics = gpu:create_graphics_pipeline(vertex, fragment)?;

	// Initialization and shader projection share one owned particle allocation.
	let mut particles = gpu:alloc::<Particle>(ulong(count))?;

	let mut seed = 0x9e3779b9_ui;
	initialize(particles, seed);
	let mut params = HostParams {
		dt = 0.005_f,
		yaw_cos = 1.0_f,
		yaw_sin = 0.0_f,
		pitch_cos = 1.0_f,
		pitch_sin = 0.0_f,
		zoom = 1.0_f,
		aspect = 0.625_f,
		radius = 0.004_f,
		particles = particles:clone(),
	};
	let mut image = gpu:create_image(1280, 800)?;

	let mut paused = 1 == 0;
	let mut camera = default_camera();
	let mut automatic = 1 == 1;
	let mut was_dragging = 1 == 0;
	let mut previous_cursor = mouse_position(window:cursor_position()?);

	window:poll_events()?;
	while (!window:should_close() && !window:key_pressed(key_escape)) {
		let mut space = window:key_state(key_space);
		let mut reset = window:key_state(key_r);
		if (space.pressed) {
			paused = !paused;
		};
		if (reset.pressed) {
			seed = seed * 1664525_ui + 1013904223_ui;
			initialize(particles, seed);
		};
		let mut cursor = mouse_position(window:cursor_position()?);
		let mut left = window:mouse_button_state(mouse_button_left);
		let mut dragging = window:focused() && left.down;
		let mut scroll = mouse_position(window:scroll_delta()?);
		if (automatic && !paused) {
			camera.yaw = camera.yaw + 0.0015_f;
		};
		if (window:focused()) {
			if (dragging || scroll.y != 0.0_d) {
				automatic = 1 == 0;
			};
			// A fresh press/focus starts a drag without jumping from the old cursor position.
			if (dragging && was_dragging && !left.pressed) {
				move_camera(camera, cursor.x - previous_cursor.x, cursor.y - previous_cursor.y, 0.0_d);
			};
			move_camera(camera, 0.0_d, 0.0_d, scroll.y);
			if (window:key_state(key_home).pressed) {
				camera = default_camera();
				automatic = 1 == 1;
			};
		};
		previous_cursor = cursor;
		was_dragging = dragging;
		apply_camera(camera, params);
		let mut root = HostParams {
			dt = params.dt,
			yaw_cos = params.yaw_cos,
			yaw_sin = params.yaw_sin,
			pitch_cos = params.pitch_cos,
			pitch_sin = params.pitch_sin,
			zoom = params.zoom,
			aspect = params.aspect,
			radius = params.radius,
			particles = params.particles:clone(),
		};
		let mut commands = gpu:start_command_recording()?;

		if (!paused) {
			commands:dispatch(compute, root:clone(), groups, 1, 1)?;
		};
		commands:begin_rendering(image, 0.004_f, 0.008_f, 0.02_f, 1.0_f)?;
		commands:draw(graphics, root, count * 24_ui)?;
		commands:end_rendering()?;
		commands:submit()?;
		gpu:present(image)?;
		window:poll_events()?;
	};
	print("particles demo complete\n");
	(())
}
