export { main, independent };

import { "$/string.resin", "$/stdio.resin", "lib/counter.resin" };

fn main() -> () {
	let mut counter = Counter { value = 0 };
	let text = fmt("counter: {0}, {1}\n", (next(counter), next(counter)));
	print(text);
}

fn independent() -> () {
	let mut first = Counter { value = 0 };
	let mut second = Counter { value = 100 };
	let text = fmt("independent counters: {0}, {1}, {2}\n", (next(first), next(second), next(first)));
	print(text);
}
