export { main };

import {
	"std/gpu.resin",
	"std/graphics.resin",
	"std/window.resin",
};

@vertex_shader
def vertex(index: int) -> Vertex = {
	if (index == 0) {
		Vertex {
			position = Position {
				x = 0.0f,
				y = -0.75f,
				z = 0.0f,
				w = 1.0f,
			},
			color = Color {
				r = 1.0f,
				g = 0.0f,
				b = 0.0f,
				a = 1.0f,
			},
		}
	} else if (index == 1) {
		Vertex {
			position = Position {
				x = -0.7f,
				y = 0.6f,
				z = 0.0f,
				w = 1.0f,
			},
			color = Color {
				r = 0.0f,
				g = 1.0f,
				b = 0.0f,
				a = 1.0f,
			},
		}
	} else {
		Vertex {
			position = Position {
				x = 0.7f,
				y = 0.6f,
				z = 0.0f,
				w = 1.0f,
			},
			color = Color {
				r = 0.0f,
				g = 0.0f,
				b = 1.0f,
				a = 1.0f,
			},
		}
	}
};

@fragment_shader
def fragment(color: Color) -> Color = {
	color
};

def main() -> Result<(), _> = {
	var title = "Resin triangle";
	var window = Window.new(640, 480, title.data)?;

	var gpu = Gpu.new_for_window(window)?;

	var pipeline = gpu.create_graphics_pipeline(vertex.spirv, fragment.spirv)?;

	var image = gpu.create_image(640, 480)?;

	window.poll_events()?;
	while (!window.should_close() && !window.key_pressed(Window.key_escape())) {
		var commands = gpu.start_command_recording()?;

		commands.begin_rendering(image, 0.0, 0.0, 0.0, 1.0)?;
		commands.set_pipeline(pipeline)?;
		commands.draw(0, 3)?;
		commands.end_rendering()?;
		commands.submit()?;
		gpu.present(image)?;
		window.poll_events()?;
	};
	print("window demo complete\n");
	ok(())
};
