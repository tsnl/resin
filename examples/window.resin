export { main };

import {
	"$/string.resin",
	"$/gpu.resin",
	"$/graphics.resin",
	"$/window.resin",
};

@vertex_shader
fn vertex(index: int) -> Vertex  {
	if (index == 0) {
		Vertex {
			position = Position {
				x = 0.0_f,
				y = -0.75_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 1.0_f,
				g = 0.0_f,
				b = 0.0_f,
				a = 1.0_f,
			},
		}
	} else if (index == 1) {
		Vertex {
			position = Position {
				x = -0.7_f,
				y = 0.6_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 0.0_f,
				g = 1.0_f,
				b = 0.0_f,
				a = 1.0_f,
			},
		}
	} else {
		Vertex {
			position = Position {
				x = 0.7_f,
				y = 0.6_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 0.0_f,
				g = 0.0_f,
				b = 1.0_f,
				a = 1.0_f,
			},
		}
	}
}

@fragment_shader
fn fragment(color: Color) -> Color  {
	color
}

fn main() -> (() | Err<_>)  {
	let mut title = "Resin triangle";
	let mut window = window_new(640, 480, string_from_str(title))?;

	let mut gpu = gpu_new_for_window(window)?;

	let mut pipeline = gpu:create_graphics_pipeline(vertex, fragment)?;

	let mut image = gpu:create_image(640, 480)?;

	window:poll_events()?;
	while (!window:should_close() && !window:key_pressed(key_escape)) {
		let mut commands = gpu:start_command_recording()?;

		commands:begin_rendering(image, 0.0, 0.0, 0.0, 1.0)?;
		commands:draw(pipeline, None, 3)?;
		commands:end_rendering()?;
		commands:submit()?;
		gpu:present(image)?;
		window:poll_events()?;
	};
	print("window demo complete\n");
	(())
}
