export { main };

import {
	"$/string.resin",
	"$/stdio.resin",
	"$/gpu.resin",
	"$/graphics.resin",
	"$/window.resin",
};

@vertex_shader
fn vertex(index: i32) -> Vertex {
	if (index == 0) {
		Vertex {
			position = Position {
				x = f32(0.0),
				y = f32(-0.75),
				z = f32(0.0),
				w = f32(1.0),
			},
			color = Color {
				r = f32(1.0),
				g = f32(0.0),
				b = f32(0.0),
				a = f32(1.0),
			},
		}
	} else if (index == 1) {
		Vertex {
			position = Position {
				x = f32(-0.7),
				y = f32(0.6),
				z = f32(0.0),
				w = f32(1.0),
			},
			color = Color {
				r = f32(0.0),
				g = f32(1.0),
				b = f32(0.0),
				a = f32(1.0),
			},
		}
	} else {
		Vertex {
			position = Position {
				x = f32(0.7),
				y = f32(0.6),
				z = f32(0.0),
				w = f32(1.0),
			},
			color = Color {
				r = f32(0.0),
				g = f32(0.0),
				b = f32(1.0),
				a = f32(1.0),
			},
		}
	}
}

@fragment_shader
fn fragment(color: Color) -> Color {
	color
}

fn main() -> (() | Err<_>) {
	let mut title = "Resin triangle";
	let caption = string_from_str(title);
	let mut window = window_new(640, 480, caption)?;

	let mut gpu = gpu_new_for_window(window)?;

	let mut pipeline = gpu:create_graphics_pipeline(vertex, fragment)?;

	let mut image = gpu:create_image(640, 480)?;

	window:poll_events()?;
	while (!window:should_close() && !window:key_pressed(key_escape)) {
		let mut commands = gpu:start_command_recording()?;

		commands:begin_rendering(image, 0.0, 0.0, 0.0, 1.0)?;
		commands:draw(pipeline, None, 3)?;
		commands:end_rendering()?;
		commands:submit()?;
		gpu:present(image)?;
		window:poll_events()?;
	};
	print("window demo complete\n");
	(())
}
