export { main };

import {
	"std/gpu.resin",
	"std/graphics.resin",
	"std/window.resin",
};

@vertex_shader
def vertex(index: int) -> Vertex = {
	if (index == 0) {
		Vertex {
			position = Position {
				x = float32(0.0),
				y = float32(-0.75),
				z = float32(0.0),
				w = float32(1.0),
			},
			color = Color {
				r = float32(1.0),
				g = float32(0.0),
				b = float32(0.0),
				a = float32(1.0),
			},
		}
	} else {
		if (index == 1) {
			Vertex {
				position = Position {
					x = float32(-0.7),
					y = float32(0.6),
					z = float32(0.0),
					w = float32(1.0),
				},
				color = Color {
					r = float32(0.0),
					g = float32(1.0),
					b = float32(0.0),
					a = float32(1.0),
				},
			}
		} else {
			Vertex {
				position = Position {
					x = float32(0.7),
					y = float32(0.6),
					z = float32(0.0),
					w = float32(1.0),
				},
				color = Color {
					r = float32(0.0),
					g = float32(0.0),
					b = float32(1.0),
					a = float32(1.0),
				},
			}
		}
	}
};

@fragment_shader
def fragment(color: Color) -> Color = {
	color
};

def main() -> Result<(), _> = {
	var title = "Resin triangle";
	var window = window_create(640, 480, Ptr<ubyte>(&title))?;
	defer window_destroy(window);
	var gpu = gpu_create_for_window(window)?;
	defer gpu_destroy(gpu);

	var pipeline = gpu_create_graphics_pipeline(
		gpu,
		vertex.spirv,
		fragment.spirv,
	)?;
	defer gpu_free_pipeline(gpu, pipeline);
	var image = gpu_create_image(gpu, 640, 480)?;
	defer gpu_free_image(gpu, image);

	window_poll_events(window)?;
	while (!window_should_close(window) && !window_key_pressed(window, key_escape())) {
		var commands = gpu_start_command_recording(gpu)?;
		defer gpu_cancel_command_buffer(gpu, &commands);
		gpu_begin_rendering(commands, image, 0.0, 0.0, 0.0, 1.0)?;
		gpu_set_pipeline(commands, pipeline)?;
		gpu_draw(commands, 0, 3)?;
		gpu_end_rendering(commands)?;
		gpu_submit(gpu, &commands)?;
		gpu_present(gpu, image)?;
		window_poll_events(window)?;
	};
	print("window demo complete\n", ());
	ok(())
};
