export { main };

import { "$/string.resin", "$/stdio.resin" };

fn even(n: i32) -> i32 {
	if (n == 0) {
		1
	} else {
		odd(n - 1)
	}
}

fn odd(n: i32) -> i32 {
	if (n == 0) {
		0
	} else {
		even(n - 1)
	}
}

fn main() -> () {
	let text = fmt("even(10) = {0}, odd(9) = {1}\n", (even(10), odd(9)));
	print(text);
}
