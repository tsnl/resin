// Mutual recursion via a forward declaration.
odd: (int) -> int;
even = (n: int) => int {
    if (n == 0) {
        1
    } else {
        odd(n - 1)
    }
};
odd := (n: int) => int {
    if (n == 0) {
        0
    } else {
        even(n - 1)
    }
};
print("even(10) = {0}, odd(9) = {1}\n", (even(10), odd(9)));
