export { main, failure };

import { "$/string.resin", "$/stdio.resin", "$/status.resin" };

struct DivideByZero {}
struct NegativeInput {
	value: i32,
}
type Number = i32;

fn divide(n: Number, d: Number) -> (Number | Err<DivideByZero>) {
	if (d == 0) {
		Err(DivideByZero {})
	} else {
		(n / d)
	}
}

fn calculate(n: i32) -> (i32 | Err<_>) {
	if (n < 0) {
		Err(NegativeInput { value = n })
	} else {
		(divide(n, 2)?)
	}
}

fn main() -> (() | Err<_>) {
	runtime_status_from_code(0)?;
	let mut answer = calculate(84)?;
	let text = fmt("answer = {0}\n", (answer,));
	print(text);
	match (calculate(-1)) {
		i32(value) => {
			let text = fmt("unexpected success: {0}\n", (value,));
			print(text)
		},
		Err(error) => {
			match (error) {
				DivideByZero(zero) => {
					print("division by zero\n")
				},
				NegativeInput(negative) => {
					let text = fmt("negative input: {0}\n", (negative.value,));
					print(text)
				},
			}
		},
	};
	(())
}

fn failure() -> (() | Err<_>) {
	divide(1, 0)?;
	(())
}
