export { main, failure };

import { "$/string.resin", "$/status.resin" };

struct DivideByZero {}
struct NegativeInput {
	value: int,
}
type Number = int;

fn divide(n: Number, d: Number) -> (Number | Err<DivideByZero>) {
	if (d == 0) {
		Err(DivideByZero {})
	} else {
		(n / d)
	}
}

fn calculate(n: int) -> (int | Err<_>) {
	if (n < 0) {
		Err(NegativeInput { value = n })
	} else {
		(divide(n, 2)?)
	}
}

fn main() -> (() | Err<_>) {
	runtime_status_from_code(0)?;
	let mut answer = calculate(84)?;
	print(fmt("answer = {0}\n", (answer,)));
	match (calculate(-1)) {
		int(value) => {
			print(fmt("unexpected success: {0}\n", (value,)))
		},
		Err(error) => {
			match (error) {
				DivideByZero(zero) => {
					print("division by zero\n")
				},
				NegativeInput(negative) => {
					print(fmt("negative input: {0}\n", (negative.value,)))
				},
			}
		},
	};
	(())
}

fn failure() -> (() | Err<_>) {
	divide(1, 0)?;
	(())
}
