export { main };
import { "$/string.resin", "$/stdio.resin", "$/process.resin", "$/span.resin" };

fn main(argc: i32, argv: Ptr<Ptr<u8>>, envp: Ptr<Ptr<u8>>) -> (() | Err<_>) {
	let mut args = arguments(argc, argv);
	let mut index: u64 = 0;
	while (index < args.length) {
		let item = argument(args, index);
		let text = fmt("argument {0}: {1}\n", (index, item:bytes()));
		print(text);
		index = index + u64(1);
	};
	// Look up one deliberately chosen variable; avoid dumping the environment.
	let mut name = "RESIN_GREETING";
	match (environment_get(envp, name.data)) {
		Span<u8>(value) => {
			let message = fmt("greeting: {0}\n", (value:bytes(),));
			print(message);
		},
		Err(error) => {
			print("RESIN_GREETING is not set\n");
		},
	};
	(())
}
