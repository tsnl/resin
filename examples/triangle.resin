export { main, vertex, fragment };

import { "std/gpu.resin", "std/graphics.resin", "std/image.resin" };

@vertex_shader
def vertex(index: int) -> Vertex = {
	if (index == 0) {
		Vertex {
			position = Position {
				x = float32(0.0),
				y = float32(-0.75),
				z = float32(0.0),
				w = float32(1.0),
			},
			color = Color {
				r = float32(1.0),
				g = float32(0.0),
				b = float32(0.0),
				a = float32(1.0),
			},
		}
	} else {
		if (index == 1) {
			Vertex {
				position = Position {
					x = float32(-0.7),
					y = float32(0.6),
					z = float32(0.0),
					w = float32(1.0),
				},
				color = Color {
					r = float32(0.0),
					g = float32(1.0),
					b = float32(0.0),
					a = float32(1.0),
				},
			}
		} else {
			Vertex {
				position = Position {
					x = float32(0.7),
					y = float32(0.6),
					z = float32(0.0),
					w = float32(1.0),
				},
				color = Color {
					r = float32(0.0),
					g = float32(0.0),
					b = float32(1.0),
					a = float32(1.0),
				},
			}
		}
	}
};

@fragment_shader
def fragment(color: Color) -> Color = {
	color
};

def main() -> Result<(), _> = {
	var gpu = gpu_create()?;
	defer gpu_destroy(gpu);

	var pipeline = gpu_create_graphics_pipeline(
		gpu,
		vertex.spirv,
		fragment.spirv,
	)?;
	defer gpu_free_pipeline(gpu, pipeline);
	var image = gpu_create_image(gpu, 256, 256)?;
	defer gpu_free_image(gpu, image);
	var pixels = gpu_malloc(gpu, 262144, 4, memory_readback())?;
	defer gpu_free(gpu, pixels);
	var commands = gpu_start_command_recording(gpu)?;
	defer gpu_cancel_command_buffer(gpu, &commands);
	gpu_begin_rendering(commands, image, 0.0, 0.0, 0.0, 1.0)?;
	gpu_set_pipeline(commands, pipeline)?;
	gpu_draw(commands, 0, 3)?;
	gpu_end_rendering(commands)?;
	gpu_copy_image_to_buffer(commands, image, pixels)?;
	gpu_submit(gpu, &commands)?;

	var path = "triangle.png";
	image_write_png(Ptr<ubyte>(&path), 256, 256, 4, allocation_host_pointer(pixels), 0)?;
	print("wrote triangle.png\n", ());
	ok(())
};
