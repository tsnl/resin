export { main, vertex, fragment };

import { "$/gpu.resin", "$/graphics.resin", "$/host.resin", "$/image.resin" };

@vertex_shader
def vertex(index: int) -> Vertex = {
	if (index == 0) {
		Vertex {
			position = Position {
				x = 0.0_f,
				y = -0.75_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 1.0_f,
				g = 0.0_f,
				b = 0.0_f,
				a = 1.0_f,
			},
		}
	} else if (index == 1) {
		Vertex {
			position = Position {
				x = -0.7_f,
				y = 0.6_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 0.0_f,
				g = 1.0_f,
				b = 0.0_f,
				a = 1.0_f,
			},
		}
	} else {
		Vertex {
			position = Position {
				x = 0.7_f,
				y = 0.6_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 0.0_f,
				g = 0.0_f,
				b = 1.0_f,
				a = 1.0_f,
			},
		}
	}
};

@fragment_shader
def fragment(color: Color) -> Color = {
	color
};

def main() -> Result<(), _> = {
	var gpu = Gpu.new()?;

	var pipeline = gpu.create_graphics_pipeline(vertex, fragment)?;

	var image = gpu.create_image(256, 256)?;

	var pixels = GpuSpan<ubyte>.allocate(gpu, 262144)?;

	var commands = gpu.start_command_recording()?;

	commands.begin_rendering(image, 0.0, 0.0, 0.0, 1.0)?;
	commands.draw(pipeline, None, 3)?;
	commands.end_rendering()?;
	commands.copy_image_to_buffer(image, pixels)?;
	commands.submit()?;

	var path = "triangle.png";
	var host = Host.malloc(pixels.length)?;
	pixels.copy_to(Span<ubyte> { data = host, length = pixels.length });
	var written = ImageData.write_pixels(path.data, 256, 256, 4, host, 0);
	Host.free(host);
	written?;
	print("wrote triangle.png\n");
	ok(())
};
