export { main, vertex, fragment };

import { "$/gpu.resin", "$/graphics.resin", "$/image.resin" };

@vertex_shader
def vertex(index: int) -> Vertex = {
	if (index == 0) {
		Vertex {
			position = Position {
				x = 0.0_f,
				y = -0.75_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 1.0_f,
				g = 0.0_f,
				b = 0.0_f,
				a = 1.0_f,
			},
		}
	} else if (index == 1) {
		Vertex {
			position = Position {
				x = -0.7_f,
				y = 0.6_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 0.0_f,
				g = 1.0_f,
				b = 0.0_f,
				a = 1.0_f,
			},
		}
	} else {
		Vertex {
			position = Position {
				x = 0.7_f,
				y = 0.6_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 0.0_f,
				g = 0.0_f,
				b = 1.0_f,
				a = 1.0_f,
			},
		}
	}
};

@fragment_shader
def fragment(color: Color) -> Color = {
	color
};

def main() -> Result<(), _> = {
	var gpu = Gpu.new()?;

	var pipeline = gpu.create_graphics_pipeline(vertex.spirv, fragment.spirv)?;

	var image = gpu.create_image(256, 256)?;

	var pixels = gpu.malloc(262144, 4, Memory.readback())?;

	var commands = gpu.start_command_recording()?;

	commands.begin_rendering(image, 0.0, 0.0, 0.0, 1.0)?;
	commands.set_pipeline(pipeline)?;
	commands.draw(0, 3)?;
	commands.end_rendering()?;
	commands.copy_image_to_buffer(image, pixels)?;
	commands.submit()?;

	var path = "triangle.png";
	ImageData.write_pixels(path.data, 256, 256, 4, pixels.host_pointer(), 0)?;
	print("wrote triangle.png\n");
	ok(())
};
