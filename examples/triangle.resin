export { main, vertex, fragment };

import { "$/string.resin", "$/stdio.resin", "$/gpu.resin", "$/graphics.resin", "$/shared.resin", "$/image.resin" };

@vertex_shader
fn vertex(index: int) -> Vertex {
	if (index == 0) {
		Vertex {
			position = Position {
				x = 0.0_f,
				y = -0.75_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 1.0_f,
				g = 0.0_f,
				b = 0.0_f,
				a = 1.0_f,
			},
		}
	} else if (index == 1) {
		Vertex {
			position = Position {
				x = -0.7_f,
				y = 0.6_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 0.0_f,
				g = 1.0_f,
				b = 0.0_f,
				a = 1.0_f,
			},
		}
	} else {
		Vertex {
			position = Position {
				x = 0.7_f,
				y = 0.6_f,
				z = 0.0_f,
				w = 1.0_f,
			},
			color = Color {
				r = 0.0_f,
				g = 0.0_f,
				b = 1.0_f,
				a = 1.0_f,
			},
		}
	}
}

@fragment_shader
fn fragment(color: Color) -> Color {
	color
}

fn main() -> (() | Err<_>) {
	let mut gpu = gpu_new()?;

	let mut pipeline = gpu:create_graphics_pipeline(vertex, fragment)?;

	let mut image = gpu:create_image(256, 256)?;

	let mut pixels = gpu:alloc::<ubyte>(262144)?;

	let mut commands = gpu:start_command_recording()?;

	commands:begin_rendering(image, 0.0, 0.0, 0.0, 1.0)?;
	commands:draw(pipeline, None, 3)?;
	commands:end_rendering()?;
	commands:copy_image_to_buffer(image, pixels)?;
	commands:submit()?;

	let mut path = "triangle.png";
	let mut host = arc_span_alloc::<ubyte>(pixels.length, 0_ub)?;
	pixels:copy_to(host:get());
	image_data_write_pixels(path.data, 256, 256, 4, host:get(), 0)?;
	print("wrote triangle.png\n");
	(())
}
