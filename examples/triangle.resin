export { main, vertex, fragment };

import { "$/string.resin", "$/stdio.resin", "$/gpu.resin", "$/graphics.resin", "$/shared.resin", "$/image.resin" };

@vertex_shader
fn vertex(index: i32) -> Vertex {
	if (index == 0) {
		Vertex {
			position = Position {
				x = f32(0.0),
				y = f32(-0.75),
				z = f32(0.0),
				w = f32(1.0),
			},
			color = Color {
				r = f32(1.0),
				g = f32(0.0),
				b = f32(0.0),
				a = f32(1.0),
			},
		}
	} else if (index == 1) {
		Vertex {
			position = Position {
				x = f32(-0.7),
				y = f32(0.6),
				z = f32(0.0),
				w = f32(1.0),
			},
			color = Color {
				r = f32(0.0),
				g = f32(1.0),
				b = f32(0.0),
				a = f32(1.0),
			},
		}
	} else {
		Vertex {
			position = Position {
				x = f32(0.7),
				y = f32(0.6),
				z = f32(0.0),
				w = f32(1.0),
			},
			color = Color {
				r = f32(0.0),
				g = f32(0.0),
				b = f32(1.0),
				a = f32(1.0),
			},
		}
	}
}

@fragment_shader
fn fragment(color: Color) -> Color {
	color
}

fn main() -> (() | Err<_>) {
	let mut gpu = gpu_new()?;

	let mut pipeline = gpu:create_graphics_pipeline(vertex, fragment)?;

	let mut image = gpu:create_image(256, 256)?;

	let mut pixels = gpu:alloc::<u8>(262144)?;

	let mut commands = gpu:start_command_recording()?;

	commands:begin_rendering(image, 0.0, 0.0, 0.0, 1.0)?;
	commands:draw(pipeline, None, 3)?;
	commands:end_rendering()?;
	commands:copy_image_to_buffer(image, pixels)?;
	commands:submit()?;

	let mut path = "triangle.png";
	let mut host = arc_span_alloc::<u8>(pixels.length, u8(0))?;
	pixels:copy_to(host:get());
	let view = host:get();
	image_data_write_pixels(bytes(path), 256, 256, 4, view:read_only(), 0)?;
	print("wrote triangle.png\n");
	(())
}
