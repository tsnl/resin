export { main, vertex, fragment };

import { "std/gpu.resin", "std/graphics.resin", "std/image.resin" };

@vertex_shader
def vertex(index: int) -> Vertex = {
	if (index == 0) {
		Vertex {
			position = Position {
				x = 0.0f,
				y = -0.75f,
				z = 0.0f,
				w = 1.0f,
			},
			color = Color {
				r = 1.0f,
				g = 0.0f,
				b = 0.0f,
				a = 1.0f,
			},
		}
	} else {
		if (index == 1) {
			Vertex {
				position = Position {
					x = -0.7f,
					y = 0.6f,
					z = 0.0f,
					w = 1.0f,
				},
				color = Color {
					r = 0.0f,
					g = 1.0f,
					b = 0.0f,
					a = 1.0f,
				},
			}
		} else {
			Vertex {
				position = Position {
					x = 0.7f,
					y = 0.6f,
					z = 0.0f,
					w = 1.0f,
				},
				color = Color {
					r = 0.0f,
					g = 0.0f,
					b = 1.0f,
					a = 1.0f,
				},
			}
		}
	}
};

@fragment_shader
def fragment(color: Color) -> Color = {
	color
};

def main() -> Result<(), _> = {
	var gpu = gpu_create()?;

	var pipeline = gpu_create_graphics_pipeline(
		gpu,
		vertex.spirv,
		fragment.spirv,
	)?;

	var image = gpu_create_image(gpu, 256, 256)?;

	var pixels = gpu_malloc(gpu, 262144, 4, memory_readback())?;

	var commands = gpu_start_command_recording(gpu)?;

	gpu_begin_rendering(commands, image, 0.0, 0.0, 0.0, 1.0)?;
	gpu_set_pipeline(commands, pipeline)?;
	gpu_draw(commands, 0, 3)?;
	gpu_end_rendering(commands)?;
	gpu_copy_image_to_buffer(commands, image, pixels)?;
	gpu_submit(gpu, &commands)?;

	var path = "triangle.png";
	image_write_png(Ptr<ubyte>(&path), 256, 256, 4, allocation_host_pointer(pixels), 0)?;
	print("wrote triangle.png\n", ());
	ok(())
};
