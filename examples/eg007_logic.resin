export { main };

import { "$/string.resin", "$/stdio.resin" };

struct Pair {
	a: int,
	b: int,
}
fn clamp(n: int, lo: int, hi: int) -> int {
	if ((n < lo) || (n > hi)) {
		lo
	} else {
		n
	}
}

fn both(a: int, b: int) -> bool {
	(a != 0) && (b != 0)
}

fn pair(a: int, b: int) -> Pair {
	Pair { a = a, b = b }
}

fn main() -> () {
	let mut xs = [1, 2, 3];
	print(
		fmt(
			"clamp(5, 0, 10) = {0}, both(1, 2) = {1}, pair(3, 4).a = {2}\n",
			(clamp(5, 0, 10), both(1, 2), pair(3, 4).a),
		)
	);
}
