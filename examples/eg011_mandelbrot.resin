export { main };

import { "$/string.resin", "$/span.resin" };

struct Complex {
	real: float32,
	imag: float32,

	def mul(self: Complex, other: Complex) -> Complex = {
		// (a + bi) (c + di)
		// = ac + adi + bci - bd
		// = (ac - bd) + i(ad + bc)
		Complex {
			real = self.real * other.real - self.imag * other.imag,
			imag = self.real * other.imag + self.imag * other.real,
		}
	};

	def squared(self: Complex) -> Complex = {
		self.mul(self)
	};

	def magnitude_squared(self: Complex) -> float32 = {
		self.real * self.real + self.imag * self.imag
	};

	def add(self: Complex, other: Complex) -> Complex = {
		Complex {
			real = self.real + other.real,
			imag = self.imag + other.imag,
		}
	};

	def new(real: float32, imag: float32) -> Complex = {
		Complex {
			real = real,
			imag = imag,
		}
	};

	def zero() -> Complex = {
		Complex.new(0.0, 0.0)
	};

	def string(self: Complex) -> String = {
		fmt("{0}+i{1}", (self.real, self.imag))
	};
};

struct Plot {
	data: Span<Complex>,
	width: uint,
	height: uint,

	def at(self: Plot, x: uint, y: uint) -> Ref<Complex> = {
		self.data.at(ulong(y * self.width + x))
	};
};

struct Mandelbrot {
	max_iters: int,

	def new(max_iters: int) -> Mandelbrot = {
		Mandelbrot { max_iters = max_iters }
	};

	def escapes_ball(self: Mandelbrot, c: Complex) -> bool = {
		var n = 0;
		var a = Complex.zero();
		while (n < self.max_iters && a.magnitude_squared() <= 4.0) {
			n := n + 1;
			a := a.squared().add(c);
		};
		a.magnitude_squared() > 4.0
	};

	def test() -> Result<(), TestError> = {
		var mandelbrot = Mandelbrot.new(128);

		if (mandelbrot.escapes_ball(Complex.zero())) {
			err(TestError { message = "c=0 should never escape" })
		} else if (mandelbrot.escapes_ball(Complex.new(-1.0, 0.0))) {
			err("c=-1 should never escape")
		} else if (mandelbrot.escapes_ball(Complex.new(-2.0, 0.0))) {
			err("c=-2 should never escape")
		} else if (mandelbrot.escapes_ball(Complex.new(0.0, 1.0))) {
			err("c=i should never escape")
		} else if (!mandelbrot.escapes_ball(Complex.new(1.0, 0.0))) {
			err("c=1 should escape")
		} else if (!mandelbrot.escapes_ball(Complex.new(2.0, 0.0))) {
			err("c=2 should escape")
		} else {
			ok(())
		}
	};
};

struct TestError {
	message: String,
};

def main() = {
	print("Hello, world\n");
};
