// Mandelbrot explorer. Arrows/WASD pan; scroll or +/- zoom; [/] change
// the iteration limit; R/Home resets; P saves a screenshot; Escape closes.
// Use --help for headless output and view options.
export { main, test };

import {
	"$/math.resin",
	"$/string.resin",
	"$/span.resin",
	"$/gpu.resin",
	"$/graphics.resin",
	"$/window.resin",
	"$/process.resin",
	"$/image.resin",
	"$/shared.resin",
	"$/io.resin",
	"mandelbrot/options.resin",
};

//
// Image coordinates and the Mandelbrot recurrence
//

struct Plot {
	width: uint,
	height: uint,
	center: Complex<float32>,
	span: float32,
}

fn plot_new(width: uint, height: uint) -> Plot {
	Plot { width = width, height = height, center = complex(-0.5_f, 0.0_f), span = 3.0_f }
}

// Coordinates are in pixels; (x + 0.5, y + 0.5) is the pixel center.
// Positive imaginary coordinates point upwards.
fn at(self: Ref<Plot>, x: float32, y: float32) -> Complex<float32> {
	complex(
		self.center.real + (x - 0.5_f * float32(self.width)) * self.span / float32(self.height),
		self.center.imag + (0.5_f * float32(self.height) - y) * self.span / float32(self.height),
	)
}

struct Mandelbrot {
	max_iters: int,
}

fn mandelbrot_new(max_iters: int) -> Mandelbrot {
	Mandelbrot { max_iters = max_iters }
}

// Zero means the orbit stayed inside the escape radius for this iteration budget;
// it is not a proof of membership. Escape requires a magnitude strictly above two.
fn escape_iterations(self: Ref<Mandelbrot>, c: Complex<float32>) -> int {
	// Check the first iterate before the interior shortcut can overflow at large coordinates.
	if (self.max_iters > 0 && c:magnitude_squared() > 4.0_f) {
		return 1;
	};
	// The main cardioid and period-two bulb are known interiors.
	let x = c.real - 0.25_f;
	let y2 = c.imag * c.imag;
	let q = x * x + y2;
	if (q * (q + x) <= 0.25_f * y2 || (c.real + 1.0_f) * (c.real + 1.0_f) + y2 <= 0.0625_f) {
		return 0;
	};
	let mut n = 0_i;
	let mut a = complex(0.0_f, 0.0_f);
	while (n < self.max_iters) {
		// The same Complex helpers borrow local values on host and shader.
		a = a:squared():add(c);
		n = n + 1;
		if (a:magnitude_squared() > 4.0_f) {
			return n;
		};
	};
	0
}

fn escapes_ball(self: Ref<Mandelbrot>, c: Complex<float32>) -> bool {
	self:escape_iterations(c) != 0
}

//
// Color evaluation and sampling
//

fn palette(count: int) -> Color {
	if (count == 0) {
		return Color { r = 0.0_f, g = 0.0_f, b = 0.0_f, a = 1.0_f };
	};
	// Repeating blue-to-gold bands; reserve black for bounded orbits.
	let t = float32((count & 63) + 1) / 65.0_f;
	let u = 1.0_f - t;
	Color {
		r = 9.0_f * u * t * t * t,
		g = 15.0_f * u * u * t * t,
		b = 8.5_f * u * u * u * t,
		a = 1.0_f,
	}
}

// An incremental mean keeps coloring independent of sample placement.
fn blend(accumulated: Color, sample: Color, weight: float32) -> Color {
	Color {
		r = accumulated.r + (sample.r - accumulated.r) * weight,
		g = accumulated.g + (sample.g - accumulated.g) * weight,
		b = accumulated.b + (sample.b - accumulated.b) * weight,
		a = 1.0_f,
	}
}

// Halton points 1..16, radical inverses in bases 2 and 3. Every quality level
// uses a prefix of this LUT: https://pbr-book.org/4ed/Sampling_and_Reconstruction/Halton_Sampler
fn halton_samples() -> _ {
	[
		(0.5_f, 1.0_f / 3.0_f),
		(0.25_f, 2.0_f / 3.0_f),
		(0.75_f, 1.0_f / 9.0_f),
		(0.125_f, 4.0_f / 9.0_f),
		(0.625_f, 7.0_f / 9.0_f),
		(0.375_f, 2.0_f / 9.0_f),
		(0.875_f, 5.0_f / 9.0_f),
		(0.0625_f, 8.0_f / 9.0_f),
		(0.5625_f, 1.0_f / 27.0_f),
		(0.3125_f, 10.0_f / 27.0_f),
		(0.8125_f, 19.0_f / 27.0_f),
		(0.1875_f, 4.0_f / 27.0_f),
		(0.6875_f, 13.0_f / 27.0_f),
		(0.4375_f, 22.0_f / 27.0_f),
		(0.9375_f, 7.0_f / 27.0_f),
		(0.03125_f, 16.0_f / 27.0_f),
	]
}

type Sample = (float32, float32);
type SegmentOrigin = (uint, uint);
const pixels_per_segment = 32_ui;

struct Parameters {
	plot: Plot,
	solver: Mandelbrot,
	samples: Span<Sample>,
	segments: Span<SegmentOrigin>,
	pixels: Span<ubyte>,
}

fn evaluate_pixel(root: Ref<Parameters>, x: uint, y: uint) -> Color {
	let mut color = Color { r = 0.0_f, g = 0.0_f, b = 0.0_f, a = 1.0_f };
	let mut i = 0_ul;
	while (i < root.samples.length) {
		let offset = root.samples:at(i);
		let c = root.plot:at(float32(x) + offset.0, float32(y) + offset.1);
		let count = root.solver:escape_iterations(c);
		color = blend(color, palette(count), 1.0_f / float32(i + 1_ul));
		i = i + 1_ul;
	};
	color
}

fn channel(value: float32) -> ubyte {
	ubyte(value * 255.0_f + 0.5_f)
}

fn store_pixel(pixels: Ref<Span<ubyte>>, index: ulong, color: Color) {
	pixels:at(index * 4_ul) = channel(color.r);
	pixels:at(index * 4_ul + 1_ul) = channel(color.g);
	pixels:at(index * 4_ul + 2_ul) = channel(color.b);
	pixels:at(index * 4_ul + 3_ul) = 255_ub;
}

// Each segment owns up to 32 adjacent pixels in one row. Segment origins come
// from segments_new; the final segment in each row stops at the right edge.
fn evaluate_segment(segment_index: ulong, root: Ref<Parameters>) {
	if (segment_index >= root.segments.length) {
		return;
	};
	let origin = root.segments:at(segment_index);
	let mut x = origin.0;
	while (x < origin.0 + pixels_per_segment && x < root.plot.width) {
		root.pixels:store_pixel(ulong(origin.1) * ulong(root.plot.width) + ulong(x), evaluate_pixel(root, x, origin.1));
		x = x + 1;
	};
}

// Explicit origins avoid shader integer division and make dispatch batches simple.
fn segments_new(width: uint, height: uint) -> ArcSpan<SegmentOrigin> | Err<_> {
	let columns = (ulong(width) + ulong(pixels_per_segment) - 1_ul) / ulong(pixels_per_segment);
	let segments = arc_span_alloc::<SegmentOrigin>(columns * ulong(height), (0_ui, 0_ui))?;
	let mut index = 0_ul;
	let mut y = 0_ui;
	while (y < height) {
		let mut x = 0_ui;
		while (x < width) {
			segments:get():at(index) = (x, y);
			index = index + 1_ul;
			x = x + pixels_per_segment;
		};
		y = y + 1;
	};
	segments
}

fn clone(self: Ref<Plot>) -> Plot {
	Plot { width = self.width, height = self.height, center = complex(self.center.real, self.center.imag), span = self.span }
}

// CPU execution calls the same evaluator as the shader wrapper.
fn dispatch_host(root: Ref<Parameters>) {
	let mut segment = 0_ul;
	while (segment < root.segments.length) {
		evaluate_segment(segment, root);
		segment = segment + 1_ul;
	};
}

fn host_image(plot: Ref<Plot>, solver: Ref<Mandelbrot>, samples: int) -> ArcSpan<ubyte> | Err<_> {
	let pixels = arc_span_alloc::<ubyte>(ulong(plot.width) * ulong(plot.height) * 4_ul, 0_ub)?;
	let segments = segments_new(plot.width, plot.height)?;
	let lut = arc_ptr_alloc(halton_samples())?;
	let root = Parameters { plot = plot:clone(), solver = mandelbrot_new(solver.max_iters), samples = Span<Sample> { data = lut:get():lea(0_ul), length = ulong(samples) }, segments = segments:get(), pixels = pixels:get() };
	dispatch_host(root);
	pixels
}

//
// GPU execution and presentation helpers
//

struct HostParameters {
	plot: Plot,
	solver: Mandelbrot,
	samples: GpuSpan<Sample>,
	segments: GpuSpan<SegmentOrigin>,
	pixels: GpuSpan<ubyte>,
}

@compute_shader
fn compute(segment_index: ulong, root: Ptr<Parameters>) {
	evaluate_segment(segment_index, root.*);
}

@vertex_shader
fn vertex(index: int) -> Vertex {
	let x = if (index == 1) {
		3.0_f
	} else {
		-1.0_f
	};
	let y = if (index == 2) {
		3.0_f
	} else {
		-1.0_f
	};
	Vertex {
		position = Position { x = x, y = y, z = 0.0_f, w = 1.0_f },
		color = Color { r = (x + 1.0_f) * 0.5_f, g = (y + 1.0_f) * 0.5_f, b = 0.0_f, a = 1.0_f },
	}
}

@fragment_shader
fn fragment(uv: Color, root: Ptr<Parameters>) -> Color {
	let x = uint(uv.r * float32(root.plot.width));
	let y = uint(uv.g * float32(root.plot.height));
	let index = (ulong(y) * ulong(root.plot.width) + ulong(x)) * 4_ul;
	Color {
		r = float32(root.pixels:at(index)) / 255.0_f,
		g = float32(root.pixels:at(index + 1_ul)) / 255.0_f,
		b = float32(root.pixels:at(index + 2_ul)) / 255.0_f,
		a = 1.0_f,
	}
}

struct Renderer {
	gpu: Gpu,
	graphics: GpuGraphicsPipeline<Parameters, GpuPipelineOwner>,
	compute: GpuComputePipeline<Parameters, GpuPipelineOwner>,
	samples: GpuSpan<Sample>,
	segments: GpuSpan<SegmentOrigin>,
	pixels: GpuSpan<ubyte>,
	image: GpuImage,
}

fn upload<T>(gpu: Ref<Gpu>, source: Ref<Span<T>>) -> GpuSpan<T> | Err<_> {
	let buffer = gpu:alloc::<T>(source.length)?;
	buffer:copy_from(source);
	buffer
}

fn renderer_new(gpu: Gpu, width: uint, height: uint) -> Renderer | Err<_> {
	let graphics = gpu:create_graphics_pipeline(vertex, fragment)?;
	let compute_pipeline = gpu:create_compute_pipeline(compute)?;
	let lut = arc_ptr_alloc(halton_samples())?;
	let samples = upload(gpu, Span<Sample> { data = lut:get():lea(0_ul), length = 16_ul })?;
	let segments = upload(gpu, segments_new(width, height)?:get())?;
	let pixels = gpu:alloc::<ubyte>(ulong(width) * ulong(height) * 4_ul)?;
	let image = gpu:create_image(width, height)?;
	Renderer { gpu = gpu, graphics = graphics, compute = compute_pipeline, samples = samples, segments = segments, pixels = pixels, image = image }
}

fn resize(self: Ref<Renderer>, width: uint, height: uint) -> () | Err<_> {
	self.segments = upload(self.gpu, segments_new(width, height)?:get())?;
	self.pixels = self.gpu:alloc::<ubyte>(ulong(width) * ulong(height) * 4_ul)?;
	self.image = self.gpu:create_image(width, height)?;
}

fn parameters(self: Ref<Renderer>, plot: Ref<Plot>, solver: Ref<Mandelbrot>, samples: int, start: ulong, count: ulong) -> HostParameters {
	HostParameters { plot = plot:clone(), solver = mandelbrot_new(solver.max_iters), samples = self.samples:slice(0_ul, ulong(samples)), segments = self.segments:slice(start, count), pixels = self.pixels:clone() }
}

fn dispatch_gpu(self: Ref<Renderer>, commands: Ref<GpuCommands>, plot: Ref<Plot>, solver: Ref<Mandelbrot>, samples: int) -> () | Err<_> {
	let group_size = self.gpu:compute_workgroup_size();
	let capacity = 65535_ul * group_size;
	let mut start = 0_ul;
	while (start < self.segments.length) {
		let remaining = self.segments.length - start;
		let count = if (remaining < capacity) {
			remaining
		} else {
			capacity
		};
		let groups = uint((count + group_size - 1_ul) / group_size);
		commands:dispatch(self.compute, self:parameters(plot, solver, samples, start, count), groups, 1, 1)?;
		start = start + count;
	};
}

fn render(self: Ref<Renderer>, plot: Ref<Plot>, solver: Ref<Mandelbrot>, samples: int, use_gpu: bool) -> () | Err<_> {
	if (!use_gpu) {
		self.pixels:copy_from(host_image(plot, solver, samples)?:get());
	};
	let commands = self.gpu:start_command_recording()?;
	if (use_gpu) {
		self:dispatch_gpu(commands, plot, solver, samples)?;
	};
	// Both execution modes reach the same buffer and presentation pipeline.
	commands:begin_rendering(self.image, 0.0_f, 0.0_f, 0.0_f, 1.0_f)?;
	commands:draw(self.graphics, self:parameters(plot, solver, samples, 0_ul, self.segments.length), 3)?;
	commands:end_rendering()?;
	commands:submit()?;
}

fn save_png(path: Ptr<ubyte>, width: uint, height: uint, pixels: Ref<Span<ubyte>>) -> () | Err<_> {
	image_data_write_pixels(path, width, height, 4, pixels, 0)?;
	print(fmt("Saved {0}\n", (c_string(path):bytes(),)));
}

// Read the displayed image in one transfer, including the currently selected view.
fn screenshot(renderer: Ref<Renderer>, path: Ptr<ubyte>) -> () | Err<_> {
	let image_width = renderer.image:width();
	let image_height = renderer.image:height();
	let count = ulong(image_width) * ulong(image_height) * 4_ul;
	let pixels = renderer.gpu:alloc_in::<ubyte>(count, memory_readback)?;
	let commands = renderer.gpu:start_command_recording()?;
	commands:copy_image_to_buffer(renderer.image, pixels)?;
	commands:submit()?;
	let host = arc_span_alloc::<ubyte>(count, 0_ub)?;
	pixels:copy_to(host:get());
	save_png(path, image_width, image_height, host:get())?;
}

//
// Application and input
//

fn zoom(plot: Ref<Plot>, factor: float32) {
	// Keep subpixel offsets distinguishable with float32 coordinates.
	let minimum = float32(plot.height) * 1.0e-6_f;
	let next = plot.span * factor;
	plot.span = if (next < minimum) {
		minimum
	} else if (next > 8.0_f) {
		8.0_f
	} else {
		next
	};
}

fn input(window: Ref<Window>, plot: Ref<Plot>, solver: Ref<Mandelbrot>) -> bool {
	if (!window:focused()) {
		return false;
	};
	let mut changed = false;
	let step = plot.span * 0.06_f;
	if (window:key_pressed(key_left) || window:key_pressed(key_a)) {
		plot.center.real = plot.center.real - step;
		changed = true;
	};
	if (window:key_pressed(key_right) || window:key_pressed(key_d)) {
		plot.center.real = plot.center.real + step;
		changed = true;
	};
	if (window:key_pressed(key_up) || window:key_pressed(key_w)) {
		plot.center.imag = plot.center.imag + step;
		changed = true;
	};
	if (window:key_pressed(key_down) || window:key_pressed(key_s)) {
		plot.center.imag = plot.center.imag - step;
		changed = true;
	};
	if (window:key_pressed(key_equal)) {
		plot:zoom(0.85_f);
		changed = true;
	};
	if (window:key_pressed(key_minus)) {
		plot:zoom(1.0_f / 0.85_f);
		changed = true;
	};
	if (window:key_state(key_right_bracket).pressed && solver.max_iters < 4096) {
		let next = solver.max_iters * 2;
		solver.max_iters = if (next > 4096) {
			4096
		} else {
			next
		};
		changed = true;
	};
	if (window:key_state(key_left_bracket).pressed && solver.max_iters > 32) {
		let next = solver.max_iters / 2;
		solver.max_iters = if (next < 32) {
			32
		} else {
			next
		};
		changed = true;
	};
	if (window:key_state(key_r).pressed || window:key_state(key_home).pressed) {
		plot.center.real = -0.5_f;
		plot.center.imag = 0.0_f;
		plot.span = 3.0_f;
		solver.max_iters = 256;
		changed = true;
	};
	changed
}

fn headless(options: Ref<Options>, plot: Ref<Plot>, solver: Ref<Mandelbrot>, path: Ptr<ubyte>) -> () | Err<_> {
	if (options.use_gpu) {
		let renderer = renderer_new(gpu_new()?, plot.width, plot.height)?;
		renderer:render(plot, solver, options.samples, true)?;
		renderer:screenshot(path)?;
	} else {
		save_png(path, plot.width, plot.height, host_image(plot, solver, options.samples)?:get())?;
	};
}

fn interactive(options: Ref<Options>, mut plot: Plot, mut solver: Mandelbrot) -> () | Err<_> {
	print("Arrows/WASD: pan | scroll/+/-: zoom | [/]: iterations | R: reset | P: screenshot | Esc: quit\n");
	let window = window_new(plot.width, plot.height, string_from_str("Mandelbrot | arrows: pan | +/-: zoom | [/]: detail | P: screenshot"))?;
	let mut renderer = renderer_new(gpu_new_for_window(window)?, plot.width, plot.height)?;
	let mut dirty = true;
	let mut refine = false;
	while (true) {
		// Pace held keys even when presentation does not wait for a refresh.
		window:wait_events(1.0_d / 60.0_d)?;
		if (window:should_close() || window:key_state(key_escape).pressed) {
			break;
		};
		let size = window:framebuffer_size()?;
		if (size.0 == 0 || size.1 == 0) {
			continue;
		};
		if (size.0 != plot.width || size.1 != plot.height) {
			plot.width = size.0;
			plot.height = size.1;
			plot:zoom(1.0_f);
			renderer:resize(size.0, size.1)?;
			dirty = true;
		};
		let previous_limit = solver.max_iters;
		if (input(window, plot, solver)) {
			dirty = true;
		};
		if (solver.max_iters != previous_limit) {
			print(fmt("Iteration limit: {0}\n", (solver.max_iters,)));
		};
		let scroll = window:scroll_delta()?;
		if (window:focused() && scroll.1 != 0.0_d) {
			plot:zoom(
				if (scroll.1 > 0.0_d) {
					1.0_f / (1.0_f + 0.2_f * float32(scroll.1))
				} else {
					1.0_f - 0.2_f * float32(scroll.1)
				}
			);
			dirty = true;
		};
		let capture = window:focused() && window:key_state(key_p).pressed;
		if (dirty || refine) {
			// A screenshot gets the selected quality even while input is changing.
			let samples = if (dirty && !capture) {
				1_i
			} else {
				options.samples
			};
			renderer:render(plot, solver, samples, options.use_gpu)?;
			refine = dirty && samples != options.samples;
			dirty = false;
		};
		if (capture) {
			renderer:screenshot(options.screenshot)?;
		};
		renderer.gpu:present(renderer.image)?;
	};
}

fn main(argc: int, argv: Ptr<Ptr<ubyte>>, envp: Ptr<Ptr<ubyte>>) -> int | Err<_> {
	let options = match (parse_options(arguments(argc, argv))) {
		Options(options) => {
			options
		},
		Err(message) => {
			io_stderr():write(fmt("{0}\nUse --help for usage.\n", (message,)))?;
			return 2;
		},
	};
	if (options.help) {
		print_help();
		return 0;
	};
	let mut plot = plot_new(options.width, options.height);
	plot.center.real = options.real;
	plot.center.imag = options.imag;
	plot.span = options.span;
	let solver = mandelbrot_new(options.iterations);
	match (options.output) {
		Ptr<ubyte>(path) => {
			headless(options, plot, solver, path)?;
		},
		None => {
			interactive(options, plot, solver)?;
		},
	};
	0
}

//
// CPU checks of the shared algorithm
//

fn test() -> () | Err<_> {
	let mandelbrot = mandelbrot_new(128);
	let zero = complex(0.0_f, 0.0_f);
	let minus_one = complex(-1.0_f, 0.0_f);
	let minus_two = complex(-2.0_f, 0.0_f);
	let i = complex(0.0_f, 1.0_f);
	let one = complex(1.0_f, 0.0_f);
	let two = complex(2.0_f, 0.0_f);
	let three = complex(3.0_f, 0.0_f);
	assert(!mandelbrot:escapes_ball(zero));
	assert(!mandelbrot:escapes_ball(minus_one));
	assert(!mandelbrot:escapes_ball(minus_two));
	assert(!mandelbrot:escapes_ball(i));
	assert(mandelbrot:escape_iterations(one) == 3);
	assert(mandelbrot:escape_iterations(two) == 2);
	assert(mandelbrot:escape_iterations(three) == 1);
	assert(mandelbrot:escape_iterations(complex(1.0e30_f, 1.0e30_f)) == 1);
	let limited = mandelbrot_new(1);
	assert(!limited:escapes_ball(complex(2.0_f, 0.0_f)));
	let upper = complex(-0.75_f, 0.25_f);
	let lower = complex(-0.75_f, -0.25_f);
	assert(mandelbrot:escape_iterations(upper) == mandelbrot:escape_iterations(lower));
	let mut plot = plot_new(4, 2);
	let top_left = plot:at(0.5_f, 0.5_f);
	let bottom_right = plot:at(3.5_f, 1.5_f);
	assert(top_left.real == -2.75_f && top_left.imag == 0.75_f);
	assert(bottom_right.real == 1.75_f && bottom_right.imag == -0.75_f);
	plot:zoom(0.5_f);
	assert(plot.span == 1.5_f && plot.center.real == -0.5_f);
	plot:zoom(100.0_f);
	assert(plot.span == 8.0_f);
	plot:zoom(1.0e-15_f);
	assert(plot.span == 2.0e-6_f);
	let lut = arc_ptr_alloc(halton_samples())?;
	let mut sample = 1_ul;
	while (sample <= 16_ul) {
		let point = lut:get():at(sample - 1_ul);
		assert(point.0 == radical_inverse(sample, 2_ul));
		assert(point.1 - radical_inverse(sample, 3_ul) < 0.000001_f);
		assert(radical_inverse(sample, 3_ul) - point.1 < 0.000001_f);
		sample = sample + 1_ul;
	};
	// The first four Halton samples in this pixel escape after 1, 2, 1, 2 iterations.
	let mut edge = plot_new(1, 1);
	edge.center.real = 2.0_f;
	edge.span = 2.0_f;
	let pixels = arc_ptr_alloc([0_ub, 0_ub, 0_ub, 0_ub, 123_ub])?;
	let segments = arc_ptr_alloc([(0_ui, 0_ui)])?;
	let root = Parameters { plot = edge, solver = mandelbrot_new(32), samples = Span<Sample> { data = lut:get():lea(0_ul), length = 4_ul }, segments = Span<SegmentOrigin> { data = segments:get():lea(0_ul), length = 1_ul }, pixels = Span<ubyte> { data = pixels:get():lea(0_ul), length = 4_ul } };
	dispatch_host(root);
	evaluate_segment(1_ul, root);
	let first = palette(1);
	let second = palette(2);
	assert(pixels:get():at(0_ul) == channel((first.r + second.r) * 0.5_f));
	assert(pixels:get():at(1_ul) == channel((first.g + second.g) * 0.5_f));
	assert(pixels:get():at(2_ul) == channel((first.b + second.b) * 0.5_f));
	assert(pixels:get():at(3_ul) == 255_ub && pixels:get():at(4_ul) == 123_ub);
	print("Mandelbrot tests passed\n");
}

// Host-only reference for checking the fixed sampling table.
fn radical_inverse(mut index: ulong, base: ulong) -> float32 {
	let mut result = 0.0_f;
	let mut place = 1.0_f / float32(base);
	while (index > 0_ul) {
		result = result + float32(index % base) * place;
		index = index / base;
		place = place / float32(base);
	};
	result
}
