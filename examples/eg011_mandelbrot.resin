// Mandelbrot explorer. Arrows/WASD pan; scroll or +/- zoom; [/] change
// the iteration limit; R/Home resets; Escape closes the window.
export { main, test };

import {
	"$/math.resin",
	"$/string.resin",
	"$/span.resin",
	"$/gpu.resin",
	"$/graphics.resin",
	"$/window.resin",
};

struct Plot {
	width: uint,
	height: uint,
	center: Complex<float64>,
	span: float64,
	aspect: float64,
}

fn plot_new(width: uint, height: uint, aspect: float64) -> Plot {
	Plot { width = width, height = height, center = complex(-0.5_d, 0.0_d), span = 3.0_d, aspect = aspect }
}

// Sample pixel centers; positive imaginary coordinates point upwards.
fn at(self: Ref<Plot>, x: uint, y: uint) -> Complex<float64> {
	complex(
		self.center.real + ((float64(x) + 0.5_d) / float64(self.width) - 0.5_d) * self.span * self.aspect,
		self.center.imag + (0.5_d - (float64(y) + 0.5_d) / float64(self.height)) * self.span,
	)
}

struct Mandelbrot {
	max_iters: int,
}

fn mandelbrot_new(max_iters: int) -> Mandelbrot {
	Mandelbrot { max_iters = max_iters }
}

// Zero means the orbit stayed inside the escape radius for this iteration budget;
// it is not a proof of membership. Escape requires a magnitude strictly above two.
fn escape_iterations(self: Ref<Mandelbrot>, c: Ref<Complex<float64>>) -> int {
	// The main cardioid and period-two bulb are known interiors.
	let x = c.real - 0.25_d;
	let y2 = c.imag * c.imag;
	let q = x * x + y2;
	if (q * (q + x) <= 0.25_d * y2 || (c.real + 1.0_d) * (c.real + 1.0_d) + y2 <= 0.0625_d) {
		return 0;
	};
	let mut n = 0_i;
	let mut a = complex(0.0_d, 0.0_d);
	while (n < self.max_iters) {
		let square = a:squared();
		a = square:add(c);
		n = n + 1;
		if (a:magnitude_squared() > 4.0_d) {
			return n;
		};
	};
	0
}

fn escapes_ball(self: Ref<Mandelbrot>, c: Ref<Complex<float64>>) -> bool {
	self:escape_iterations(c) != 0
}

fn solve(self: Ref<Mandelbrot>, plot: Ref<Plot>, iterations: Ref<GpuSpan<uint>>) {
	let mut y = 0_ui;
	while (y < plot.height) {
		let mut x = 0_ui;
		while (x < plot.width) {
			let c = plot:at(x, y);
			let count = self:escape_iterations(c);
			let pixel = iterations:at(ulong(y) * ulong(plot.width) + ulong(x));
			pixel:store(uint(count));
			x = x + 1;
		};
		y = y + 1;
	};
}

fn zoom(plot: Ref<Plot>, factor: float64) {
	let next = plot.span * factor;
	plot.span = if (next < 1.0e-12_d) {
		1.0e-12_d
	} else if (next > 8.0_d) {
		8.0_d
	} else {
		next
	};
}

fn input(window: Ref<Window>, plot: Ref<Plot>, solver: Ref<Mandelbrot>) -> bool {
	if (!window:focused()) {
		return false;
	};
	let mut changed = false;
	let step = plot.span * 0.06_d;
	if (window:key_pressed(key_left) || window:key_pressed(key_a)) {
		plot.center.real = plot.center.real - step;
		changed = true;
	};
	if (window:key_pressed(key_right) || window:key_pressed(key_d)) {
		plot.center.real = plot.center.real + step;
		changed = true;
	};
	if (window:key_pressed(key_up) || window:key_pressed(key_w)) {
		plot.center.imag = plot.center.imag + step;
		changed = true;
	};
	if (window:key_pressed(key_down) || window:key_pressed(key_s)) {
		plot.center.imag = plot.center.imag - step;
		changed = true;
	};
	if (window:key_pressed(key_equal)) {
		plot:zoom(0.85_d);
		changed = true;
	};
	if (window:key_pressed(key_minus)) {
		plot:zoom(1.0_d / 0.85_d);
		changed = true;
	};
	if (window:key_state(key_right_bracket).pressed && solver.max_iters < 4096) {
		solver.max_iters = solver.max_iters * 2;
		changed = true;
	};
	if (window:key_state(key_left_bracket).pressed && solver.max_iters > 32) {
		solver.max_iters = solver.max_iters / 2;
		changed = true;
	};
	if (window:key_state(key_r).pressed || window:key_state(key_home).pressed) {
		plot.center.real = -0.5_d;
		plot.center.imag = 0.0_d;
		plot.span = 3.0_d;
		solver.max_iters = 256;
		changed = true;
	};
	changed
}

// The CPU solves the grid. A fullscreen triangle colors the iteration counts.
struct Pixels {
	iterations: Span<uint>,
	width: uint,
	height: uint,
}

struct HostPixels {
	iterations: GpuSpan<uint>,
	width: uint,
	height: uint,
}

@vertex_shader
fn vertex(index: int) -> Vertex {
	let x = if (index == 1) {
		3.0_f
	} else {
		-1.0_f
	};
	let y = if (index == 2) {
		3.0_f
	} else {
		-1.0_f
	};
	Vertex {
		position = Position { x = x, y = y, z = 0.0_f, w = 1.0_f },
		color = Color { r = (x + 1.0_f) * 0.5_f, g = (y + 1.0_f) * 0.5_f, b = 0.0_f, a = 1.0_f },
	}
}

@fragment_shader
fn fragment(uv: Color, root: Ptr<Pixels>) -> Color {
	let x = uint(uv.r * float32(root.width));
	let y = uint(uv.g * float32(root.height));
	let count = root.iterations:at(ulong(y) * ulong(root.width) + ulong(x));
	if (count == 0) {
		return Color { r = 0.0_f, g = 0.0_f, b = 0.0_f, a = 1.0_f };
	};
	// Repeating blue-to-gold bands; reserve black for bounded orbits.
	let t = float32((count & 63_ui) + 1_ui) / 65.0_f;
	let u = 1.0_f - t;
	Color {
		r = 9.0_f * u * t * t * t,
		g = 15.0_f * u * u * t * t,
		b = 8.5_f * u * u * u * t,
		a = 1.0_f,
	}
}

fn test() {
	let mandelbrot = mandelbrot_new(128);
	let zero = complex(0.0_d, 0.0_d);
	let minus_one = complex(-1.0_d, 0.0_d);
	let minus_two = complex(-2.0_d, 0.0_d);
	let i = complex(0.0_d, 1.0_d);
	let one = complex(1.0_d, 0.0_d);
	let two = complex(2.0_d, 0.0_d);
	let three = complex(3.0_d, 0.0_d);
	assert(!mandelbrot:escapes_ball(zero));
	assert(!mandelbrot:escapes_ball(minus_one));
	assert(!mandelbrot:escapes_ball(minus_two));
	assert(!mandelbrot:escapes_ball(i));
	assert(mandelbrot:escape_iterations(one) == 3);
	assert(mandelbrot:escape_iterations(two) == 2);
	assert(mandelbrot:escape_iterations(three) == 1);
	let limited = mandelbrot_new(1);
	assert(!limited:escapes_ball(two));
	let upper = complex(-0.75_d, 0.25_d);
	let lower = complex(-0.75_d, -0.25_d);
	assert(mandelbrot:escape_iterations(upper) == mandelbrot:escape_iterations(lower));
	let mut plot = plot_new(2, 2, 2.0_d);
	let top_left = plot:at(0, 0);
	let bottom_right = plot:at(1, 1);
	assert(top_left.real == -2.0_d && top_left.imag == 0.75_d);
	assert(bottom_right.real == 1.0_d && bottom_right.imag == -0.75_d);
	plot:zoom(0.5_d);
	assert(plot.span == 1.5_d && plot.center.real == -0.5_d);
	plot:zoom(100.0_d);
	assert(plot.span == 8.0_d);
	plot:zoom(1.0e-15_d);
	assert(plot.span == 1.0e-12_d);
	print("Mandelbrot tests passed\n");
}

fn main() -> () | Err<_> {
	test();
	print("Arrows/WASD: pan | scroll or +/-: zoom | [/]: iterations | R: reset | Esc: quit\n");
	let window = window_new(960, 720, string_from_str("Mandelbrot | arrows: pan | +/-: zoom | [/]: detail | R: reset"))?;
	let gpu = gpu_new_for_window(window)?;
	let pipeline = gpu:create_graphics_pipeline(vertex, fragment)?;
	// Solve at half the initial window resolution, then scale when presenting.
	let width = 480_ui;
	let height = 360_ui;
	let iterations = gpu:alloc::<uint>(ulong(width) * ulong(height))?;
	let image = gpu:create_image(width, height)?;
	let mut plot = plot_new(width, height, 4.0_d / 3.0_d);
	let mut solver = mandelbrot_new(256);
	let mut dirty = true;
	while (true) {
		window:wait_events(1.0_d / 60.0_d)?;
		if (window:should_close() || window:key_pressed(key_escape)) {
			break;
		};
		let size = window:framebuffer_size()?;
		if (size.0 == 0 || size.1 == 0) {
			continue;
		};
		let aspect = float64(size.0) / float64(size.1);
		if (aspect != plot.aspect) {
			plot.aspect = aspect;
			dirty = true;
		};
		let previous_limit = solver.max_iters;
		if (input(window, plot, solver)) {
			dirty = true;
		};
		if (solver.max_iters != previous_limit) {
			print(fmt("Iteration limit: {0}\n", (solver.max_iters,)));
		};
		let scroll = window:scroll_delta()?;
		if (window:focused() && scroll.1 != 0.0_d) {
			plot:zoom(
				if (scroll.1 > 0.0_d) {
					1.0_d / (1.0_d + 0.2_d * scroll.1)
				} else {
					1.0_d - 0.2_d * scroll.1
				}
			);
			dirty = true;
		};
		if (dirty) {
			solver:solve(plot, iterations);
			let pixels = HostPixels { iterations = iterations:clone(), width = width, height = height };
			let commands = gpu:start_command_recording()?;
			commands:begin_rendering(image, 0.0_f, 0.0_f, 0.0_f, 1.0_f)?;
			commands:draw(pipeline, pixels, 3)?;
			commands:end_rendering()?;
			commands:submit()?;
			dirty = false;
		};
		gpu:present(image)?;
	};
}
