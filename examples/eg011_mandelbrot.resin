// - `def` syntax is unnecessarily convoluted, just match Rust: no `=` please, or at least better errors.
// - `-1.0` is not a valid numeric literal?
// - Why do we still support `{x: T, y: T}` syntax? Can we drop this? And similarly drop anonymous struct values?
// - No tests mechanism?
// - Invalid `print()` call does not seem to generate a type error. How to format?
// - Compiler bug

export { main };

import { "$/string.resin" };

struct Complex {
	real: float32,
	imag: float32,

	def mul(self: Complex, other: Complex) -> Complex = {
		// (a + bi) (c + di)
		// = ac + adi + bci - bd
		// = (ac - bd) + i(ad + bc)
		Complex {
			real = self.real * other.real - self.imag * other.imag,
			imag = self.real * other.imag + self.imag * other.real,
		}
	};

	def squared(self: Complex) -> Complex = {
		self.mul(self)
	};

	def add(self: Complex, other: Complex) -> Complex = {
		Complex {
			real = self.real + other.real,
			imag = self.imag + other.imag,
		}
	};

	def string(self: Complex) -> String = {
		fmt("{0}+i{1}", (self.real, self.imag))
	};

	def test() = {
		var c1 = Complex { real=1.0, imag=2.0 };
		var c2 = Complex { real=42.0, imag=1.0 };
		var cp = c1.mul(c2);
		print(fmt("{0}\n", (cp.string(),)));
	};
};

def main() = {
	print("Hello, world\n");
	Complex.test();
};
