// Mandelbrot explorer. Arrows/WASD pan; scroll or +/- zoom; [/] change
// the iteration limit; R/Home resets; P saves a screenshot; Escape closes.
// Use --help for headless output and view options.
export { main, test };

import {
	"$/math.resin",
	"$/string.resin",
	"$/span.resin",
	"$/gpu.resin",
	"$/graphics.resin",
	"$/window.resin",
	"$/process.resin",
	"$/image.resin",
	"$/shared.resin",
	"$/stdio.resin",
	"mandelbrot/options.resin",
};

//
// Image coordinates and the Mandelbrot recurrence
//

struct Plot {
	width: u32,
	height: u32,
	center: Complex<f32>,
	span: f32,
}

fn plot_new(width: u32, height: u32) -> Plot {
	Plot { width = width, height = height, center = complex(-0.5, 0.0), span = 3.0 }
}

// Coordinates are in pixels; (x + 0.5, y + 0.5) is the pixel center.
// Positive imaginary coordinates point upwards.
fn at(self: Plot, x: f32, y: f32) -> Complex<f32> {
	complex(
		self.center.real + (x - 0.5 * f32(self.width)) * self.span / f32(self.height),
		self.center.imag + (0.5 * f32(self.height) - y) * self.span / f32(self.height),
	)
}

struct Mandelbrot {
	max_iters: i32,
}

fn mandelbrot_new(max_iters: i32) -> Mandelbrot {
	Mandelbrot { max_iters = max_iters }
}

// Zero means the orbit stayed inside the escape radius for this iteration budget;
// it is not a proof of membership. Escape requires a magnitude strictly above two.
fn escape_iterations(self: Mandelbrot, c: Complex<f32>) -> i32 {
	// Check the first iterate before the interior shortcut can overflow at large coordinates.
	if (self.max_iters > 0 && c:magnitude_squared() > 4.0) {
		return 1;
	};
	// The main cardioid and period-two bulb are known interiors.
	let x = c.real - 0.25;
	let y2 = c.imag * c.imag;
	let q = x * x + y2;
	if (q * (q + x) <= 0.25 * y2 || (c.real + 1.0) * (c.real + 1.0) + y2 <= 0.0625) {
		return 0;
	};
	let mut n: i32 = 0;
	let mut a: Complex<f32> = complex(0.0, 0.0);
	while (n < self.max_iters) {
		// Value operations compose the same way on host and shader.
		a = a:squared():add(c);
		n = n + 1;
		if (a:magnitude_squared() > 4.0) {
			return n;
		};
	};
	0
}

fn escapes_ball(self: Mandelbrot, c: Complex<f32>) -> bool {
	self:escape_iterations(c) != 0
}

//
// Color evaluation
//

fn palette(count: i32) -> Color {
	if (count == 0) {
		return Color { r = 0.0, g = 0.0, b = 0.0, a = 1.0 };
	};
	// Repeating blue-to-gold bands; reserve black for bounded orbits.
	let t = f32((count & 63) + 1) / 65.0;
	let u = 1.0 - t;
	Color {
		r = 9.0 * u * t * t * t,
		g = 15.0 * u * u * t * t,
		b = 8.5 * u * u * u * t,
		a = 1.0,
	}
}

const pixels_per_segment: u32 = 32;

// ANCHOR: parameters
struct Parameters<Buffer> {
	plot: Plot,
	solver: Mandelbrot,
	start_segment: u64,
	segment_count: u64,
	pixels: Buffer,
}
// ANCHOR_END: parameters

fn evaluate_pixel(root: Ref<Parameters<Span<u8>>>, x: u32, y: u32) -> Color {
	let c = root.plot:at(f32(x) + 0.5, f32(y) + 0.5);
	palette(root.solver:escape_iterations(c))
}

fn channel(value: f32) -> u8 {
	u8(value * 255.0 + 0.5)
}

fn store_pixel(pixels: Span<u8>, index: u64, color: Color) {
	pixels:at_mut(index * 4) = channel(color.r);
	pixels:at_mut(index * 4 + 1) = channel(color.g);
	pixels:at_mut(index * 4 + 2) = channel(color.b);
	pixels:at_mut(index * 4 + 3) = 255;
}

// Each segment owns up to 32 adjacent pixels in one row. Integer division and
// remainder recover its origin; the last segment stops at the right edge.
// ANCHOR: evaluate_segment
fn evaluate_segment(segment_index: u64, root: Ref<Parameters<Span<u8>>>) {
	if (segment_index >= root.segment_count) {
		return;
	};
	let columns = root.plot:segments_per_row();
	let segment = root.start_segment + segment_index;
	let first_x = u32(segment % columns) * pixels_per_segment;
	let y = u32(segment / columns);
	let mut x = first_x;
	while (x < first_x + pixels_per_segment && x < root.plot.width) {
		root.pixels:store_pixel(u64(y) * u64(root.plot.width) + u64(x), evaluate_pixel(root, x, y));
		x = x + 1;
	};
}
// ANCHOR_END: evaluate_segment

fn segments_per_row(plot: Plot) -> u64 {
	(u64(plot.width) + u64(pixels_per_segment) - 1) / u64(pixels_per_segment)
}

fn segment_count(plot: Plot) -> u64 {
	plot:segments_per_row() * u64(plot.height)
}

// CPU execution calls the same evaluator as the shader wrapper.
// ANCHOR: dispatch_host
fn dispatch_host(root: Ref<Parameters<Span<u8>>>) {
	let mut segment: u64 = 0;
	while (segment < root.segment_count) {
		evaluate_segment(segment, root);
		segment = segment + 1;
	};
}
// ANCHOR_END: dispatch_host

fn host_image(plot: Plot, solver: Mandelbrot) -> ArcSpan<u8> | Err<_> {
	let pixels = arc_span_alloc::<u8>(u64(plot.width) * u64(plot.height) * 4, 0)?;
	let root = Parameters<_> { plot = plot, solver = solver, start_segment = 0, segment_count = plot:segment_count(), pixels = pixels:get() };
	dispatch_host(root);
	pixels
}

//
// GPU execution and presentation helpers
//

// ANCHOR: compute
@compute_shader
fn compute(segment_index: u64, root: Ptr<Parameters<Span<u8>>>) {
	evaluate_segment(segment_index, root.*);
}
// ANCHOR_END: compute

@vertex_shader
fn vertex(index: i32) -> Vertex {
	let x: f32 = if (index == 1) {
		3.0
	} else {
		-1.0
	};
	let y: f32 = if (index == 2) {
		3.0
	} else {
		-1.0
	};
	Vertex {
		position = Position { x = x, y = y, z = 0.0, w = 1.0 },
		color = Color { r = (x + 1.0) * 0.5, g = (y + 1.0) * 0.5, b = 0.0, a = 1.0 },
	}
}

@fragment_shader
fn fragment(uv: Color, root: Ptr<Parameters<Span<u8>>>) -> Color {
	let x = u32(uv.r * f32(root.plot.width));
	let y = u32(uv.g * f32(root.plot.height));
	let index = (u64(y) * u64(root.plot.width) + u64(x)) * 4;
	Color {
		r = f32(root.pixels:at(index)) / 255.0,
		g = f32(root.pixels:at(index + 1)) / 255.0,
		b = f32(root.pixels:at(index + 2)) / 255.0,
		a = 1.0,
	}
}

struct Renderer {
	gpu: Gpu,
	graphics: GpuGraphicsPipeline<Parameters<Span<u8>>, GpuPipelineOwner>,
	compute: GpuComputePipeline<Parameters<Span<u8>>, GpuPipelineOwner>,
	pixels: GpuSpan<u8>,
	image: GpuImage,
}

fn renderer_new(gpu: Gpu, width: u32, height: u32) -> Renderer | Err<_> {
	let graphics = gpu:create_graphics_pipeline(vertex, fragment)?;
	let compute_pipeline = gpu:create_compute_pipeline(compute)?;
	let pixels = gpu:alloc::<u8>(u64(width) * u64(height) * 4)?;
	let image = gpu:create_image(width, height)?;
	Renderer { gpu = gpu, graphics = graphics, compute = compute_pipeline, pixels = pixels, image = image }
}

fn resize(self: RefMut<Renderer>, width: u32, height: u32) -> () | Err<_> {
	self.pixels = self.gpu:alloc::<u8>(u64(width) * u64(height) * 4)?;
	self.image = self.gpu:create_image(width, height)?;
}

fn parameters(self: Ref<Renderer>, plot: Plot, solver: Mandelbrot, start: u64, count: u64) -> Parameters<GpuSpan<u8>> {
	Parameters<_> { plot = plot, solver = solver, start_segment = start, segment_count = count, pixels = self.pixels }
}

fn dispatch_gpu(self: Ref<Renderer>, commands: Ref<GpuCommands>, plot: Plot, solver: Mandelbrot) -> () | Err<_> {
	let group_size = self.gpu:compute_workgroup_size();
	let capacity = 65535 * group_size;
	let total = plot:segment_count();
	let mut start: u64 = 0;
	while (start < total) {
		let remaining = total - start;
		let count = if (remaining < capacity) {
			remaining
		} else {
			capacity
		};
		let groups = u32((count + group_size - 1) / group_size);
		commands:dispatch(self.compute, self:parameters(plot, solver, start, count), groups, 1, 1)?;
		start = start + count;
	};
}

// ANCHOR: render
fn render(self: Ref<Renderer>, plot: Plot, solver: Mandelbrot, use_gpu: bool) -> () | Err<_> {
	if (!use_gpu) {
		let image = host_image(plot, solver)?;
		let pixels = image:get();
		self.pixels:copy_from(pixels);
	};
	let commands = self.gpu:start_command_recording()?;
	if (use_gpu) {
		self:dispatch_gpu(commands, plot, solver)?;
	};
	// Both execution modes reach the same buffer and presentation pipeline.
	commands:begin_rendering(self.image, 0.0, 0.0, 0.0, 1.0)?;
	commands:draw(self.graphics, self:parameters(plot, solver, 0, plot:segment_count()), 3)?;
	commands:end_rendering()?;
	commands:submit()?;
}
// ANCHOR_END: render

fn save_png(path: Ptr<u8>, width: u32, height: u32, pixels: Span<u8>) -> () | Err<_> {
	image_data_write_pixels(path, width, height, 4, pixels, 0)?;
	let filename = c_string(path);
	let message = fmt("Saved {0}\n", (filename:bytes(),));
	print(message);
}

// Read the displayed image in one transfer, including the currently selected view.
// ANCHOR: screenshot
fn screenshot(renderer: Ref<Renderer>, path: Ptr<u8>) -> () | Err<_> {
	let image_width = renderer.image:width();
	let image_height = renderer.image:height();
	let count = u64(image_width) * u64(image_height) * 4;
	let pixels = renderer.gpu:alloc_in::<u8>(count, memory_readback)?;
	let commands = renderer.gpu:start_command_recording()?;
	commands:copy_image_to_buffer(renderer.image, pixels)?;
	commands:submit()?;
	let host = arc_span_alloc::<u8>(count, 0)?;
	let view = host:get();
	pixels:copy_to(host:get());
	save_png(path, image_width, image_height, view)?;
}
// ANCHOR_END: screenshot

//
// Application and input
//

fn zoom(plot: RefMut<Plot>, factor: f32) {
	// Keep neighboring pixels distinguishable with f32 coordinates.
	let minimum = f32(plot.height) * 1.0e-6;
	let next = plot.span * factor;
	plot.span = if (next < minimum) {
		minimum
	} else if (next > 8.0) {
		8.0
	} else {
		next
	};
}

fn input(window: Ref<Window>, plot: RefMut<Plot>, solver: RefMut<Mandelbrot>) -> bool {
	if (!window:focused()) {
		return false;
	};
	let mut changed = false;
	let step = plot.span * 0.06;
	if (window:key_pressed(key_left) || window:key_pressed(key_a)) {
		plot.center.real = plot.center.real - step;
		changed = true;
	};
	if (window:key_pressed(key_right) || window:key_pressed(key_d)) {
		plot.center.real = plot.center.real + step;
		changed = true;
	};
	if (window:key_pressed(key_up) || window:key_pressed(key_w)) {
		plot.center.imag = plot.center.imag + step;
		changed = true;
	};
	if (window:key_pressed(key_down) || window:key_pressed(key_s)) {
		plot.center.imag = plot.center.imag - step;
		changed = true;
	};
	if (window:key_pressed(key_equal)) {
		plot:zoom(0.85);
		changed = true;
	};
	if (window:key_pressed(key_minus)) {
		plot:zoom(1.0 / 0.85);
		changed = true;
	};
	if (window:key_state(key_right_bracket).pressed && solver.max_iters < 4096) {
		let next = solver.max_iters * 2;
		solver.max_iters = if (next > 4096) {
			4096
		} else {
			next
		};
		changed = true;
	};
	if (window:key_state(key_left_bracket).pressed && solver.max_iters > 32) {
		let next = solver.max_iters / 2;
		solver.max_iters = if (next < 32) {
			32
		} else {
			next
		};
		changed = true;
	};
	if (window:key_state(key_r).pressed || window:key_state(key_home).pressed) {
		plot.center.real = -0.5;
		plot.center.imag = 0.0;
		plot.span = 3.0;
		solver.max_iters = 256;
		changed = true;
	};
	changed
}

fn headless(options: Ref<Options>, plot: Plot, solver: Mandelbrot, path: Ptr<u8>) -> () | Err<_> {
	if (options.use_gpu) {
		let renderer = renderer_new(gpu_new()?, plot.width, plot.height)?;
		renderer:render(plot, solver, true)?;
		renderer:screenshot(path)?;
	} else {
		let image = host_image(plot, solver)?;
		let pixels = image:get();
		save_png(path, plot.width, plot.height, pixels)?;
	};
}

fn interactive(options: Ref<Options>, mut plot: Plot, mut solver: Mandelbrot) -> () | Err<_> {
	print("Arrows/WASD: pan | scroll/+/-: zoom | [/]: iterations | R: reset | P: screenshot | Esc: quit\n");
	let title = string_from_str("Mandelbrot | arrows: pan | +/-: zoom | [/]: detail | P: screenshot");
	let window = window_new(plot.width, plot.height, title)?;
	let mut renderer = renderer_new(gpu_new_for_window(window)?, plot.width, plot.height)?;
	let mut dirty = true;
	while (true) {
		// Pace held keys even when presentation does not wait for a refresh.
		window:wait_events(1.0 / 60.0)?;
		if (window:should_close() || window:key_state(key_escape).pressed) {
			break;
		};
		let size = window:framebuffer_size()?;
		if (size.0 == 0 || size.1 == 0) {
			continue;
		};
		if (size.0 != plot.width || size.1 != plot.height) {
			plot.width = size.0;
			plot.height = size.1;
			plot:zoom(1.0);
			renderer:resize(size.0, size.1)?;
			dirty = true;
		};
		let previous_limit = solver.max_iters;
		if (input(window, plot, solver)) {
			dirty = true;
		};
		if (solver.max_iters != previous_limit) {
			let message = fmt("Iteration limit: {0}\n", (solver.max_iters,));
			print(message);
		};
		let scroll = window:scroll_delta()?;
		if (window:focused() && scroll.1 != 0.0) {
			plot:zoom(
				if (scroll.1 > 0.0) {
					1.0 / (1.0 + 0.2 * f32(scroll.1))
				} else {
					1.0 - 0.2 * f32(scroll.1)
				}
			);
			dirty = true;
		};
		let capture = window:focused() && window:key_state(key_p).pressed;
		if (dirty) {
			renderer:render(plot, solver, options.use_gpu)?;
			dirty = false;
		};
		if (capture) {
			renderer:screenshot(options.screenshot)?;
		};
		renderer.gpu:present(renderer.image)?;
	};
}

// ANCHOR: main
fn main(argc: i32, argv: Ptr<Ptr<u8>>, envp: Ptr<Ptr<u8>>) -> i32 | Err<_> {
	let args = arguments(argc, argv);
	let options = match (parse_options(args)) {
		Options(options) => {
			options
		},
		Err(message) => {
			let text = fmt("{0}\nUse --help for usage.\n", (message,));
			let stderr = io_stderr();
			stderr:write(text)?;
			return 2;
		},
	};
	if (options.help) {
		print_help();
		return 0;
	};
	let mut plot = plot_new(options.width, options.height);
	plot.center.real = options.real;
	plot.center.imag = options.imag;
	plot.span = options.span;
	let solver = mandelbrot_new(options.iterations);
	match (options.output) {
		Ptr<u8>(path) => {
			headless(options, plot, solver, path)?;
		},
		None => {
			interactive(options, plot, solver)?;
		},
	};
	0
}
// ANCHOR_END: main

//
// CPU checks of the shared algorithm
//

fn test() -> () | Err<_> {
	let mandelbrot = mandelbrot_new(128);
	let zero: Complex<f32> = complex(0.0, 0.0);
	let minus_one: Complex<f32> = complex(-1.0, 0.0);
	let minus_two: Complex<f32> = complex(-2.0, 0.0);
	let i: Complex<f32> = complex(0.0, 1.0);
	let one: Complex<f32> = complex(1.0, 0.0);
	let two: Complex<f32> = complex(2.0, 0.0);
	let three: Complex<f32> = complex(3.0, 0.0);
	assert(!mandelbrot:escapes_ball(zero));
	assert(!mandelbrot:escapes_ball(minus_one));
	assert(!mandelbrot:escapes_ball(minus_two));
	assert(!mandelbrot:escapes_ball(i));
	assert(mandelbrot:escape_iterations(one) == 3);
	assert(mandelbrot:escape_iterations(two) == 2);
	assert(mandelbrot:escape_iterations(three) == 1);
	assert(mandelbrot:escape_iterations(complex(1.0e30, 1.0e30)) == 1);
	assert(!mandelbrot_new(1):escapes_ball(complex(2.0, 0.0)));
	let upper: Complex<f32> = complex(-0.75, 0.25);
	let lower: Complex<f32> = complex(-0.75, -0.25);
	assert(mandelbrot:escape_iterations(upper) == mandelbrot:escape_iterations(lower));
	let mut plot = plot_new(4, 2);
	let top_left = plot:at(0.5, 0.5);
	let bottom_right = plot:at(3.5, 1.5);
	assert(top_left.real == -2.75 && top_left.imag == 0.75);
	assert(bottom_right.real == 1.75 && bottom_right.imag == -0.75);
	plot:zoom(0.5);
	assert(plot.span == 1.5 && plot.center.real == -0.5);
	plot:zoom(100.0);
	assert(plot.span == 8.0);
	plot:zoom(1.0e-15);
	assert(plot.span == 2.0e-6);
	// The pixel center is c = 2, which escapes after two iterations.
	let mut edge = plot_new(1, 1);
	edge.center.real = 2.0;
	edge.span = 2.0;
	let pixels = arc_ptr_alloc([0, 0, 0, 0, 123])?;
	let root = Parameters<_> { plot = edge, solver = mandelbrot_new(32), start_segment = 0, segment_count = 1, pixels = Span<u8> { data = pixels:get():lea(0), length = 4 } };
	dispatch_host(root);
	evaluate_segment(1, root);
	let color = palette(2);
	assert(pixels:get():at(0) == channel(color.r));
	assert(pixels:get():at(1) == channel(color.g));
	assert(pixels:get():at(2) == channel(color.b));
	assert(pixels:get():at(3) == 255 && pixels:get():at(4) == 123);
	print("Mandelbrot tests passed\n");
}
