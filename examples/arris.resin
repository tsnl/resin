// Render a glTF scene with Arris
//
// Primary visibility is rasterized, including glTF MASK alpha discard and depth.
// A ray tracing pipeline samples indirect diffuse/glossy light and an HDR
// environment. SVGF uses world positions and normals to denoise successive frames.
// This program owns the buffers, pipelines, path integrator, and frame schedule.
// The library supplies independent scene, visibility, sampling, and display pieces.
// Change the integrator below to add lights or a different transport estimator;
// change the frame loop to insert a pass, skip SVGF, or consume HDR data on the GPU.
//
// Start the Resin compiler service and set RESIN_SERVER, then run from the repo:
//   cargo run -- examples/arris.resin
// Or provide a static glTF/GLB and an equirectangular OpenEXR environment:
//   cargo run -- examples/arris.resin -- scene.glb environment.exr
// The environment suffix selects .hdr (Radiance) or .exr (OpenEXR).
// Writes arris.png (tone mapped) and arris.exr (linear HDR), without opening a window.
// Needs Vulkan ray tracing pipelines. It never uses ray queries.
export { main };
import { "$/renderer.resin", "$/svgf.resin", "$/math.resin", "$/shared.resin", "$/gltf.resin", "$/image.resin", "$/gpu.resin", "$/linalg.resin", "$/span.resin", "$/string.resin", "$/stdio.resin", "$/status.resin", "$/process.resin" };
fn main(argc: i32, argv: Ptr<Ptr<u8>>, envp: Ptr<Ptr<u8>>) -> () | Err<_> {
	if (argc != 1 && argc != 3) {
		print("Usage: arris [scene.gltf|scene.glb environment.hdr|environment.exr]\n");
		return Err(InvalidArgument {});
	};
	let args = Span<Ptr<u8>> { data = argv, length = u64(argc) };
	let scene_path = if (argc > 1) {
		args:argument(1)
	} else {
		bytes("examples/assets/arris/scene.gltf")
	};
	let env_path = if (argc > 2) {
		args:argument(2)
	} else {
		bytes("examples/assets/arris/studio.hdr")
	};
	let gpu = gpu_new()?;
	if (!gpu:supports_ray_tracing()) {
		print("Arris requires a GPU with ray tracing pipeline support.\n");
		return Err(Unsupported {});
	};
	let asset = gltf_load(scene_path)?;
	let hdr = has_suffix(env_path, ".hdr");
	let lighting = if (hdr) {
		image_data_read_hdr(env_path)?
	} else {
		image_data_read_exr(env_path)?
	};
	// Uploading material/vertex tables is useful to raster-only applications too.
	// Build the separate static RT geometry only because this program traces rays.
	let scene = upload_scene(gpu, asset)?;
	let mesh = asset:vertices();
	let acceleration = scene_acceleration(gpu, mesh)?;
	let sky = environment(gpu, lighting)?;

	// Allocate every attachment and output here. A pass receives only the buffers
	// it needs, so another shader can produce or consume any of these GPU spans.
	let width: u32 = 640;
	let height: u32 = 480;
	let count = u64(width) * u64(height);
	let visibility_image = gpu:create_image(width, height, image_rgba32f)?;
	let depth_image = gpu:create_image(width, height, image_depth32)?;
	let visibility = gpu:alloc::<Vec4>(count)?;
	let radiance = gpu:alloc::<Vec4>(count)?;
	let positions = gpu:alloc::<Vec4>(count)?;
	let normals = gpu:alloc::<Vec4>(count)?;
	let pixels = gpu:alloc::<u8>(count * 4)?;

	// Each pipeline is independently reusable. The RT entries below belong to
	// this example; the library supplies the common hit payload and traversal.
	let config = gpu:graphics_config(image_rgba32f, true);
	let raster = config:create_graphics_pipeline(primary_vertex, primary_fragment)?;
	let tracing = acceleration:create_ray_tracing_pipeline(generation, miss, closest)?;
	let tone_mapping = gpu:create_compute_pipeline(tone_map)?;
	let mut denoiser = svgf_create(gpu, width, height)?;
	// Later passes read these outputs through views that cannot write them.
	let linear_input = radiance:read_only();
	let position_input = positions:read_only();
	let normal_input = normals:read_only();
	let pixel_output = pixels:read_only();
	let groups = u32((count + gpu:compute_workgroup_size() - 1) / gpu:compute_workgroup_size());

	// The camera looks down local -Z. Change this pose to frame your own scene.
	// Projection requires positive focal/sensor lengths and 0 < near < far.
	let view = camera(look_at(vec3(3, 2.2, 4.5), vec3(0, 0.65, 0), vec3(0, 1, 0)), f32(width) / f32(height));
	let view_projection = mul(perspective(view.focal_length, view.sensor_size, view.near, view.far), inverse_rigid(view.transform));
	let eye = vec3(view.transform.r0.w, view.transform.r1.w, view.transform.r2.w);
	let raster_root = RasterRoot<DeviceScene> { scene = scene, view_projection = view_projection, eye = eye };
	let mut trace_root = TraceRoot<DeviceScene, DeviceEnvironment, GpuSpan<Vec4>, GpuSpanMut<Vec4>> { scene = scene, environment = sky, visibility = visibility:read_only(), radiance = radiance:clone(), positions = positions:clone(), normals = normals:clone(), camera = view, width = width, height = height, frame = 0, samples_per_frame = 2, max_bounces = 4 };

	// A frame is ordinary command recording. The depth-tested raster pass stores
	// triangle IDs and barycentrics. MASK holes return None and preserve depth.
	// Copy visibility to a shader-readable span, then trace secondary lighting.
	// submit waits for completion; it is the synchronization boundary for SVGF.
	let mut frame: u32 = 0;
	while (frame < 16) {
		trace_root.frame = frame;
		let commands = gpu:start_command_recording()?;
		commands:begin_rendering(visibility_image, depth_image, 0, 0, 0, 0)?;
		commands:draw(raster, raster_root, u32(scene.vertices.length))?;
		commands:end_rendering()?;
		commands:copy_image_to_buffer(visibility_image, visibility)?;
		commands:trace_rays(tracing, trace_root, width, height, 1)?;
		commands:submit()?;

		// Denoising is a separate choice. To inspect raw samples, replace this
		// call with linear_input:clone(). Call denoiser:reset() after a camera cut or
		// lighting edit; ordinary camera motion is reprojected using this matrix.
		let filtered = denoiser:filter(linear_input, position_input, normal_input, view_projection)?;
		let tone_root = ToneRoot<GpuSpan<Vec4>, GpuSpanMut<u8>> { input = filtered:clone(), pixels = pixels:clone(), count = count, exposure = 1, gamma = 2.2 };
		let display = gpu:start_command_recording()?;
		display:dispatch(tone_mapping, tone_root, groups, 1, 1)?;
		display:submit()?;
		if (frame == 15) {
			save_images(width, height, pixel_output, filtered)?;
		};
		frame = frame + 1;
		let message = fmt("rendered frame {0} / 16\n", (frame,));
		print(message);
	};
	// These buffers are reused each frame. Cloning a GpuSpan retains allocation
	// lifetime, not a snapshot. Read back only when CPU output is actually needed.
	print("wrote arris.png and arris.exr\n");
}

// The program chooses its shader interface. Generic buffer fields let the host
// pass retained GPU allocations while shader compilation uses ordinary spans.
struct TraceRoot<S, E, V, O> {
	scene: S,
	environment: E,
	visibility: V,
	radiance: O,
	positions: O,
	normals: O,
	camera: Camera,
	width: u32,
	height: u32,
	frame: u32,
	samples_per_frame: u32,
	max_bounces: u32,
}
type ShaderTrace = TraceRoot<ShaderScene, ShaderEnvironment, Span<Vec4>, SpanMut<Vec4>>;

// Pipeline stages share a Hit payload. These tiny adapters bind the reusable
// helpers to our own shader root; they can serve any ray-generation algorithm.
@miss_shader
fn miss(initial: Hit, root: Ptr<ShaderTrace>) -> Hit {
	miss_hit()
}
@closest_hit_shader
fn closest(initial: Hit, root: Ptr<ShaderTrace>) -> Hit {
	closest_hit()
}

// This is the integrator, intentionally in the example: sample counts, bounce
// termination, direct lighting, and throughput are application decisions.
fn integrate(root: Ptr<ShaderTrace>, first: Surface, state: RefMut<u32>) -> Vec3 {
	let eye = vec3(root.camera.transform.r0.w, root.camera.transform.r1.w, root.camera.transform.r2.w);
	let mut outgoing = normalized(sub(eye, first.position));
	let mut surface = orient_surface(first, outgoing);
	let mut throughput = vec3(1, 1, 1);
	let mut radiance = surface.emission;
	let mut bounce: u32 = 0;
	while (bounce < root.max_bounces) {
		// Next-event estimation: choose an environment direction, trace its
		// shadow ray, and weight it against the BSDF's competing PDF (MIS).
		let light = environment_sample(root.environment, random(state), random(state), random(state));
		let value = bsdf_value(surface, outgoing, light.direction);
		if (light.pdf > 0 && luminance(value) > 0) {
			let shadow = trace_surface(root.scene, offset_ray_origin(surface), light.direction, 0.0001, f32(1000000000000000000000000000000), state);
			if (shadow.triangle == ~u32(0)) {
				let weight = power_heuristic(light.pdf, bsdf_pdf(surface, outgoing, light.direction));
				let contribution = mul(mul(value, environment_value(root.environment, light.direction)), max(0, dot(surface.normal, light.direction)) * weight / light.pdf);
				radiance = add(radiance, mul(throughput, contribution));
			};
		};
		// Continue the path with a cosine/GGX sample. Its weight already contains
		// BSDF * cosine / PDF. Escapes see the environment with the other MIS weight.
		let sample = bsdf_sample(surface, outgoing, random(state), random(state), random(state));
		throughput = mul(throughput, sample.weight);
		if (luminance(throughput) <= 0 || sample.pdf <= 0) {
			break;
		};
		let hit = trace_surface(root.scene, offset_ray_origin(surface), sample.direction, 0.0001, f32(1000000000000000000000000000000), state);
		if (hit.triangle == ~u32(0)) {
			let weight = power_heuristic(sample.pdf, environment_pdf(root.environment, sample.direction));
			radiance = add(radiance, mul(mul(throughput, environment_value(root.environment, sample.direction)), weight));
			break;
		};
		outgoing = mul(sample.direction, -1);
		surface = orient_surface(surface_at(root.scene, hit.triangle, hit.u, hit.v), outgoing);
		radiance = add(radiance, mul(throughput, surface.emission));
		bounce = bounce + 1;
		// Russian roulette bounds expected work without biasing surviving paths.
		if (bounce >= 3) {
			let survival = clamp(max(throughput.x, max(throughput.y, throughput.z)), 0.05, 0.95);
			if (random(state) >= survival) {
				break;
			};
			throughput = mul(throughput, 1 / survival);
		};
	};
	radiance
}
// Reconstruct a primary surface from raster visibility, then average independent
// secondary paths. Background pixels evaluate the environment without tracing.
// Guides use world XYZ / triangle+1 and unit normal XYZ / valid flag for SVGF.
// This example requires samples_per_frame > 0 and max_bounces > 0.
@ray_generation_shader
fn generation(index: u64, root: Ptr<ShaderTrace>) {
	if (index >= u64(root.width) * u64(root.height)) {
		return;
	};
	let visibility = root.visibility:at(index);
	let mut sum = vec3(0, 0, 0);
	if (visibility.x >= 0.5) {
		let triangle = u32(visibility.x) - 1;
		let surface = surface_at(root.scene, triangle, visibility.y, visibility.z);
		root.positions:at_mut(index) = vec4(surface.position.x, surface.position.y, surface.position.z, f32(triangle) + 1);
		let n = surface.normal;
		root.normals:at_mut(index) = vec4(n.x, n.y, n.z, 1);
		let mut state = u32(index) * 9781 + root.frame * 6271 + 17;
		let mut sample: u32 = 0;
		while (sample < root.samples_per_frame) {
			sum = add(sum, integrate(root, surface, state));
			sample = sample + 1;
		};
		sum = mul(sum, 1 / f32(root.samples_per_frame));
	} else {
		sum = environment_value(root.environment, camera_ray(root.camera, u32(index % u64(root.width)), u32(index / u64(root.width)), root.width, root.height));
		root.positions:at_mut(index) = vec4(0, 0, 0, 0);
		root.normals:at_mut(index) = vec4(0, 0, 0, 0);
	};
	root.radiance:at_mut(index) = vec4(sum.x, sum.y, sum.z, 1);
}
// Readback belongs at the edge of the application. Tone-mapped RGBA8 goes to PNG;
// linear radiance goes to EXR. SVGF stores variance in W, so replace it with alpha.
fn save_images(width: u32, height: u32, pixels: Ref<GpuSpan<u8>>, radiance: Ref<GpuSpan<Vec4>>) -> () | Err<_> {
	let count = u64(width) * u64(height);
	let host_pixels = arc_span_alloc(count * 4, u8(0))?;
	pixels:copy_to(host_pixels:get());
	let rgba = host_pixels:get();
	image_data_write_pixels(bytes("arris.png"), width, height, 4, rgba:read_only(), 0)?;
	let host = arc_span_alloc(count, vec4(0, 0, 0, 1))?;
	radiance:copy_to(host:get());
	let data = host:get();
	let mut i: u64 = 0;
	while (i < count) {
		data:at_mut(i).w = 1;
		i = i + 1;
	};
	let floats = Span<f32> { data = Ptr<f32>(data.data), length = count * 4 };
	image_data_write_exr_pixels(bytes("arris.exr"), width, height, floats)
}

// Paths are bounded byte spans, including those borrowed from process arguments.
// Select a decoder without copying the filename.
fn has_suffix(text: Ref<Span<u8>>, suffix: str) -> bool {
	if (text.length < suffix.length) {
		return false;
	};
	let mut index: u64 = 0;
	while (index < suffix.length) {
		if (text:at(text.length - suffix.length + index) != suffix:at(index)) {
			return false;
		};
		index = index + 1;
	};
	true
}
