export { kernel };
import { "$/span.resin" };

struct Input { kind: uint, value: float32, wide: ulong, }
struct Output { progress: uint, value: ulong, }
struct Root { count: ulong, inputs: Ptr<Input>, outputs: Ptr<Output>, }

fn convert(input: Ref<Input>) -> ulong  {
	if (input.kind == 0_ui) {
		ulong(ubyte(input.value))
	} else {
		if (input.kind == 1_ui) {
			ulong(uint(input.value))
		} else {
			if (input.kind == 2_ui) {
				let mut value = int(input.value);
				if (value < 0_i) {
					0_ul - ulong(-(value + 1_i)) - 1_ul
				} else {
					ulong(value)
				}
			} else {
				if (input.kind == 3_ui) {
					ulong(input.value)
				} else {
					if (input.kind == 4_ui) {
						ulong(ubyte(input.wide))
					} else {
						if (input.kind == 5_ui) {
							ulong(uint(input.wide))
						} else {
							ulong(int(input.wide))
						}
					}
				}
			}
		}
	}
}

fn ready(input: Ref<Input>, progress: Ptr<uint>) -> bool  {
	progress.* = 2_ui;
	convert(input);
	progress.* = 3_ui;
	1_ui == 1_ui
}

fn in_loop(input: Ref<Input>, progress: Ptr<uint>) -> ulong  {
	let mut step = 0_ui;
	let mut result = 0_ul;
	while (step < 1_ui && ready(input, progress)) {
		result = convert(input);
		step = step + 1_ui;
	};
	result
}

@compute_shader
fn kernel(index: ulong, root: Ptr<Root>)  {
	if (index < root.count) {
		let mut inputs = Span<Input> { data = root.inputs, length = root.count };
		let mut outputs = Span<Output> { data = root.outputs, length = root.count };
		let mut output: Ref<Output> = fixture_index(outputs.data, outputs.length, index).*;
		output.progress = 1_ui;
		let mut value = in_loop(fixture_index(inputs.data, inputs.length, index).*, &output.progress);
		output.value = value;
		output.progress = 4_ui;
	};
}

intrinsic "pointer_index" fn fixture_index<T>(data: Ptr<T>, length: ulong, index: ulong) -> Ptr<T>;
