export { kernel };
import { "$/span.resin" };

struct Input {
	kind: u32,
	value: f32,
	wide: u64,
}
struct Output {
	progress: u32,
	value: u64,
}
struct Root {
	count: u64,
	inputs: Ptr<Input>,
	outputs: Ptr<Output>,
}

fn convert(input: Ref<Input>) -> u64 {
	if (input.kind == u32(0)) {
		u64(u8(input.value))
	} else {
		if (input.kind == u32(1)) {
			u64(u32(input.value))
		} else {
			if (input.kind == u32(2)) {
				let mut value = i32(input.value);
				if (value < i32(0)) {
					u64(0) - u64(-(value + i32(1))) - u64(1)
				} else {
					u64(value)
				}
			} else {
				if (input.kind == u32(3)) {
					u64(input.value)
				} else {
					if (input.kind == u32(4)) {
						u64(u8(input.wide))
					} else {
						if (input.kind == u32(5)) {
							u64(u32(input.wide))
						} else {
							u64(i32(input.wide))
						}
					}
				}
			}
		}
	}
}

fn ready(input: Ref<Input>, progress: Ptr<u32>) -> bool {
	progress.* = u32(2);
	convert(input);
	progress.* = u32(3);
	u32(1) == u32(1)
}

fn in_loop(input: Ref<Input>, progress: Ptr<u32>) -> u64 {
	let mut step: u32 = 0;
	let mut result: u64 = 0;
	while (step < u32(1) && ready(input, progress)) {
		result = convert(input);
		step = step + u32(1);
	};
	result
}

@compute_shader
fn kernel(index: u64, root: Ptr<Root>) {
	if (index < root.count) {
		let mut inputs = Span<Input> { data = root.inputs, length = root.count };
		let mut outputs = Span<Output> { data = root.outputs, length = root.count };
		let output = outputs:lea(index);
		output.progress = u32(1);
		let mut value = in_loop(fixture_index(inputs.data, inputs.length, index).*, &output.progress);
		output.value = value;
		output.progress = u32(4);
	};
}

intrinsic "pointer_index" fn fixture_index<T>(data: Ptr<T>, length: u64, index: u64) -> Ptr<T>;
