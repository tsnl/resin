export { kernel };
import { "$/span.resin" };

struct Bytes3 { a: ubyte, b: ubyte, c: ubyte, }
struct Rows { first: Bytes3, second: Bytes3, }
struct Sample { lead: ubyte, rows: Rows, marker: uint, wide: ulong, tail: ubyte, }
struct Root { count: ulong, inputs: Ptr<Sample>, outputs: Ptr<Sample>, }

fn update(output: Ptr<Sample>, index: ulong)  {
	let mut row = if ((index & 1_ul) == 0_ul) {
		&output.rows.first
	} else {
		&output.rows.second
	};
	row.b = row.b + 1_ub;
	let mut previous = output.*;
	output.* = Sample {
		lead = previous.lead,
		rows = previous.rows,
		marker = previous.marker + 1_ui,
		wide = previous.wide + 4294967297_ul,
		tail = previous.tail,
	};
}

@compute_shader
fn kernel(index: ulong, root: Ptr<Root>)  {
	if (index < root.count) {
		let mut inputs = Span<Sample> { data = root.inputs, length = root.count };
		let mut outputs = Span<Sample> { data = root.outputs, length = root.count };
		let mut output: Ref<_> = outputs:at(index);
		output = inputs:at(index);
		update(&output, index);
	};
}
