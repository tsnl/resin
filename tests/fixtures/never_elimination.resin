export { kernel, main };
def infallible(n: uint, p: Ptr<uint>) -> (uint | Err<Never>) = {
    var r: (uint | Err<Never>); r := (n);
    var saved = r?;
    p.* := p.* + 1_ui;
    (saved)
};
def unwrap(r: (uint | Err<Never>)) -> uint = {
    match (r) { uint(n) => { n }, Err(impossible) => { absurd(impossible) } }
};
@compute_shader def kernel(i: ulong, p: Ptr<uint>) = {
    if (i == 0_ul) {
        var n = unwrap(infallible(41_ui, p));
        p.* := p.* + n;
    };
};
def main() -> int = { var result = 0_ui; kernel(0_ul, &result); if (result == 42_ui) { 0 } else { 1 } };
