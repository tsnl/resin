export { kernel, main };
import { "$/shared.resin" };

fn infallible(n: u32, p: PtrMut<u32>) -> (u32 | Err<Never>) {
	let mut r: (u32 | Err<Never>);
	r = (n);
	let mut saved = r?;
	p.* = p.* + u32(1);
	(saved)
}
fn unwrap(r: (u32 | Err<Never>)) -> u32 {
	match (r) {
		u32(n) => {
			n
		},
		Err(impossible) => {
			absurd(impossible)
		}
	}
}
@compute_shader
fn kernel(i: u64, p: PtrMut<u32>) {
	if (i == u64(0)) {
		let mut n = unwrap(infallible(u32(41), p));
		p.* = p.* + n;
	};
}
fn main() -> i32 | Err<_> {
	let result_owner = arc_ptr_alloc(u32(0))?;
	let result: Ref<_> = result_owner:get().*;
	kernel(u64(0), result_owner:get());
	if (result == u32(42)) {
		0
	} else {
		1
	}
}
