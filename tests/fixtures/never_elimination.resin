export { kernel, main };
def infallible(n: uint, p: Ptr<uint>) -> Result<uint, Never> = {
    var r: Result<uint, Never>; r := ok(n);
    var saved = r?;
    p.* := p.* + 1_ui;
    ok(saved)
};
def unwrap(r: Result<uint, Never>) -> uint = {
    match (r) { ok(n) => { n }, err(impossible) => { absurd(impossible) } }
};
def kernel(i: uint, p: Ptr<uint>) = {
    if (i == 0_ui) {
        var n = unwrap(infallible(41_ui, p));
        p.* := p.* + n;
    };
};
def main() -> int = { var result = 0_ui; kernel(0_ui, &result); if (result == 42_ui) { 0 } else { 1 } };
