export { kernel, main };
struct State { counter: uint, result: uint };
struct Failed {};
def work(p: Ptr<State>, fail: bool) -> Result<uint, Failed> = {
    defer p.counter := p.counter * 10I + 1I;
    var result = {
        defer p.counter := p.counter * 10I + 2I;
        var saved: uint;
        if (fail) { saved := 7I; } else { saved := 9I; };
        defer p.counter := p.counter * 10I + saved;
        {
            var saved = 4I;
            var r: Result<(), Failed>; r := if (fail) { err(Failed {}) } else { ok(()) };
            r?;
        };
        saved
    };
    ok(result)
};
def kernel(i: uint, p: Ptr<State>) = {
    if (i == 0I) {
        var failed = match (work(p, 1 == 1)) { ok(n) => { 1 == 2 }, err(e) => { p.counter == 721I } };
        p.counter := 0I;
        var succeeded = match (work(p, 1 == 2)) { ok(n) => { n == 9I && p.counter == 921I }, err(e) => { 1 == 2 } };
        p.result := if (failed && succeeded) { 42I } else { 99I };
    };
};
def main() -> int = { var state = State { counter = 0I, result = 0I }; kernel(0I, &state); if (state.result == 42I) { 0 } else { 1 } };
