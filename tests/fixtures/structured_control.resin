export { kernel, main };
import { "$/shared.resin", "$/span.resin" };
struct Root {
	count: uint,
	pixels: Ptr<uint>,
}
struct Stop {
	code: uint,
}
struct First {}
struct Second {}
struct Third {}

fn checked(stop: bool, code: uint) -> (bool | Err<Stop>) {
	if (stop) {
		Err(Stop { code = code })
	} else {
		(1_ui == 1_ui)
	}
}
fn tag(index: uint) -> First | Second | Third {
	if (index == 0_ui) {
		First {}
	} else {
		if (index == 1_ui) {
			Second {}
		} else {
			Third {}
		}
	}
}
fn evaluate(index: uint) -> (uint | Err<Stop>) {
	let mut limit = if (index == 0_ui) {
		0_ui
	} else {
		3_ui
	};
	let mut outer = 0_ui;
	let mut total = 0_ui;
	while (outer < limit && checked(index == 1_ui && outer == 1_ui, 11_ui)?) {
		total = total + {
			let mut sum = 0_ui;
			let mut inner = 0_ui;
			while (inner <= outer) {
				checked(index == 2_ui && outer == 1_ui && inner == 0_ui, 22_ui)?;
				sum = sum + match (tag(inner)) {
					First(first) => {
						1_ui
					},
					Second(second) => {
						2_ui
					},
					Third(third) => {
						3_ui
					}
				};
				inner = inner + 1_ui;
			};
			sum
		};
		outer = outer + 1_ui;
	};
	(total + index)
}
@compute_shader
fn kernel(invocation: ulong, root: Ptr<Root>) {
	let mut index = uint(invocation);
	if (index < root.count) {
		let mut output = Span<uint> { data = root.pixels, length = ulong(root.count) };
		fixture_index(output.data, output.length, invocation).* = match (evaluate(index)) {
			uint(value) => {
				value
			},
			Err(error) => {
				error.code
			}
		};
	};
}
fn main() -> int | Err<_> {
	let values_owner = arc_ptr_alloc([0_ui, 0_ui, 0_ui, 0_ui])?;
	let values: Ref<_> = values_owner:get().*;
	let root_owner = arc_ptr_alloc(Root { count = 4_ui, pixels = values_owner:get():lea(0_ul) })?;
	let root: Ref<_> = root_owner:get().*;
	let mut index = 0_ul;
	while (index < 4_ul) {
		kernel(index, root_owner:get());
		index = index + 1_ul;
	};
	if (values:at(0_ul) == 0_ui && values:at(1_ul) == 11_ui && values:at(2_ul) == 22_ui && values:at(3_ul) == 13_ui) {
		0
	} else {
		1
	}
}

intrinsic "pointer_index" fn fixture_index<T>(data: Ptr<T>, length: ulong, index: ulong) -> Ptr<T>;
