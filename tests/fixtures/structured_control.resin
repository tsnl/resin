export { kernel, main };
import { "$/shared.resin", "$/span.resin" };
struct Root {
	count: u32,
	pixels: PtrMut<u32>,
}
struct Stop {
	code: u32,
}
struct First {}
struct Second {}
struct Third {}

fn checked(stop: bool, code: u32) -> (bool | Err<Stop>) {
	if (stop) {
		Err(Stop { code = code })
	} else {
		(u32(1) == u32(1))
	}
}
fn tag(index: u32) -> First | Second | Third {
	if (index == u32(0)) {
		First {}
	} else {
		if (index == u32(1)) {
			Second {}
		} else {
			Third {}
		}
	}
}
fn evaluate(index: u32) -> (u32 | Err<Stop>) {
	let mut limit = if (index == u32(0)) {
		u32(0)
	} else {
		u32(3)
	};
	let mut outer: u32 = 0;
	let mut total: u32 = 0;
	while (outer < limit && checked(index == u32(1) && outer == u32(1), u32(11))?) {
		total = total + {
			let mut sum: u32 = 0;
			let mut inner: u32 = 0;
			while (inner <= outer) {
				checked(index == u32(2) && outer == u32(1) && inner == u32(0), u32(22))?;
				sum = sum + match (tag(inner)) {
					First(first) => {
						u32(1)
					},
					Second(second) => {
						u32(2)
					},
					Third(third) => {
						u32(3)
					}
				};
				inner = inner + u32(1);
			};
			sum
		};
		outer = outer + u32(1);
	};
	(total + index)
}
@compute_shader
fn kernel(invocation: u64, root: PtrMut<Root>) {
	let mut index = u32(invocation);
	if (index < root.count) {
		let mut output = SpanMut<u32> { data = root.pixels, length = u64(root.count) };
		fixture_index(output.data, output.length, invocation).* = match (evaluate(index)) {
			u32(value) => {
				value
			},
			Err(error) => {
				error.code
			}
		};
	};
}
fn main() -> i32 | Err<_> {
	let values_owner = arc_ptr_alloc([u32(0), u32(0), u32(0), u32(0)])?;
	let values: Ref<_> = values_owner:get().*;
	let root_owner = arc_ptr_alloc(Root { count = u32(4), pixels = values_owner:get():lea(u64(0)) })?;
	let root: Ref<_> = root_owner:get().*;
	let mut index: u64 = 0;
	while (index < u64(4)) {
		kernel(index, root_owner:get());
		index = index + u64(1);
	};
	if (values:at(u64(0)) == u32(0) && values:at(u64(1)) == u32(11) && values:at(u64(2)) == u32(22) && values:at(u64(3)) == u32(13)) {
		0
	} else {
		1
	}
}

intrinsic "pointer_index_mut" fn fixture_index<T>(data: PtrMut<T>, length: u64, index: u64) -> PtrMut<T>;
