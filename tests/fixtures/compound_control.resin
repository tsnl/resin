export { kernel, main };
import { "$/shared.resin" };

struct State {
	counter: uint,
	result: uint,
}
struct Pair {
	a: uint,
	b: uint,
}
fn touch(p: Ptr<State>) -> uint {
	let mut old = p.counter;
	p.counter = old + 1_ui;
	old
}
fn choose(p: Ptr<State>) -> Ptr<uint> {
	touch(p);
	&p.result
}
fn identity(n: uint) -> uint {
	n
}
@compute_shader
fn kernel(i: ulong, root: Ptr<State>) {
	if (i == 0_ul) {
		let mut x = 0_ui;
		x = if (i == 0_ul) {
			7_ui
		} else {
			8_ui
		};
		let mut flag = 1_i == 2;
		flag = i == 0_ul && touch(root) == 0_ui;
		let mut values = [0_ui, 0_ui];
		values(touch(root) - 1_ui) = if (flag) {
			touch(root) + 9_ui
		} else {
			12_ui
		};
		let mut pair = Pair {
			b = if (flag) {
				touch(root)
			} else {
				99_ui
			},
			a = touch(root)
		};
		choose(root).* = identity(
			if (flag) {
				touch(root) + 14_ui
			} else {
				99_ui
			}
		);
		root.result = if (x == 7_ui && flag && values(0_ul) == 11_ui && pair.a == 4_ui && pair.b == 3_ui && root.counter == 7_ui && root.result == 20_ui) {
			42_ui
		} else {
			99_ui
		};
	};
}
fn main() -> int | Err<_> {
	let root_owner = arc_ptr_alloc(State { counter = 0_ui, result = 0_ui })?;
	let root: Ref<_> = root_owner:get().*;
	kernel(0_ul, root_owner:get());
	if (root.result == 42_ui) {
		0
	} else {
		1
	}
}
