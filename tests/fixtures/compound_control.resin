export { kernel, main };
import { "$/shared.resin" };

struct State {
	counter: u32,
	result: u32,
}
struct Pair {
	a: u32,
	b: u32,
}
fn touch(p: Ptr<State>) -> u32 {
	let mut old = p.counter;
	p.counter = old + u32(1);
	old
}
fn choose(p: Ptr<State>) -> Ptr<u32> {
	touch(p);
	&p.result
}
fn identity(n: u32) -> u32 {
	n
}
@compute_shader
fn kernel(i: u64, root: Ptr<State>) {
	if (i == u64(0)) {
		let mut x: u32 = 0;
		x = if (i == u64(0)) {
			u32(7)
		} else {
			u32(8)
		};
		let mut flag = i32(1) == 2;
		flag = i == u64(0) && touch(root) == u32(0);
		let mut values = [u32(0), u32(0)];
		values(touch(root) - u32(1)) = if (flag) {
			touch(root) + u32(9)
		} else {
			u32(12)
		};
		let mut pair = Pair {
			b = if (flag) {
				touch(root)
			} else {
				u32(99)
			},
			a = touch(root)
		};
		choose(root).* = identity(
			if (flag) {
				touch(root) + u32(14)
			} else {
				u32(99)
			}
		);
		root.result = if (x == u32(7) && flag && values(u64(0)) == u32(11) && pair.a == u32(4) && pair.b == u32(3) && root.counter == u32(7) && root.result == u32(20)) {
			u32(42)
		} else {
			u32(99)
		};
	};
}
fn main() -> i32 | Err<_> {
	let root_owner = arc_ptr_alloc(State { counter = u32(0), result = u32(0) })?;
	let root: Ref<_> = root_owner:get().*;
	kernel(u64(0), root_owner:get());
	if (root.result == u32(42)) {
		0
	} else {
		1
	}
}
