export { kernel, main };
def convert(i: uint) -> uint = {
    var f = float32(i);
    var wide = ulong(i);
    var round = 16777217_ui;
    var negative = -1.9_f;
    if (int(negative) == -1_i && float32(round) == 16777216.0_f && uint(wide) == i) {
        uint(f + 42.75_f)
    } else { 99_ui }
};
def kernel(i: uint, p: Ptr<uint>) = { if (i == 0_ui) { p.* := convert(i); }; };
def main() -> int = { var result = 0_ui; kernel(0_ui, &result); if (result == 42_ui) { 0 } else { 1 } };
