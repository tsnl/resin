export { kernel, main };
import { "$/shared.resin" };

fn convert(i: u32) -> u32 {
	let mut f = f32(i);
	let mut wide = u64(i);
	let mut round: u32 = 16777217;
	let mut negative: f32 = -1.9;
	if (i32(negative) == i32(-1) && f32(round) == f32(16777216.0) && u32(wide) == i) {
		u32(f + f32(42.75))
	} else {
		u32(99)
	}
}
@compute_shader
fn kernel(i: u64, p: Ptr<u32>) {
	if (i == u64(0)) {
		p.* = convert(u32(i));
	};
}
fn main() -> i32 | Err<_> {
	let result_owner = arc_ptr_alloc(u32(0))?;
	let result: Ref<_> = result_owner:get().*;
	kernel(u64(0), result_owner:get());
	if (result == u32(42)) {
		0
	} else {
		1
	}
}
