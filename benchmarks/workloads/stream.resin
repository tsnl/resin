export { Root, kernel, cpu };

import { "$/span.resin" };

intrinsic "pointer_index_mut" fn device_index<T>(data: PtrMut<T>, length: u64, index: u64) -> PtrMut<T>;

struct Root {
	count: u32,
	iterations: u32,
	input: PtrMut<u32>,
	output: PtrMut<u32>,
}

// One read and one write per lane, with little arithmetic between them.
@compute_shader
fn kernel(index: u64, root: PtrMut<Root>) {
	if (index < u64(root.count)) {
		let mut input = SpanMut<u32> { data = root.input, length = u64(root.count) };
		let mut output = SpanMut<u32> { data = root.output, length = u64(root.count) };
		device_index(output.data, output.length, index).* = device_index(input.data, input.length, index).* * u32(1664525) + u32(index);
	};
}

fn cpu(root: PtrMut<Root>) {
	let mut index: u64 = 0;
	while (index < u64(root.count)) {
		kernel(index, root);
		index = index + u64(1);
	};
}
