export { Root, kernel, cpu };

import { "$/span.resin" };

struct Root {
	iterations: u32,
	input: Span<u32>,
	output: SpanMut<u32>,
}

// One read and one write per lane, with little arithmetic between them.
@compute_shader
fn kernel(index: u64, root: Ptr<Root>) {
	if (index < root.output.length) {
		root.output:at_mut(index) = root.input:at(index) * u32(1664525) + u32(index);
	};
}

fn cpu(root: Ptr<Root>) {
	let mut index: u64 = 0;
	while (index < root.output.length) {
		kernel(index, root);
		index = index + u64(1);
	};
}
