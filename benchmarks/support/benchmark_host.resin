export { main };

import { "@WORKLOAD@" };

extern "benchmark.h" def benchmark_argument(argc: int, argv: Ptr<Ptr<ubyte>>, index: uint) -> ulong;
extern "benchmark.h" def benchmark_allocate(count: uint) -> Ptr<uint>;
extern "benchmark.h" def benchmark_prepare(input: Ptr<uint>, output: Ptr<uint>, count: uint, seed: uint);
extern "benchmark.h" def benchmark_clock() -> ulong;
extern "benchmark.h" def benchmark_report(start: ulong, end: ulong, output: Ptr<uint>, count: uint, measured: int);
extern "benchmark.h" def benchmark_free(data: Ptr<uint>);

def main(argc: int, argv: Ptr<Ptr<ubyte>>, envp: Ptr<Ptr<ubyte>>) = {
	var count = uint(benchmark_argument(argc, argv, 1_ui));
	var iterations = uint(benchmark_argument(argc, argv, 2_ui));
	var samples = benchmark_argument(argc, argv, 3_ui);
	var warmup = benchmark_argument(argc, argv, 4_ui);
	var seed = uint(benchmark_argument(argc, argv, 5_ui));
	var input = benchmark_allocate(count);
	var output = benchmark_allocate(count);
	benchmark_prepare(input, output, count, seed);
	var root = Root { count = count, iterations = iterations, input = input, output = output };
	var index = 0_ul;
	while (index < warmup) {
		var start = benchmark_clock();
		cpu(&root);
		var end = benchmark_clock();
		benchmark_report(start, end, output, count, 0_i);
		index := index + 1_ul;
	};
	index := 0_ul;
	while (index < samples) {
		var start = benchmark_clock();
		cpu(&root);
		var end = benchmark_clock();
		benchmark_report(start, end, output, count, 1_i);
		index := index + 1_ul;
	};
	benchmark_free(output);
	benchmark_free(input);
};
