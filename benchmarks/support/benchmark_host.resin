export { main };

extern {
	"benchmark.h": {
		fn benchmark_argument(argc: i32, argv: Ptr<Ptr<u8>>, index: u32) -> u64;
		fn benchmark_prepare(input: PtrMut<u32>, output: PtrMut<u32>, count: u32, seed: u32);
		fn benchmark_clock() -> u64;
		fn benchmark_report(start: u64, end: u64, output: PtrMut<u32>, count: u32, measured: i32);
	},
};

import { "$/shared.resin", "$/span.resin", "@WORKLOAD@" };

fn main(argc: i32, argv: Ptr<Ptr<u8>>, envp: Ptr<Ptr<u8>>) -> (() | Err<_>) {
	let mut count = u32(benchmark_argument(argc, argv, u32(1)));
	let mut iterations = u32(benchmark_argument(argc, argv, u32(2)));
	let mut samples = benchmark_argument(argc, argv, u32(3));
	let mut warmup = benchmark_argument(argc, argv, u32(4));
	let mut seed = u32(benchmark_argument(argc, argv, u32(5)));
	let mut input_owner = arc_span_alloc::<u32>(u64(count), u32(0))?;
	let mut output_owner = arc_span_alloc::<u32>(u64(count), u32(0))?;
	let input = input_owner:get();
	let input_view = input:read_only();
	let output = output_owner:get();
	benchmark_prepare(input.data, output.data, count, seed);
	let root = arc_ptr_alloc(Root { iterations = iterations, input = input_view, output = output })?;
	let mut index: u64 = 0;
	while (index < warmup) {
		let mut start = benchmark_clock();
		cpu(root:get());
		let mut end = benchmark_clock();
		benchmark_report(start, end, output.data, count, i32(0));
		index = index + u64(1);
	};
	index = u64(0);
	while (index < samples) {
		let mut start = benchmark_clock();
		cpu(root:get());
		let mut end = benchmark_clock();
		benchmark_report(start, end, output.data, count, i32(1));
		index = index + u64(1);
	};
	(())
}
