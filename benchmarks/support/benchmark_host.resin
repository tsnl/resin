export { main };

extern {
	"benchmark.h": {
		fn benchmark_argument(argc: int, argv: Ptr<Ptr<ubyte>>, index: uint) -> ulong;
		fn benchmark_prepare(input: Ptr<uint>, output: Ptr<uint>, count: uint, seed: uint);
		fn benchmark_clock() -> ulong;
		fn benchmark_report(start: ulong, end: ulong, output: Ptr<uint>, count: uint, measured: int);
	},
};

import { "$/shared.resin", "@WORKLOAD@" };

fn main(argc: int, argv: Ptr<Ptr<ubyte>>, envp: Ptr<Ptr<ubyte>>) -> (() | Err<_>)  {
	let mut count = uint(benchmark_argument(argc, argv, 1_ui));
	let mut iterations = uint(benchmark_argument(argc, argv, 2_ui));
	let mut samples = benchmark_argument(argc, argv, 3_ui);
	let mut warmup = benchmark_argument(argc, argv, 4_ui);
	let mut seed = uint(benchmark_argument(argc, argv, 5_ui));
	let mut input_owner = arc_span_alloc::<uint>(ulong(count), 0_ui)?;
	let mut output_owner = arc_span_alloc::<uint>(ulong(count), 0_ui)?;
	let mut input = input_owner:get().data;
	let mut output = output_owner:get().data;
	benchmark_prepare(input, output, count, seed);
	let mut root = Root { count = count, iterations = iterations, input = input, output = output };
	let mut index = 0_ul;
	while (index < warmup) {
		let mut start = benchmark_clock();
		cpu(&root);
		let mut end = benchmark_clock();
		benchmark_report(start, end, output, count, 0_i);
		index = index + 1_ul;
	};
	index = 0_ul;
	while (index < samples) {
		let mut start = benchmark_clock();
		cpu(&root);
		let mut end = benchmark_clock();
		benchmark_report(start, end, output, count, 1_i);
		index = index + 1_ul;
	};
	(())
}
