//! PNG image input and output using bounded byte views.

export { ImageData, width, height, channels, pixels, image_data_read_png, image_data_write_pixels, write_png, clone };

extern {
	"resin_runtime.h": {
		fn resin_image_write_png(path: Ptr<u8>, width: u32, height: u32, channels: u32, pixels: Ptr<u8>, stride: u64) -> i32;
		fn resin_image_read_png(path: Ptr<u8>, channels: u32, width: Ptr<u32>, height: Ptr<u32>, actual_channels: Ptr<u32>, pixels: Ptr<Ptr<u8>>) -> i32;
		fn resin_image_free(pixels: Ptr<u8>) -> ();
	},
};

import { "span.resin", "status.resin", "shared.resin" };

struct ImageDataOwner {
	width: u32,
	height: u32,
	channels: u32,
	pixels: Ptr<u8>,
}
fn drop(self: Ref<ImageDataOwner>) {
	if (u64(self.pixels) != u64(0)) {
		resin_image_free(self.pixels);
	};
}

struct ImageData {
	owner: ArcPtr<ImageDataOwner>,
}
fn width(self: Ref<ImageData>) -> u32 {
	self.owner:get().width
}

fn height(self: Ref<ImageData>) -> u32 {
	self.owner:get().height
}

fn channels(self: Ref<ImageData>) -> u32 {
	self.owner:get().channels
}

fn pixels(self: Ref<ImageData>) -> Span<u8> {
	let mut data = self.owner:get();
	Span<u8> { data = data.pixels, length = u64(data.width) * u64(data.height) * u64(data.channels) }
}

fn image_data_read_png(path: Ptr<u8>, channels: u32) -> (ImageData | Err<RuntimeError>) {
	let mut owner = arc_ptr_alloc::<ImageDataOwner>(
		ImageDataOwner {
			width = u32(0),
			height = u32(0),
			channels = u32(0),
			pixels = Ptr<u8>(u64(0)),
		}
	)?;
	let mut data = owner:get();
	runtime_status_from_code(resin_image_read_png(path, channels, &data.width, &data.height, &data.channels, &data.pixels))?;
	(ImageData { owner = owner })
}

fn image_data_write_pixels(path: Ptr<u8>, width: u32, height: u32, channels: u32, pixels: Ref<Span<u8>>, stride: u64) -> (() | Err<RuntimeError>) {
	if (width == u32(0) || height == u32(0) || channels == u32(0) || channels > u32(4)) {
		return Err(InvalidArgument {});
	};
	let mut row_bytes = u64(width) * u64(channels);
	let mut row_stride = if (stride == u64(0)) {
		row_bytes
	} else {
		stride
	};
	// Check the final row's pixels without requiring unused trailing padding.
	// Subtraction and division avoid overflowing the strided image extent.
	if (row_stride < row_bytes || pixels.length < row_bytes || u64(height - u32(1)) > (pixels.length - row_bytes) / row_stride) {
		Err(InvalidArgument {})
	} else {
		runtime_status_from_code(resin_image_write_png(path, width, height, channels, pixels.data, row_stride))
	}
}

fn write_png(self: Ref<ImageData>, path: Ptr<u8>) -> (() | Err<RuntimeError>) {
	runtime_status_from_code(resin_image_write_png(path, self:width(), self:height(), self:channels(), self:pixels().data, u64(0)))
}

fn clone(value: Ref<ImageData>) -> ImageData {
	ImageData { owner = value.owner:clone() }
}
