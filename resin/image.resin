export { ImageData };

import { "span.resin", "status.resin", "shared.resin" };

struct ImageDataOwner {
	width: uint,
	height: uint,
	channels: uint,
	pixels: Ptr<ubyte>,
	def drop(self: Ptr<ImageDataOwner>) = {
		if (ulong(self.pixels) != 0_ul) {
			resin_image_free(self.pixels);
		};
	};
};

struct ImageData {
	owner: ArcPtr<ImageDataOwner>,
	def width(self: Ptr<ImageData>) -> uint = {
		self.owner.get().width
	};
	def height(self: Ptr<ImageData>) -> uint = {
		self.owner.get().height
	};
	def channels(self: Ptr<ImageData>) -> uint = {
		self.owner.get().channels
	};
	def pixels(self: Ptr<ImageData>) -> Span<ubyte> = {
		var data = self.owner.get();
		Span<ubyte> { data = data.pixels, length = ulong(data.width) * ulong(data.height) * ulong(data.channels) }
	};

	def read_png(path: Ptr<ubyte>, channels: uint) -> Result<ImageData, RuntimeError> = {
		var owner = ArcPtr<ImageDataOwner>.alloc(
			ImageDataOwner {
				width = 0_ui,
				height = 0_ui,
				channels = 0_ui,
				pixels = Ptr<ubyte>(0_ul),
			}
		)?;
		var data = owner.get();
		RuntimeStatus.from_code(resin_image_read_png(path, channels, &data.width, &data.height, &data.channels, &data.pixels))?;
		ok(ImageData { owner = owner })
	};
	def write_pixels(path: Ptr<ubyte>, width: uint, height: uint, channels: uint, pixels: Span<ubyte>, stride: ulong) -> Result<(), RuntimeError> = {
		if (width == 0_ui || height == 0_ui || channels == 0_ui || channels > 4_ui) {
			err(InvalidArgument {})
		} else {
			ok(())
		}?;
		var row_bytes = ulong(width) * ulong(channels);
		var row_stride = if (stride == 0_ul) {
			row_bytes
		} else {
			stride
		};
		// Division checks the entire padded image extent without overflowing.
		if (row_stride < row_bytes || row_stride > pixels.length / ulong(height)) {
			err(InvalidArgument {})
		} else {
			RuntimeStatus.from_code(resin_image_write_png(path, width, height, channels, pixels.data, row_stride))
		}
	};

	def write_png(self: Ptr<ImageData>, path: Ptr<ubyte>) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_image_write_png(path, self.width(), self.height(), self.channels(), self.pixels().data, 0_ul))
	};
};

extern "resin_runtime.h" def resin_image_write_png(path: Ptr<ubyte>, width: uint, height: uint, channels: uint, pixels: Ptr<ubyte>, stride: ulong) -> int;
extern "resin_runtime.h" def resin_image_read_png(path: Ptr<ubyte>, channels: uint, width: Ptr<uint>, height: Ptr<uint>, actual_channels: Ptr<uint>, pixels: Ptr<Ptr<ubyte>>) -> int;
extern "resin_runtime.h" def resin_image_free(pixels: Ptr<ubyte>) -> ();
