//! PNG, OpenEXR, and Radiance HDR image input, with bounded byte or float views.
//! Float images preserve linear RGBA values without clamping or tone mapping.

export { ImageData, FloatImageData, width, height, channels, pixels, image_data_read_png, image_data_write_pixels, write_png, image_data_read_exr, image_data_read_hdr, image_data_write_exr_pixels, write_exr, clone };

extern {
	"resin_runtime.h": {
		fn resin_image_read_exr(path: Ptr<u8>, width: Ptr<u32>, height: Ptr<u32>, pixels: Ptr<Ptr<f32>>) -> i32;
		fn resin_image_read_hdr(path: Ptr<u8>, width: Ptr<u32>, height: Ptr<u32>, pixels: Ptr<Ptr<f32>>) -> i32;
		fn resin_image_write_exr(path: Ptr<u8>, width: u32, height: u32, pixels: Ptr<f32>, sample_count: u64) -> i32;
		fn resin_image_write_png(path: Ptr<u8>, width: u32, height: u32, channels: u32, pixels: Ptr<u8>, stride: u64) -> i32;
		fn resin_image_read_png(path: Ptr<u8>, channels: u32, width: PtrMut<u32>, height: PtrMut<u32>, actual_channels: PtrMut<u32>, pixels: PtrMut<PtrMut<u8>>) -> i32;
		fn resin_image_free(pixels: PtrMut<u8>) -> ();
	},
};

import { "span.resin", "status.resin", "shared.resin", "string.resin" };

struct ImageDataOwner {
	width: u32,
	height: u32,
	channels: u32,
	pixels: PtrMut<u8>,
}
fn drop(self: RefMut<ImageDataOwner>) {
	if (u64(self.pixels) != u64(0)) {
		resin_image_free(self.pixels);
	};
}

struct ImageData {
	owner: ArcPtr<ImageDataOwner>,
}
fn width(self: Ref<ImageData>) -> u32 {
	self.owner:get().width
}

fn height(self: Ref<ImageData>) -> u32 {
	self.owner:get().height
}

fn channels(self: Ref<ImageData>) -> u32 {
	self.owner:get().channels
}

fn pixels(self: Ref<ImageData>) -> SpanMut<u8> {
	let mut data = self.owner:get();
	SpanMut<u8> { data = data.pixels, length = u64(data.width) * u64(data.height) * u64(data.channels) }
}

/// Read a bounded path; NUL termination is handled at the native boundary.
fn image_data_read_png(path: Span<u8>, channels: u32) -> (ImageData | Err<RuntimeError>) {
	let terminated = path_string(path)?;
	let mut owner = arc_ptr_alloc::<ImageDataOwner>(
		ImageDataOwner {
			width = u32(0),
			height = u32(0),
			channels = u32(0),
			pixels = PtrMut<u8>(u64(0)),
		}
	)?;
	let mut data = owner:get();
	runtime_status_from_code(resin_image_read_png(terminated:get().data, channels, &data.width, &data.height, &data.channels, &data.pixels))?;
	(ImageData { owner = owner })
}

/// Write bounded path and pixel views; embedded NULs in paths are rejected.
fn image_data_write_pixels(path: Span<u8>, width: u32, height: u32, channels: u32, pixels: Span<u8>, stride: u64) -> (() | Err<RuntimeError>) {
	if (width == u32(0) || height == u32(0) || channels == u32(0) || channels > u32(4)) {
		return Err(InvalidArgument {});
	};
	let mut row_bytes = u64(width) * u64(channels);
	let mut row_stride = if (stride == u64(0)) {
		row_bytes
	} else {
		stride
	};
	// Check the final row's pixels without requiring unused trailing padding.
	// Subtraction and division avoid overflowing the strided image extent.
	if (row_stride < row_bytes || pixels.length < row_bytes || u64(height - u32(1)) > (pixels.length - row_bytes) / row_stride) {
		Err(InvalidArgument {})
	} else {
		let terminated = path_string(path)?;
		runtime_status_from_code(resin_image_write_png(terminated:get().data, width, height, channels, pixels.data, row_stride))
	}
}

fn write_png(self: Ref<ImageData>, path: Span<u8>) -> (() | Err<RuntimeError>) {
	let view = self:pixels();
	image_data_write_pixels(path, self:width(), self:height(), self:channels(), view:read_only(), 0)
}

fn clone(value: Ref<ImageData>) -> ImageData {
	ImageData { owner = value.owner:clone() }
}

// Copy exactly the bounded path and terminate it only at the C boundary.
// Embedded NULs must not silently redirect an operation to a shorter path.
fn path_string(path: Ref<Span<u8>>) -> String | Err<InvalidArgument> {
	let mut index: u64 = 0;
	while (index < path.length) {
		if (path:at(index) == 0) {
			return Err(InvalidArgument {});
		};
		index = index + 1;
	};
	string_from_bytes(path)
}

//
// Linear floating-point images
//

struct FloatImageOwner {
	width: u32,
	height: u32,
	pixels: Ptr<f32>,
}
fn drop(self: RefMut<FloatImageOwner>) {
	resin_image_free(Ptr<u8>(self.pixels));
}

/// Shared ownership of packed linear RGBA float32 samples, with top-left origin.
/// Values above one and negative values are retained; alpha is unpremultiplied.
struct FloatImageData {
	owner: ArcPtr<FloatImageOwner>,
}
fn width(self: Ref<FloatImageData>) -> u32 {
	self.owner:get().width
}
fn height(self: Ref<FloatImageData>) -> u32 {
	self.owner:get().height
}
fn channels(self: Ref<FloatImageData>) -> u32 {
	4
}
fn pixels(self: Ref<FloatImageData>) -> Span<f32> {
	let data = self.owner:get();
	Span<f32> { data = data.pixels, length = u64(data.width) * u64(data.height) * 4 }
}
fn clone(self: Ref<FloatImageData>) -> FloatImageData {
	FloatImageData { owner = self.owner:clone() }
}

/// Decode the first RGB(A) layer of an OpenEXR file. Missing alpha becomes one.
fn image_data_read_exr(path: Ptr<u8>) -> FloatImageData | Err<RuntimeError> {
	read_float_image(path, true)
}

/// Decode a Radiance RGBE (.hdr) environment map into linear RGBA float32.
fn image_data_read_hdr(path: Ptr<u8>) -> FloatImageData | Err<RuntimeError> {
	read_float_image(path, false)
}

fn read_float_image(path: Ptr<u8>, exr: bool) -> FloatImageData | Err<RuntimeError> {
	let owner = arc_ptr_alloc(FloatImageOwner { width = 0, height = 0, pixels = Ptr<f32>(u64(0)) })?;
	let data = owner:get();
	let code = if (exr) {
		resin_image_read_exr(path, &data.width, &data.height, &data.pixels)
	} else {
		resin_image_read_hdr(path, &data.width, &data.height, &data.pixels)
	};
	runtime_status_from_code(code)?;
	FloatImageData { owner = owner }
}

/// Write a complete packed RGBA float image. The span must contain exactly
/// width * height * 4 samples; invalid extents preserve any existing file.
fn image_data_write_exr_pixels(path: Ptr<u8>, width: u32, height: u32, pixels: Ref<Span<f32>>) -> () | Err<RuntimeError> {
	runtime_status_from_code(resin_image_write_exr(path, width, height, pixels.data, pixels.length))
}

fn write_exr(self: Ref<FloatImageData>, path: Ptr<u8>) -> () | Err<RuntimeError> {
	let view = self:pixels();
	image_data_write_exr_pixels(path, self:width(), self:height(), view)
}
