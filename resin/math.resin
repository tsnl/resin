//! Complex arithmetic and scalar mathematical functions.
//! Angles are radians. Shader transcendental functions use `f32`.

export { floor, exp, acos, log, atan2, pow, sqrt, sin, cos, Complex, complex, add, mul, squared, magnitude_squared };

// Host: f32 and f64. Shaders: f32. Angles are in radians.
intrinsic "sqrt" fn sqrt<T>(value: T) -> T;
intrinsic "sin" fn sin<T>(value: T) -> T;
intrinsic "cos" fn cos<T>(value: T) -> T;

intrinsic "floor" fn floor<T>(a: T) -> T;
intrinsic "exp" fn exp<T>(a: T) -> T;
intrinsic "acos" fn acos<T>(a: T) -> T;
intrinsic "log" fn log<T>(a: T) -> T;
intrinsic "atan2" fn atan2<T>(a: T, b: T) -> T;
intrinsic "pow" fn pow<T>(a: T, b: T) -> T;

/// A complex number with real and imaginary components.
struct Complex<T> {
	real: T,
	imag: T,
}

/// Construct a complex value without allocation.
fn complex<T>(real: T, imag: T) -> Complex<T> {
	Complex<T> { real = real, imag = imag }
}

/// Return the sum, leaving both operands unchanged.
fn add<T>(left: Complex<T>, right: Complex<T>) -> Complex<T> {
	complex(left.real + right.real, left.imag + right.imag)
}

/// Return the product, leaving both operands unchanged.
fn mul<T>(left: Complex<T>, right: Complex<T>) -> Complex<T> {
	// (a + bi)(c + di) = (ac - bd) + i(ad + bc).
	complex(
		left.real * right.real - left.imag * right.imag,
		left.real * right.imag + left.imag * right.real,
	)
}

/// Return the square, leaving the operand unchanged.
fn squared<T>(value: Complex<T>) -> Complex<T> {
	mul(value, value)
}

/// Compute `real² + imag²` without changing the operand or taking a square root.
fn magnitude_squared<T>(value: Complex<T>) -> T {
	value.real * value.real + value.imag * value.imag
}
