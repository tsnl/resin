//! Spatiotemporal variance-guided filtering for linear HDR radiance.
//! Independent middleware: callers supply radiance, world-position/stable-ID,
//! and unit-normal buffers. ID zero marks background. reset clears history after
//! a scene/lighting change; camera motion uses the supplied view-projection.
export { Svgf, svgf_create, filter, reset };
import { "gpu.resin", "linalg.resin", "math.resin", "span.resin", "status.resin", "ownership.resin" };

struct FilterRoot<B> {
	current: B,
	positions: B,
	normals: B,
	old_color: B,
	old_positions: B,
	old_normals: B,
	old_moments: B,
	output: B,
	moments: B,
	previous_view_projection: Mat4,
	width: u32,
	height: u32,
	valid: u32,
	step: u32,
}
type ShaderFilter = FilterRoot<Span<Vec4>>;
// History is unique mutable state. Moving it is safe; implicit copies would
// share buffers but disagree about which frame those buffers describe.
struct Svgf {
	unique_history: PhantomBox,
	gpu: Gpu,
	width: u32,
	height: u32,
	valid: bool,
	previous_view_projection: Mat4,
	history_color: GpuSpan<Vec4>,
	history_positions: GpuSpan<Vec4>,
	history_normals: GpuSpan<Vec4>,
	history_moments: GpuSpan<Vec4>,
	temporal: GpuSpan<Vec4>,
	moments: GpuSpan<Vec4>,
	ping: GpuSpan<Vec4>,
	pong: GpuSpan<Vec4>,
	temporal_pipeline: GpuComputePipeline<ShaderFilter, GpuPipelineOwner>,
	variance_pipeline: GpuComputePipeline<ShaderFilter, GpuPipelineOwner>,
	atrous_pipeline: GpuComputePipeline<ShaderFilter, GpuPipelineOwner>,
	history_pipeline: GpuComputePipeline<ShaderFilter, GpuPipelineOwner>,
}
fn svgf_create(gpu: Ref<Gpu>, width: u32, height: u32) -> Svgf | Err<RuntimeError> {
	if (width == 0 || height == 0 || u64(width) * u64(height) > 16777216) {
		return Err(InvalidArgument {});
	};
	let count = u64(width) * u64(height);
	Svgf { unique_history = PhantomBox {}, gpu = gpu:clone(), width = width, height = height, valid = false, previous_view_projection = identity_transform(), history_color = gpu:alloc::<Vec4>(count)?, history_positions = gpu:alloc::<Vec4>(count)?, history_normals = gpu:alloc::<Vec4>(count)?, history_moments = gpu:alloc::<Vec4>(count)?, temporal = gpu:alloc::<Vec4>(count)?, moments = gpu:alloc::<Vec4>(count)?, ping = gpu:alloc::<Vec4>(count)?, pong = gpu:alloc::<Vec4>(count)?, temporal_pipeline = gpu:create_compute_pipeline(temporal_pass)?, variance_pipeline = gpu:create_compute_pipeline(variance_pass)?, atrous_pipeline = gpu:create_compute_pipeline(atrous_pass)?, history_pipeline = gpu:create_compute_pipeline(history_pass)? }
}
fn reset(self: RefMut<Svgf>) {
	self.valid = false;
}
fn parameters(self: Ref<Svgf>, current: Ref<GpuSpan<Vec4>>, positions: Ref<GpuSpan<Vec4>>, normals: Ref<GpuSpan<Vec4>>) -> FilterRoot<GpuSpan<Vec4>> {
	FilterRoot<_> {
		current = current:clone(),
		positions = positions:clone(),
		normals = normals:clone(),
		old_color = self.history_color:clone(),
		old_positions = self.history_positions:clone(),
		old_normals = self.history_normals:clone(),
		old_moments = self.history_moments:clone(),
		output = self.temporal:clone(),
		moments = self.moments:clone(),
		previous_view_projection = self.previous_view_projection,
		width = self.width,
		height = self.height,
		valid = if (self.valid) {
			u32(1)
		} else {
			u32(0)
		},
		step = 1
	}
}
/// Submit filtering and retain reusable history. Output aliases internal storage
/// until the next call. Clone retains allocation lifetime, not an immutable snapshot.
fn filter(self: RefMut<Svgf>, radiance: Ref<GpuSpan<Vec4>>, positions: Ref<GpuSpan<Vec4>>, normals: Ref<GpuSpan<Vec4>>, view_projection: Mat4) -> GpuSpan<Vec4> | Err<RuntimeError> {
	let count = u64(self.width) * u64(self.height);
	if (radiance.length != count || positions.length != count || normals.length != count) {
		return Err(InvalidArgument {});
	};
	let groups = u32((count + self.gpu:compute_workgroup_size() - 1) / self.gpu:compute_workgroup_size());
	if (groups > 65535) {
		return Err(InvalidArgument {});
	};
	let commands = self.gpu:start_command_recording()?;
	let mut root = parameters(self, radiance, positions, normals);
	commands:dispatch(self.temporal_pipeline, root, groups, 1, 1)?;
	root.current = self.temporal:clone();
	root.output = self.ping:clone();
	commands:dispatch(self.variance_pipeline, root, groups, 1, 1)?;
	let mut level: u32 = 0;
	while (level < 5) {
		root.current = if (level % 2 == 0) {
			self.ping:clone()
		} else {
			self.pong:clone()
		};
		root.output = if (level % 2 == 0) {
			self.pong:clone()
		} else {
			self.ping:clone()
		};
		root.step = u32(1) << level;
		commands:dispatch(self.atrous_pipeline, root, groups, 1, 1)?;
		// Feed back only the first spatial level; deeper levels would blur history.
		if (level == 0) {
			root.current = self.pong:clone();
			commands:dispatch(self.history_pipeline, root, groups, 1, 1)?;
		};
		level = level + 1;
	};
	commands:submit()?;
	self.previous_view_projection = view_projection;
	self.valid = true;
	self.pong:clone()
}
fn in_bounds(x: i32, y: i32, width: u32, height: u32) -> bool {
	x >= 0 && y >= 0 && x < i32(width) && y < i32(height)
}
fn offset(x: i32, y: i32, width: u32) -> u64 {
	u64(y) * u64(width) + u64(x)
}
fn geometry_weight(p: Vec4, n: Vec4, q: Vec4, m: Vec4, step: u32) -> f32 {
	if (p.w == 0 || q.w == 0) {
		return 0;
	};
	let cosine = max(0, dot(xyz(n), xyz(m)));
	let plane = abs(dot(xyz(n), sub(xyz(p), xyz(q))));
	pow(cosine, f32(64)) * exp(-plane / (0.005 * f32(step) + 0.0001))
}
@compute_shader
fn temporal_pass(index: u64, root: Ptr<ShaderFilter>) {
	if (index >= u64(root.width) * u64(root.height)) {
		return;
	};
	let p = root.positions:at(index);
	let n = root.normals:at(index);
	let color = xyz(root.current:at(index));
	let l = luminance(color);
	let x = i32(index % u64(root.width));
	let y = i32(index / u64(root.width));
	let mut old = vec3(0, 0, 0);
	let mut moments = vec4(0, 0, 0, 0);
	let mut weight: f32 = 0;
	if (root.valid != 0 && p.w != 0) {
		let clip = mul(root.previous_view_projection, vec4(p.x, p.y, p.z, 1));
		if (clip.w > 0 && clip.z >= 0 && clip.z <= clip.w) {
			let px = (clip.x / clip.w + 1) * 0.5 * f32(root.width) - 0.5;
			let py = (clip.y / clip.w + 1) * 0.5 * f32(root.height) - 0.5;
			let left = i32(floor(px));
			let top = i32(floor(py));
			let u = px - floor(px);
			let v = py - floor(py);
			let mut dy: i32 = 0;
			while (dy < 2) {
				let mut dx: i32 = 0;
				while (dx < 2) {
					if (in_bounds(left + dx, top + dy, root.width, root.height)) {
						let j = offset(left + dx, top + dy, root.width);
						let q = root.old_positions:at(j);
						let m = root.old_normals:at(j);
						let distance = length(sub(xyz(p), xyz(q)));
						if (p.w == q.w && dot(xyz(n), xyz(m)) > 0.9 && distance < 0.05) {
							let w = (
								if (dx == 0) {
									1 - u
								} else {
									u
								}
							) * (
								if (dy == 0) {
									1 - v
								} else {
									v
								}
							);
							old = add(old, mul(xyz(root.old_color:at(j)), w));
							moments = add(moments, mul(root.old_moments:at(j), w));
							weight = weight + w;
						};
					};
					dx = dx + 1;
				};
				dy = dy + 1;
			};
		};
	};
	let mut filtered = color;
	let mut count: f32 = 1;
	let mut mean = l;
	let mut second = l * l;
	if (weight > 0.0001) {
		old = mul(old, 1 / weight);
		moments = mul(moments, 1 / weight);
		let mut low = color;
		let mut high = color;
		let mut dy: i32 = -1;
		while (dy <= 1) {
			let mut dx: i32 = -1;
			while (dx <= 1) {
				if (in_bounds(x + dx, y + dy, root.width, root.height)) {
					let c = xyz(root.current:at(offset(x + dx, y + dy, root.width)));
					low = vec3(min(low.x, c.x), min(low.y, c.y), min(low.z, c.z));
					high = vec3(max(high.x, c.x), max(high.y, c.y), max(high.z, c.z));
				};
				dx = dx + 1;
			};
			dy = dy + 1;
		};
		old = vec3(clamp(old.x, low.x, high.x), clamp(old.y, low.y, high.y), clamp(old.z, low.z, high.z));
		count = min(moments.z + 1, 32);
		let alpha = max(1 / count, 0.1);
		filtered = add(mul(old, 1 - alpha), mul(color, alpha));
		mean = moments.x * (1 - alpha) + l * alpha;
		second = moments.y * (1 - alpha) + l * l * alpha;
	};
	let variance = max(0, second - mean * mean);
	root.output:at_mut(index) = vec4(filtered.x, filtered.y, filtered.z, variance);
	root.moments:at_mut(index) = vec4(mean, second, count, variance);
}
@compute_shader
fn variance_pass(index: u64, root: Ptr<ShaderFilter>) {
	if (index >= u64(root.width) * u64(root.height)) {
		return;
	};
	let color = root.current:at(index);
	let history = root.moments:at(index);
	let p = root.positions:at(index);
	let n = root.normals:at(index);
	let mut variance = color.w;
	if (history.z < 4 && p.w != 0) {
		let x = i32(index % u64(root.width));
		let y = i32(index / u64(root.width));
		let mut total: f32 = 0;
		let mut mean: f32 = 0;
		let mut second: f32 = 0;
		let mut dy: i32 = -3;
		while (dy <= 3) {
			let mut dx: i32 = -3;
			while (dx <= 3) {
				if (in_bounds(x + dx, y + dy, root.width, root.height)) {
					let j = offset(x + dx, y + dy, root.width);
					let w = geometry_weight(p, n, root.positions:at(j), root.normals:at(j), 1);
					let m = root.moments:at(j);
					mean = mean + w * m.x;
					second = second + w * m.y;
					total = total + w;
				};
				dx = dx + 1;
			};
			dy = dy + 1;
		};
		if (total > 0) {
			variance = max(0, second / total - (mean / total) * (mean / total)) * 4 / history.z;
		};
	};
	root.output:at_mut(index) = vec4(color.x, color.y, color.z, variance);
}
fn kernel(x: i32) -> f32 {
	if (x == 0) {
		6
	} else {
		if (x == 1 || x == -1) {
			4
		} else {
			1
		}
	}
}
@compute_shader
fn atrous_pass(index: u64, root: Ptr<ShaderFilter>) {
	if (index >= u64(root.width) * u64(root.height)) {
		return;
	};
	let center = root.current:at(index);
	let p = root.positions:at(index);
	let n = root.normals:at(index);
	if (p.w == 0) {
		root.output:at_mut(index) = center;
		return;
	};
	let x = i32(index % u64(root.width));
	let y = i32(index / u64(root.width));
	let step = i32(root.step);
	let sigma = 4 * sqrt(max(center.w, 0)) + 0.001;
	let l = luminance(xyz(center));
	let mut sum = vec3(0, 0, 0);
	let mut total: f32 = 0;
	let mut variance: f32 = 0;
	let mut dy: i32 = -2;
	while (dy <= 2) {
		let mut dx: i32 = -2;
		while (dx <= 2) {
			if (in_bounds(x + dx * step, y + dy * step, root.width, root.height)) {
				let j = offset(x + dx * step, y + dy * step, root.width);
				let c = root.current:at(j);
				let w = kernel(dx) * kernel(dy) * geometry_weight(p, n, root.positions:at(j), root.normals:at(j), root.step) * exp(-abs(luminance(xyz(c)) - l) / sigma);
				sum = add(sum, mul(xyz(c), w));
				variance = variance + w * w * c.w;
				total = total + w;
			};
			dx = dx + 1;
		};
		dy = dy + 1;
	};
	let value = mul(sum, 1 / max(total, 0.00000001));
	root.output:at_mut(index) = vec4(value.x, value.y, value.z, variance / max(total * total, 0.00000001));
}
@compute_shader
fn history_pass(index: u64, root: Ptr<ShaderFilter>) {
	if (index < u64(root.width) * u64(root.height)) {
		root.old_color:at_mut(index) = root.current:at(index);
		root.old_positions:at_mut(index) = root.positions:at(index);
		root.old_normals:at_mut(index) = root.normals:at(index);
		root.old_moments:at_mut(index) = root.moments:at(index);
	};
}
