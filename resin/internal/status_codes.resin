export {
	status_success,
	status_invalid_argument,
	status_vulkan_unavailable,
	status_unsupported,
	status_out_of_memory,
	status_vulkan_error,
	status_io_error,
	status_incomplete,
	status_window_unavailable,
};

// ResinStatus values from resin_runtime/status.h. Preserve their ABI order.
const (
	status_success: i32 = iota;
	status_invalid_argument: i32 = iota;
	status_vulkan_unavailable: i32 = iota;
	status_unsupported: i32 = iota;
	status_out_of_memory: i32 = iota;
	status_vulkan_error: i32 = iota;
	status_io_error: i32 = iota;
	status_incomplete: i32 = iota;
	status_window_unavailable: i32 = iota;
);
