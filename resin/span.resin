export { Span, bytes };

// Borrowed storage. The caller keeps the allocation alive throughout each access.
struct Span<T> {
	data: Ptr<T>,
	length: ulong,

	def at(self: Span<T>, index: ulong) -> Ptr<T> = {
		pointer_index(self.data, self.length, index)
	};

	def slice(self: Span<T>, start: ulong, length: ulong) -> Span<T> = {
		Span<T> {
			data = pointer_range(self.data, self.length, start, length),
			length = length,
		}
	};

	def as_bytes(self: Span<T>) -> Span<ubyte> = {
		Span<ubyte>(self.bytes())
	};

	// Primitive byte transport for formatting and native interfaces.
	def bytes(self: Span<T>) -> { data: Ptr<ubyte>, length: ulong } = {
		pointer_bytes(self.data, self.length)
	};
};

// Literal length excludes the NUL terminator; borrowing never copies the bytes.
def bytes(text: str) -> Span<ubyte> = {
	Span<ubyte> { data = text.data, length = text.length }
};

intrinsic "pointer_index" def pointer_index<T>(data: Ptr<T>, length: ulong, index: ulong) -> Ptr<T>;
intrinsic "pointer_range" def pointer_range<T>(data: Ptr<T>, capacity: ulong, start: ulong, length: ulong) -> Ptr<T>;
intrinsic "pointer_bytes" def pointer_bytes<T>(data: Ptr<T>, length: ulong) -> { data: Ptr<ubyte>, length: ulong };
