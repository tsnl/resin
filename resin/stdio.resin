//! Standard input, output, and error streams for host programs.
//! `print` writes verbatim bytes and traps on failure; stream writes and input return error unions.

export { print, Io, Output, WriteError, write, io_stdout, io_stderr, Console, InputLine, InputError, EndOfInput, InputReadError, InputOutOfMemory, InputWriteError, get, bytes, console_print, console_read_byte, console_read_line };

extern {
	"resin_runtime/print.h": {
		fn resin_print(data: Ptr<u8>, length: u64);
		fn resin_stream_write(stream: u32, data: Ptr<u8>, length: u64) -> i32;
	},
	"stdio.h": {
		fn getchar() -> i32;
	},
	"resin_runtime/console.h": {
		fn resin_console_byte(byte: i32) -> u8;
		fn resin_console_putchar(byte: u8) -> i32;
		fn resin_stdin_error() -> i32;
		fn resin_stdout_flush() -> i32;
	},
	"stdlib.h": {
		fn realloc(memory: PtrMut<u8>, bytes: u64) -> PtrMut<u8>;
		fn free(memory: PtrMut<u8>);
	},
};

import { "span.resin", "shared.resin", "string.resin" };

//
// Standard output and error
//

/// Write literal bytes to stdout, flush, and add no newline.
/// A write failure terminates the program; use an output stream’s `write` operation to handle errors.
fn print(text: str) {
	resin_print(text.data, text.length)
}

/// Write a borrowed byte span to stdout without formatting or adding a newline.
fn print(text: Ref<Span<u8>>) {
	resin_print(text.data, text.length)
}

/// Write an owned string to stdout while borrowing its storage.
fn print(text: Ref<String>) {
	let view = text:get();
	print(view)
}

// Native stream selectors for resin_stream_write.
const (
	stream_stdout: u32 = iota;
	stream_stderr: u32 = iota;
);

struct WriteError {}
struct Output {
	stream: u32,
}

// Writes bytes verbatim and flushes. No formatting or newline is added.
fn write(self: Ref<Output>, text: str) -> () | Err<WriteError> {
	let view = bytes(text);
	write(self, view)
}

fn write(self: Ref<Output>, text: Ref<String>) -> () | Err<WriteError> {
	let view = text:get();
	write(self, view)
}

fn write(self: Ref<Output>, text: Ref<Span<u8>>) -> () | Err<WriteError> {
	let status = resin_stream_write(self.stream, text.data, text.length);
	if (status == 0) {
		()
	} else {
		Err(WriteError {})
	}
}

struct Io {}
fn io_stdout() -> Output {
	Output { stream = stream_stdout }
}

fn io_stderr() -> Output {
	Output { stream = stream_stderr }
}

//
// Standard input
//

const initial_input_capacity: u64 = 128;
const max_input_capacity = ~u64(0);
const line_feed: i32 = 10;
const carriage_return: u8 = 13;

// Owns length bytes followed by a NUL. The final shared owner frees the allocation.
struct InputLineOwner {
	data: PtrMut<u8>,
	length: u64,
}
fn drop(self: RefMut<InputLineOwner>) {
	if (u64(self.data) != u64(0)) {
		free(self.data);
	};
}

struct InputLine {
	owner: ArcPtr<InputLineOwner>,
}
fn get(self: Ref<InputLine>) -> Span<u8> {
	let data = self.owner:get();
	Span<u8> { data = data.data, length = data.length }
}

fn bytes(self: Ref<InputLine>) -> (Ptr<u8>, u64) {
	let mut view = self:get();
	(view.data, view.length)
}

struct EndOfInput {}
struct InputReadError {}
struct InputOutOfMemory {}
struct InputWriteError {}
type InputError = EndOfInput | InputReadError | InputOutOfMemory;

fn resize_input(memory: PtrMut<u8>, capacity: u64) -> (PtrMut<u8> | Err<InputOutOfMemory>) {
	let mut resized = realloc(memory, capacity);
	if (u64(resized) == u64(0)) {
		Err(InputOutOfMemory {})
	} else {
		(resized)
	}
}

fn check_input_end(byte: i32, length: u64) -> (() | Err<EndOfInput | InputReadError>) {
	if (byte < 0 && resin_stdin_error() != 0) {
		Err(InputReadError {})
	} else {
		if (byte < 0 && length == u64(0)) {
			Err(EndOfInput {})
		} else {
			(())
		}
	}
}

struct Console {}
/// Write a borrowed input line verbatim to stdout, flush, and report write failures.
fn console_print(line: Ref<InputLine>) -> (() | Err<InputWriteError>) {
	let mut bytes = line:get();
	let mut index: u64 = 0;
	let mut written = 0;
	while (index < bytes.length && written >= 0) {
		written = resin_console_putchar(bytes:at(index));
		index = index + u64(1);
	};
	let mut flushed = resin_stdout_flush();
	if (written < 0 || flushed != 0) {
		Err(InputWriteError {})
	} else {
		(())
	}
}

/// Read one byte, distinguishing EOF from a stream failure.
fn console_read_byte() -> (u8 | Err<EndOfInput | InputReadError>) {
	let mut byte = getchar();
	check_input_end(byte, u64(0))?;
	(resin_console_byte(byte))
}

/// Read through LF or EOF, stripping the LF and an immediately preceding CR.
/// The returned owner retains all other bytes and a trailing NUL outside its length.
fn console_read_line() -> (InputLine | Err<InputError>) {
	let mut owner = match (arc_ptr_alloc::<InputLineOwner>(InputLineOwner { data = PtrMut<u8>(u64(0)), length = u64(0) })) {
		ArcPtr<InputLineOwner>(value) => {
			(value)
		},
		Err(error) => {
			return Err(InputOutOfMemory {});
		},
	};
	let mut storage = owner:get();
	storage.data = resize_input(PtrMut<u8>(u64(0)), initial_input_capacity)?;
	storage.length = initial_input_capacity;
	let mut length: u64 = 0;
	let mut byte = getchar();
	while (byte >= 0 && byte != line_feed) {
		if (length == storage.length - u64(1)) {
			// Reserve the terminator and reject growth that would wrap.
			let mut grown: (u64 | Err<InputOutOfMemory>);
			grown = if (storage.length > max_input_capacity / u64(2)) {
				Err(InputOutOfMemory {})
			} else {
				(storage.length * u64(2))
			};
			let mut capacity = grown?;
			storage.data = resize_input(storage.data, capacity)?;
			storage.length = capacity;
		};
		let view = SpanMut<u8> { data = storage.data, length = storage.length };
		view:at_mut(length) = resin_console_byte(byte);
		length = length + u64(1);
		byte = getchar();
	};
	check_input_end(byte, length)?;
	let view = SpanMut<u8> { data = storage.data, length = storage.length };
	if (byte == line_feed && length > u64(0)) {
		if (view:at(length - u64(1)) == carriage_return) {
			length = length - u64(1);
		};
	};
	view:at_mut(length) = u8(0);
	storage.length = length;
	(InputLine { owner = owner })
}
