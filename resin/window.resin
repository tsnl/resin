// Resin input snapshot bits from resin_runtime/window.h.
const (
	input_down: uint = 1 << iota;
	input_pressed: uint = 1 << iota;
	input_released: uint = 1 << iota;
);

struct ButtonState { down: bool, pressed: bool, released: bool };

def button_state(bits: uint) -> ButtonState = {
	ButtonState { down = (bits & input_down) != 0_ui, pressed = (bits & input_pressed) != 0_ui, released = (bits & input_released) != 0_ui }
};

extern type ResinWindow;
struct WindowOwner {
	handle: Ptr<ResinWindow>,
	def drop(self: Ptr<WindowOwner>) = {
		if (ulong(self.handle) != 0_ul) {
			resin_window_destroy(self.handle);
		};
	};
};

struct Window {
	owner: ArcPtr<WindowOwner>,
	def native(self: Ptr<Window>) -> Ptr<ResinWindow> = {
		self.owner.get().handle
	};

	def new(width: uint, height: uint, title: String) -> Result<Window, RuntimeError> = {
		var owner = ArcPtr<WindowOwner>.alloc(WindowOwner { handle = Ptr<ResinWindow>(0_ul) })?;
		RuntimeStatus.from_code(resin_window_create(width, height, title.get().data, &owner.get().handle))?;
		ok(Window { owner = owner })
	};
	def poll_events(self: Window) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_window_poll_events(self.native()))
	};
	def should_close(self: Window) -> bool = {
		resin_window_should_close(self.native()) != 0
	};
	def set_should_close(self: Window, close: bool) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(
			resin_window_set_should_close(
				self.native(),
				if (close) {
					1
				} else {
					0
				}
			)
		)
	};
	def framebuffer_size(self: Window) -> Result<(uint, uint), RuntimeError> = {
		var width = uint(0);
		var height = uint(0);
		RuntimeStatus.from_code(resin_window_framebuffer_size(self.native(), &width, &height))?;
		ok((width, height))
	};
	def set_size(self: Window, width: uint, height: uint) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_window_set_size(self.native(), width, height))
	};
	def key_pressed(self: Window, key: int) -> bool = {
		resin_window_key_pressed(self.native(), key) != 0
	};
	def key_state(self: Window, key: int) -> ButtonState = {
		button_state(resin_window_key_state(self.native(), key))
	};
	def mouse_button_state(self: Window, button: int) -> ButtonState = {
		button_state(resin_window_mouse_button_state(self.native(), button))
	};
	def cursor_position(self: Window) -> Result<(float64, float64), RuntimeError> = {
		var x = 0.0_d;
		var y = 0.0_d;
		RuntimeStatus.from_code(resin_window_cursor_position(self.native(), &x, &y))?;
		ok((x, y))
	};
	def scroll_delta(self: Window) -> Result<(float64, float64), RuntimeError> = {
		var x = 0.0_d;
		var y = 0.0_d;
		RuntimeStatus.from_code(resin_window_scroll_delta(self.native(), &x, &y))?;
		ok((x, y))
	};
	def focused(self: Window) -> bool = {
		resin_window_focused(self.native()) != 0
	};
	def capture_cursor(self: Window, capture: bool) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(
			resin_window_capture_cursor(
				self.native(),
				if (capture) {
					1
				} else {
					0
				}
			)
		)
	};
};

extern "resin_runtime.h" def resin_window_create(width: uint, height: uint, title: Ptr<ubyte>, window: Ptr<Ptr<ResinWindow>>) -> int;
extern "resin_runtime.h" def resin_window_destroy(window: Ptr<ResinWindow>) -> ();
extern "resin_runtime.h" def resin_window_poll_events(window: Ptr<ResinWindow>) -> int;
extern "resin_runtime.h" def resin_window_should_close(window: Ptr<ResinWindow>) -> int;
extern "resin_runtime.h" def resin_window_set_should_close(window: Ptr<ResinWindow>, close: int) -> int;
extern "resin_runtime.h" def resin_window_framebuffer_size(window: Ptr<ResinWindow>, width: Ptr<uint>, height: Ptr<uint>) -> int;
extern "resin_runtime.h" def resin_window_set_size(window: Ptr<ResinWindow>, width: uint, height: uint) -> int;
extern "resin_runtime.h" def resin_window_key_pressed(window: Ptr<ResinWindow>, key: int) -> int;
extern "resin_runtime.h" def resin_window_key_state(window: Ptr<ResinWindow>, key: int) -> uint;
extern "resin_runtime.h" def resin_window_mouse_button_state(window: Ptr<ResinWindow>, button: int) -> uint;
extern "resin_runtime.h" def resin_window_cursor_position(window: Ptr<ResinWindow>, x: Ptr<float64>, y: Ptr<float64>) -> int;
extern "resin_runtime.h" def resin_window_scroll_delta(window: Ptr<ResinWindow>, x: Ptr<float64>, y: Ptr<float64>) -> int;
extern "resin_runtime.h" def resin_window_focused(window: Ptr<ResinWindow>) -> int;
extern "resin_runtime.h" def resin_window_capture_cursor(window: Ptr<ResinWindow>, capture: int) -> int;
