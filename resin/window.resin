	key_right_shift: i32 = 340 + iota;
	key_right_control: i32 = 340 + iota;
	key_right_alt: i32 = 340 + iota;
	key_right_super: i32 = 340 + iota;
	key_menu: i32 = 340 + iota;
);

const (
	mouse_button_left: i32 = iota;
	mouse_button_right: i32 = iota;
	mouse_button_middle: i32 = iota;
	mouse_button_4: i32 = iota;
	mouse_button_5: i32 = iota;
	mouse_button_6: i32 = iota;
	mouse_button_7: i32 = iota;
	mouse_button_8: i32 = iota;
);

// Resin input snapshot bits from resin_runtime/window.h.
const (
	input_down: u32 = 1 << iota;
	input_pressed: u32 = 1 << iota;
	input_released: u32 = 1 << iota;
);

struct ButtonState {
	down: bool,
	pressed: bool,
	released: bool,
}

fn button_state(bits: u32) -> ButtonState {
	ButtonState { down = (bits & input_down) != u32(0), pressed = (bits & input_pressed) != u32(0), released = (bits & input_released) != u32(0) }
}

extern type ResinWindow;
struct WindowOwner {
	handle: Ptr<ResinWindow>,
}
fn drop(self: Ref<WindowOwner>) {
	if (u64(self.handle) != u64(0)) {
		resin_window_destroy(self.handle);
	};
}

struct Window {
	owner: ArcPtr<WindowOwner>,
}
fn native(self: Ref<Window>) -> Ptr<ResinWindow> {
	self.owner:get().handle
}

fn window_new(width: u32, height: u32, title: Ref<String>) -> (Window | Err<RuntimeError>) {
	let mut owner = arc_ptr_alloc::<WindowOwner>(WindowOwner { handle = Ptr<ResinWindow>(u64(0)) })?;
	runtime_status_from_code(resin_window_create(width, height, title:get().data, &owner:get().handle))?;
	(Window { owner = owner })
}

fn poll_events(self: Ref<Window>) -> (() | Err<RuntimeError>) {
	runtime_status_from_code(resin_window_poll_events(self:native()))
}

fn wait_events(self: Ref<Window>, timeout: f64) -> () | Err<RuntimeError> {
	runtime_status_from_code(resin_window_wait_events(self:native(), timeout))
}

fn should_close(self: Ref<Window>) -> bool {
	resin_window_should_close(self:native()) != 0
}

fn set_should_close(self: Ref<Window>, close: bool) -> (() | Err<RuntimeError>) {
	runtime_status_from_code(
		resin_window_set_should_close(
			self:native(),
			if (close) {
				1
			} else {
				0
			}
		)
	)
}

fn framebuffer_size(self: Ref<Window>) -> ((u32, u32) | Err<RuntimeError>) {
	let output = arc_ptr_alloc((u32(0), u32(0)))?;
	let values = output:get();
	runtime_status_from_code(resin_window_framebuffer_size(self:native(), &values.0, &values.1))?;
	((values.0, values.1))
}

fn set_size(self: Ref<Window>, width: u32, height: u32) -> (() | Err<RuntimeError>) {
	runtime_status_from_code(resin_window_set_size(self:native(), width, height))
}

fn key_pressed(self: Ref<Window>, key: i32) -> bool {
	resin_window_key_pressed(self:native(), key) != 0
}

fn key_state(self: Ref<Window>, key: i32) -> ButtonState {
	button_state(resin_window_key_state(self:native(), key))
}

fn mouse_button_state(self: Ref<Window>, button: i32) -> ButtonState {
	button_state(resin_window_mouse_button_state(self:native(), button))
}

fn cursor_position(self: Ref<Window>) -> ((f64, f64) | Err<RuntimeError>) {
	let output = arc_ptr_alloc((f64(0.0), f64(0.0)))?;
	let values = output:get();
	runtime_status_from_code(resin_window_cursor_position(self:native(), &values.0, &values.1))?;
	((values.0, values.1))
}

fn scroll_delta(self: Ref<Window>) -> ((f64, f64) | Err<RuntimeError>) {
	let output = arc_ptr_alloc((f64(0.0), f64(0.0)))?;
	let values = output:get();
	runtime_status_from_code(resin_window_scroll_delta(self:native(), &values.0, &values.1))?;
	((values.0, values.1))
}

fn focused(self: Ref<Window>) -> bool {
	resin_window_focused(self:native()) != 0
}

fn capture_cursor(self: Ref<Window>, capture: bool) -> (() | Err<RuntimeError>) {
	runtime_status_from_code(
		resin_window_capture_cursor(
			self:native(),
			if (capture) {
				1
			} else {
				0
			}
		)
	)
}

fn clone(value: Ref<Window>) -> Window {
	Window { owner = value.owner:clone() }
}
