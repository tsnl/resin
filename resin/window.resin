// GLFW physical key codes, independent of typed characters or keyboard layout.
// Each range starts at its GLFW value; gaps are intentional.
const key_unknown: int = -1;

const key_space: int = 32;

const key_apostrophe: int = 39;

const (
	key_comma: int = 44 + iota;
	key_minus: int = 44 + iota;
	key_period: int = 44 + iota;
	key_slash: int = 44 + iota;
);

