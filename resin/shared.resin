//! Shared and weak ownership of host allocations.
//! Value copies retain ownership; `get` borrows access without retaining it.

export { ArcPtr, ArcSpan, WeakPtr, WeakSpan, arc_ptr_alloc, get, downgrade, arc_span_alloc, weak_ptr_empty, upgrade, weak_span_empty, clone };

import { "status.resin", "span.resin" };

// Single-value allocation transfers ownership into the shared allocation.
// Repeated allocation requires implicitly copyable elements. Copying a shared
// handle retains the allocation; borrowed views do not extend its lifetime.
struct ArcPtr<T> {
	owner: StrongOwner,
}
/// Allocate one value and transfer it into shared host ownership.
/// Returns `Err<OutOfMemory>` if allocation fails.
fn arc_ptr_alloc<T>(initial: T) -> (ArcPtr<T> | Err<OutOfMemory>) {
	match (owner_create(initial)) {
		StrongOwner(owner) => {
			(ArcPtr<T> { owner = owner })
		},
		None => {
			Err(OutOfMemory {})
		},
	}
}

fn get<T>(self: Ref<ArcPtr<T>>) -> PtrMut<T> {
	owner_data::<T>(self.owner)
}

fn downgrade<T>(self: Ref<ArcPtr<T>>) -> WeakPtr<T> {
	WeakPtr<T> { owner = owner_downgrade(self.owner) }
}

struct ArcSpan<T> {
	owner: StrongOwner,
}
/// Allocate `count` elements initialized by copying `initial`.
/// Rejects overflowing allocation sizes and reports allocation failure.
fn arc_span_alloc<T>(count: u64, initial: T) -> (ArcSpan<T> | Err<OutOfMemory>) {
	match (owner_allocate(count, initial)) {
		StrongOwner(owner) => {
			(ArcSpan<T> { owner = owner })
		},
		None => {
			Err(OutOfMemory {})
		},
	}
}

fn get<T>(self: Ref<ArcSpan<T>>) -> SpanMut<T> {
	SpanMut<T> { data = owner_data::<T>(self.owner), length = owner_length(self.owner) }
}

fn downgrade<T>(self: Ref<ArcSpan<T>>) -> WeakSpan<T> {
	WeakSpan<T> { owner = owner_downgrade(self.owner) }
}

struct WeakPtr<T> {
	owner: WeakOwner,
}
fn weak_ptr_empty<T>() -> WeakPtr<T> {
	WeakPtr<T> { owner = weak_empty() }
}

fn upgrade<T>(self: Ref<WeakPtr<T>>) -> ArcPtr<T> | None {
	match (owner_upgrade(self.owner)) {
		StrongOwner(owner) => {
			ArcPtr<T> { owner = owner }
		},
		None => {
			None
		},
	}
}

struct WeakSpan<T> {
	owner: WeakOwner,
}
fn weak_span_empty<T>() -> WeakSpan<T> {
	WeakSpan<T> { owner = weak_empty() }
}

fn upgrade<T>(self: Ref<WeakSpan<T>>) -> ArcSpan<T> | None {
	match (owner_upgrade(self.owner)) {
		StrongOwner(owner) => {
			ArcSpan<T> { owner = owner }
		},
		None => {
			None
		},
	}
}

intrinsic "owner_create" fn owner_create<T>(initial: T) -> StrongOwner | None;
intrinsic "owner_allocate" fn owner_allocate<T>(count: u64, initial: T) -> StrongOwner | None;
intrinsic "owner_data" fn owner_data<T>(owner: Ref<StrongOwner>) -> PtrMut<T>;
intrinsic "owner_length" fn owner_length(owner: Ref<StrongOwner>) -> u64;
intrinsic "owner_downgrade" fn owner_downgrade(owner: Ref<StrongOwner>) -> WeakOwner;
intrinsic "owner_upgrade" fn owner_upgrade(owner: Ref<WeakOwner>) -> StrongOwner | None;
intrinsic "weak_empty" fn weak_empty() -> WeakOwner;

fn clone<T>(value: Ref<ArcPtr<T>>) -> ArcPtr<T> {
	ArcPtr<T> { owner = value.owner }
}

fn clone<T>(value: Ref<ArcSpan<T>>) -> ArcSpan<T> {
	ArcSpan<T> { owner = value.owner }
}

fn clone<T>(value: Ref<WeakPtr<T>>) -> WeakPtr<T> {
	WeakPtr<T> { owner = value.owner }
}

fn clone<T>(value: Ref<WeakSpan<T>>) -> WeakSpan<T> {
	WeakSpan<T> { owner = value.owner }
}
