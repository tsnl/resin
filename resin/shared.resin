export { ArcPtr, ArcSpan, WeakPtr, WeakSpan };

import { "status.resin", "span.resin" };

// The opaque handles retain on ordinary copies and release on destruction.
// Generic wrappers associate a payload type with those handles in source code.
// Allocation copies its initializer with the ordinary value rules. For native
// resource payloads, allocate an inert value and initialize through get().
struct ArcPtr<T> {
	owner: StrongOwner,
	def alloc(initial: T) -> Result<ArcPtr<T>, OutOfMemory> = {
		match (owner_allocate(1_ul, initial)) {
			StrongOwner(owner) => {
				ok(ArcPtr<T> { owner = owner })
			},
			None => {
				err(OutOfMemory {})
			},
		}
	};
	def get(self: Ptr<ArcPtr<T>>) -> Ptr<T> = {
		owner_data::<T>(&self.owner)
	};
	def downgrade(self: Ptr<ArcPtr<T>>) -> WeakPtr<T> = {
		WeakPtr<T> { owner = owner_downgrade(&self.owner) }
	};
};

struct ArcSpan<T> {
	owner: StrongOwner,
	def alloc(count: ulong, initial: T) -> Result<ArcSpan<T>, OutOfMemory> = {
		match (owner_allocate(count, initial)) {
			StrongOwner(owner) => {
				ok(ArcSpan<T> { owner = owner })
			},
			None => {
				err(OutOfMemory {})
			},
		}
	};
	def get(self: Ptr<ArcSpan<T>>) -> Span<T> = {
		Span<T> { data = owner_data::<T>(&self.owner), length = owner_length(&self.owner) }
	};
	def downgrade(self: Ptr<ArcSpan<T>>) -> WeakSpan<T> = {
		WeakSpan<T> { owner = owner_downgrade(&self.owner) }
	};
};

struct WeakPtr<T> {
	owner: WeakOwner,
	def empty() -> WeakPtr<T> = {
		WeakPtr<T> { owner = weak_empty() }
	};
	def upgrade(self: Ptr<WeakPtr<T>>) -> ArcPtr<T> | None = {
		match (owner_upgrade(&self.owner)) {
			StrongOwner(owner) => {
				ArcPtr<T> { owner = owner }
			},
			None => {
				None
			},
		}
	};
};

struct WeakSpan<T> {
	owner: WeakOwner,
	def empty() -> WeakSpan<T> = {
		WeakSpan<T> { owner = weak_empty() }
	};
	def upgrade(self: Ptr<WeakSpan<T>>) -> ArcSpan<T> | None = {
		match (owner_upgrade(&self.owner)) {
			StrongOwner(owner) => {
				ArcSpan<T> { owner = owner }
			},
			None => {
				None
			},
		}
	};
};

intrinsic "owner_allocate" def owner_allocate<T>(count: ulong, initial: T) -> StrongOwner | None;
intrinsic "owner_data" def owner_data<T>(owner: Ptr<StrongOwner>) -> Ptr<T>;
intrinsic "owner_length" def owner_length(owner: Ptr<StrongOwner>) -> ulong;
intrinsic "owner_downgrade" def owner_downgrade(owner: Ptr<StrongOwner>) -> WeakOwner;
intrinsic "owner_upgrade" def owner_upgrade(owner: Ptr<WeakOwner>) -> StrongOwner | None;
intrinsic "weak_empty" def weak_empty() -> WeakOwner;
