//! Raster primary visibility, then sequential secondary traces in a depth-one RT pipeline.
export { Camera, camera, Quality, quality, RasterRoot, TraceRoot, Hit, primary_vertex, primary_fragment, generation, miss, closest, ToneRoot, tone_map, camera_ray };
import { "scene.resin", "brdf.resin", "../gpu.resin", "../gltf.resin", "../graphics.resin", "../linalg.resin", "../math.resin", "../span.resin" };

struct Camera { transform: Mat4, focal_length: f32, sensor_size: Vec2, near: f32, far: f32, exposure: f32, gamma: f32 }
fn camera(transform: Mat4, aspect: f32) -> Camera {
	Camera { transform = transform, focal_length = 0.035, sensor_size = vec2(0.036, 0.036 / aspect), near = 0.01, far = 10000, exposure = 1, gamma = 2.2 }
}
struct Quality { samples_per_frame: u32, max_bounces: u32, denoise: bool }
fn quality() -> Quality {
	Quality { samples_per_frame = 1, max_bounces = 4, denoise = true }
}
struct RasterRoot<S> { scene: S, view_projection: Mat4, eye: Vec3 }
@vertex_shader
fn primary_vertex(index: i32, root: Ptr<RasterRoot<ShaderScene>>) -> Vertex {
	let vertex = root.scene.vertices:at(u64(index));
	let clip = mul(root.view_projection, vec4(vertex.position.x, vertex.position.y, vertex.position.z, 1));
	Vertex {
		position = Position { x = clip.x, y = clip.y, z = clip.z, w = clip.w },
		color = Color {
			r = f32((index / 3) % 4096),
			g = if (index % 3 == 1) {
				f32(1)
			} else {
				f32(0)
			},
			b = if (index % 3 == 2) {
				f32(1)
			} else {
				f32(0)
			},
			a = f32((index / 3) / 4096)
		}
	}
}
@fragment_shader
fn primary_fragment(weights: Color, root: Ptr<RasterRoot<ShaderScene>>) -> Color | None {
	// Two 12-bit components keep ID interpolation far from float rounding limits.
	let triangle = u32(weights.r + 0.5) + u32(weights.a + 0.5) * 4096;
	let surface = surface_at(root.scene, triangle, weights.g, weights.b);
	if (!accepts_surface(surface) || ((surface.flags & 4) == 0 && dot(surface.geometric, sub(root.eye, surface.position)) <= 0)) {
		None
	} else {
		Color { r = f32(triangle) + 1, g = weights.g, b = weights.b, a = 1 }
	}
}
struct TraceRoot<S, E, V, O> {
	scene: S,
	environment: E,
	visibility: V,
	radiance: O,
	positions: O,
	normals: O,
	camera: Camera,
	width: u32,
	height: u32,
	frame: u32,
	samples_per_frame: u32,
	max_bounces: u32,
}
struct Hit { distance: f32, triangle: u32, u: f32, v: f32 }
type ShaderTrace = TraceRoot<ShaderScene, ShaderEnvironment, Span<Vec4>, Span<Vec4>>;
@miss_shader
fn miss(initial: Hit, root: Ptr<ShaderTrace>) -> Hit {
	Hit { distance = 0, triangle = ~u32(0), u = 0, v = 0 }
}
@closest_hit_shader
fn closest(initial: Hit, root: Ptr<ShaderTrace>) -> Hit {
	let h = ray_hit_info();
	Hit { distance = h.0, triangle = h.1, u = h.3, v = h.4 }
}
fn visible_hit(scene: ShaderScene, origin: Vec3, direction: Vec3, state: RefMut<u32>) -> Hit {
	let mut minimum: f32 = 0.0001;
	while (true) {
		let hit = trace_ray(origin.x, origin.y, origin.z, direction.x, direction.y, direction.z, minimum, f32(1000000000000000000000000000000), Hit { distance = 0, triangle = ~u32(0), u = 0, v = 0 });
		if (hit.triangle == ~u32(0)) {
			return hit;
		};
		let surface = surface_at(scene, hit.triangle, hit.u, hit.v);
		let front = (surface.flags & 4) != 0 || dot(surface.geometric, direction) < 0;
		let coverage = (surface.flags & 2) == 0 || random(state) < surface.alpha;
		if (front && accepts_surface(surface) && coverage) {
			return hit;
		};
		// Masked intersections advance traversal without consuming a path bounce.
		minimum = max(hit.distance + 0.0001, hit.distance * 1.00001);
	};
	Hit { distance = 0, triangle = ~u32(0), u = 0, v = 0 }
}
fn orient(surface: Surface, outgoing: Vec3) -> Surface {
	let mut result = surface;
	if (dot(result.geometric, outgoing) < 0) {
		result.geometric = mul(result.geometric, -1);
		result.normal = mul(result.normal, -1);
	};
	if (dot(result.normal, outgoing) <= 0) {
		result.normal = result.geometric;
	};
	result
}
fn offset(surface: Surface) -> Vec3 {
	add(surface.position, mul(surface.geometric, 0.0001 * max(1, max(abs(surface.position.x), max(abs(surface.position.y), abs(surface.position.z))))))
}
fn integrate(root: Ptr<ShaderTrace>, first: Surface, state: RefMut<u32>) -> Vec3 {
	let eye = vec3(root.camera.transform.r0.w, root.camera.transform.r1.w, root.camera.transform.r2.w);
	let mut outgoing = normalized(sub(eye, first.position));
	let mut surface = orient(first, outgoing);
	let mut throughput = vec3(1, 1, 1);
	let mut radiance = surface.emission;
	let mut bounce: u32 = 0;
	while (bounce < root.max_bounces) {
		let light = environment_sample(root.environment, random(state), random(state), random(state));
		let value = bsdf_value(surface, outgoing, light.direction);
		if (light.pdf > 0 && luminance(value) > 0) {
			let shadow = visible_hit(root.scene, offset(surface), light.direction, state);
			if (shadow.triangle == ~u32(0)) {
				let weight = power_heuristic(light.pdf, bsdf_pdf(surface, outgoing, light.direction));
				let contribution = mul(mul(value, environment_value(root.environment, light.direction)), max(0, dot(surface.normal, light.direction)) * weight / light.pdf);
				radiance = add(radiance, mul(throughput, contribution));
			};
		};
		let sample = bsdf_sample(surface, outgoing, random(state), random(state), random(state));
		throughput = mul(throughput, sample.weight);
		if (luminance(throughput) <= 0 || sample.pdf <= 0) {
			break;
		};
		let hit = visible_hit(root.scene, offset(surface), sample.direction, state);
		if (hit.triangle == ~u32(0)) {
			let weight = power_heuristic(sample.pdf, environment_pdf(root.environment, sample.direction));
			radiance = add(radiance, mul(mul(throughput, environment_value(root.environment, sample.direction)), weight));
			break;
		};
		outgoing = mul(sample.direction, -1);
		surface = orient(surface_at(root.scene, hit.triangle, hit.u, hit.v), outgoing);
		radiance = add(radiance, mul(throughput, surface.emission));
		bounce = bounce + 1;
		if (bounce >= 3) {
			let survival = clamp(max(throughput.x, max(throughput.y, throughput.z)), 0.05, 0.95);
			if (random(state) >= survival) {
				break;
			};
			throughput = mul(throughput, 1 / survival);
		};
	};
	radiance
}
fn camera_ray(view: Camera, x: u32, y: u32, width: u32, height: u32) -> Vec3 {
	normalized(transform_direction(view.transform, vec3(((f32(x) + 0.5) / f32(width) - 0.5) * view.sensor_size.x, (0.5 - (f32(y) + 0.5) / f32(height)) * view.sensor_size.y, -view.focal_length)))
}
@ray_generation_shader
fn generation(index: u64, root: Ptr<ShaderTrace>) {
	if (index >= u64(root.width) * u64(root.height)) {
		return;
	};
	let visibility = root.visibility:at(index);
	let mut sum = vec3(0, 0, 0);
	if (visibility.x >= 0.5) {
		let triangle = u32(visibility.x) - 1;
		let surface = surface_at(root.scene, triangle, visibility.y, visibility.z);
		root.positions:at_mut(index) = vec4(surface.position.x, surface.position.y, surface.position.z, f32(triangle) + 1);
		let n = surface.normal;
		root.normals:at_mut(index) = vec4(n.x, n.y, n.z, 1);
		let mut state = u32(index) * 9781 + root.frame * 6271 + 17;
		let mut sample: u32 = 0;
		while (sample < root.samples_per_frame) {
			sum = add(sum, integrate(root, surface, state));
			sample = sample + 1;
		};
		sum = mul(sum, 1 / f32(root.samples_per_frame));
	} else {
		sum = environment_value(root.environment, camera_ray(root.camera, u32(index % u64(root.width)), u32(index / u64(root.width)), root.width, root.height));
		root.positions:at_mut(index) = vec4(0, 0, 0, 0);
		root.normals:at_mut(index) = vec4(0, 0, 0, 0);
	};
	root.radiance:at_mut(index) = vec4(sum.x, sum.y, sum.z, 1);
}
struct ToneRoot<I, O> { input: I, pixels: O, count: u64, exposure: f32, gamma: f32 }
fn display(value: f32, exposure: f32, gamma: f32) -> u8 {
	let x = max(value * exposure, 0);
	let mapped = x / (1 + x);
	u8(clamp(pow(mapped, 1 / gamma) * 255 + 0.5, 0, 255))
}
@compute_shader
fn tone_map(index: u64, root: Ptr<ToneRoot<Span<Vec4>, Span<u8>>>) {
	if (index < root.count) {
		let color = root.input:at(index);
		root.pixels:at_mut(index * 4) = display(color.x, root.exposure, root.gamma);
		root.pixels:at_mut(index * 4 + 1) = display(color.y, root.exposure, root.gamma);
		root.pixels:at_mut(index * 4 + 2) = display(color.z, root.exposure, root.gamma);
		root.pixels:at_mut(index * 4 + 3) = 255;
	};
}
