//! Owned strings, formatting, and value representations.
//! These operations run on the host.

export { String, fmt, repr, string_from_str, string_from_bytes, get, repr_bytes, bytes, clone };

import { "span.resin", "shared.resin" };

// Logical bytes exclude the trailing NUL reserved for native string APIs.
struct String {
	storage: ArcSpan<ubyte>,
}
fn string_from_str(text: str) -> String {
	String { storage = ArcSpan<ubyte> { owner = string_from_bytes(text.data, text.length) } }
}

fn string_from_bytes(text: Ref<Span<ubyte>>) -> String {
	String { storage = ArcSpan<ubyte> { owner = string_from_bytes(text.data, text.length) } }
}

fn get(self: Ref<String>) -> Span<ubyte> {
	self.storage:get()
}

// A borrowed text view for repr and automatic formatting.
fn repr_bytes(self: Ref<String>) -> (Ptr<ubyte>, ulong) {
	self:bytes()
}

// Explicit transport for formatting tuple arguments.
fn bytes(self: Ref<String>) -> (Ptr<ubyte>, ulong) {
	let view = self:get();
	(view.data, view.length)
}

fn fmt<A>(format: str, arguments: A) -> String {
	String { storage = ArcSpan<ubyte> { owner = format_bytes(format.data, format.length, arguments) } }
}

fn fmt<A>(format: Ref<Span<ubyte>>, arguments: A) -> String {
	String { storage = ArcSpan<ubyte> { owner = format_bytes(format.data, format.length, arguments) } }
}

fn fmt<A>(format: Ref<String>, arguments: A) -> String {
	fmt(format:get(), arguments)
}

intrinsic "string_from_bytes" fn string_from_bytes(data: Ptr<ubyte>, length: ulong) -> StrongOwner;
intrinsic "format_bytes" fn format_bytes<A>(data: Ptr<ubyte>, length: ulong, arguments: A) -> StrongOwner;

// An owned, readable representation; strings are quoted and escaped.
fn repr<T>(value: T) -> String {
	String { storage = ArcSpan<ubyte> { owner = repr_value(value) } }
}
intrinsic "repr" fn repr_value<T>(value: T) -> StrongOwner;

fn clone(value: Ref<String>) -> String {
	String { storage = value.storage:clone() }
}
