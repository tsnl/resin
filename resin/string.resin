export { String, fmt, print };

extern {
	"resin_runtime/print.h": {
		def resin_print(data: Ptr<ubyte>, length: ulong);
	},
};

import { "span.resin", "shared.resin" };

// Logical bytes exclude the trailing NUL reserved for native string APIs.
struct String {
	storage: ArcSpan<ubyte>,
	def from_str(text: str) -> String = {
		String { storage = ArcSpan<ubyte> { owner = string_from_bytes(text.data, text.length) } }
	};
	def from_bytes(text: Span<ubyte>) -> String = {
		String { storage = ArcSpan<ubyte> { owner = string_from_bytes(text.data, text.length) } }
	};
	def get(self: Ptr<String>) -> Span<ubyte> = {
		self.storage.get()
	};
	// Explicit transport for formatting tuple arguments.
	def bytes(self: Ptr<String>) -> { data: Ptr<ubyte>, length: ulong } = {
		var view = self.get();
		{ data = view.data, length = view.length }
	};
};

def fmt<A>(format: str | Span<ubyte> | String, arguments: A) -> String = {
	var owner = match (format) {
		str(text) => {
			format_bytes(text.data, text.length, arguments)
		},
		Span<ubyte>(text) => {
			format_bytes(text.data, text.length, arguments)
		},
		String(text) => {
			var view = text.get();
			format_bytes(view.data, view.length, arguments)
		},
	};
	String { storage = ArcSpan<ubyte> { owner = owner } }
};

// Writes bytes verbatim, flushes, and adds no newline.
def print(text: str | Span<ubyte> | String) = {
	match (text) {
		str(value) => {
			resin_print(value.data, value.length)
		},
		Span<ubyte>(value) => {
			resin_print(value.data, value.length)
		},
		String(value) => {
			var view = value.get();
			resin_print(view.data, view.length)
		},
	}
};

intrinsic "string_from_bytes" def string_from_bytes(data: Ptr<ubyte>, length: ulong) -> StrongOwner;
intrinsic "format_bytes" def format_bytes<A>(data: Ptr<ubyte>, length: ulong, arguments: A) -> StrongOwner;
