// Streaming option parser. The specification lists spellings separated by spaces:
// "--help|-h --verbose|-v --output|-o= --count=". A trailing '=' requires a value.
// Values accept '--count 12' or '--count=12'; aliases return the first spelling.
// Repeated options are yielded in order, so the caller can implement last-wins.
// There are no positional arguments or bundled short flags. Values may start '-'.
// Views borrow argv and the literal specification; keep both alive while using them.
export { ArgParser, Argument, argparse, next, named, argument_integer, argument_number };

extern {
	"stdlib.h": {
		fn strtod(text: Ptr<ubyte>, end: Ptr<Ptr<ubyte>>) -> float64;
	},
};

import { "process.resin", "span.resin", "string.resin" };

struct ArgParser {
	args: Span<Ptr<ubyte>>,
	specification: str,
	index: ulong,
}

struct Argument {
	name: Span<ubyte>,
	// Flags have an empty value. Values remain NUL-terminated views into argv.
	value: Span<ubyte>,
}

fn argparse(args: Ref<Span<Ptr<ubyte>>>, specification: str) -> ArgParser {
	ArgParser { args = args:clone(), specification = specification, index = 1_ul }
}

fn equal(left: Ref<Span<ubyte>>, right: Ref<Span<ubyte>>) -> bool {
	if (left.length != right.length) {
		return false;
	};
	let mut i = 0_ul;
	while (i < left.length) {
		if (left:at(i) != right:at(i)) {
			return false;
		};
		i = i + 1_ul;
	};
	true
}

fn named(self: Ref<Argument>, name: str) -> bool {
	equal(self.name, bytes(name))
}

fn delimiter(text: Ref<Span<ubyte>>, start: ulong, byte: ubyte) -> ulong {
	let mut i = start;
	while (i < text.length && text:at(i) != byte) {
		i = i + 1_ul;
	};
	i
}

// Find a spelling inside one specification token, excluding its trailing '='.
fn matches(token: Ref<Span<ubyte>>, name: Ref<Span<ubyte>>) -> bool {
	let mut start = 0_ul;
	while (start < token.length) {
		let end = delimiter(token, start, 124_ub);
		if (equal(token:slice(start, end - start), name)) {
			return true;
		};
		start = end + 1_ul;
	};
	false
}

fn next(self: Ref<ArgParser>) -> Argument | None | Err<String> {
	if (self.index >= self.args.length) {
		return None;
	};
	let text = argument(self.args, self.index);
	self.index = self.index + 1_ul;
	let separator = delimiter(text, 0_ul, 61_ub);
	let name = text:slice(0_ul, separator);
	let spec = bytes(self.specification);
	let mut start = 0_ul;
	while (start < spec.length) {
		let end = delimiter(spec, start, 32_ub);
		if (end > start) {
			let takes_value = spec:at(end - 1_ul) == 61_ub;
			let length = end - start - if (takes_value) {
				1_ul
			} else {
				0_ul
			};
			let token = spec:slice(start, length);
			if (matches(token, name)) {
				let canonical = token:slice(0_ul, delimiter(token, 0_ul, 124_ub));
				let value = self:read_value(text, separator, takes_value)?;
				return Argument { name = canonical, value = value };
			};
		};
		start = end + 1_ul;
	};
	Err(fmt("Unknown option: {0}", (name:bytes(),)))
}

fn read_value(self: Ref<ArgParser>, text: Ref<Span<ubyte>>, separator: ulong, required: bool) -> Span<ubyte> | Err<String> {
	if (separator < text.length) {
		if (!required) {
			return Err(fmt("Flag does not take a value: {0}", (text:bytes(),)));
		};
		return text:slice(separator + 1_ul, text.length - separator - 1_ul);
	};
	if (!required) {
		return text:slice(text.length, 0_ul);
	};
	if (self.index == self.args.length) {
		return Err(fmt("Missing value for {0}", (text:bytes(),)));
	};
	let value = argument(self.args, self.index);
	self.index = self.index + 1_ul;
	value
}

fn argument_integer(text: Ref<Span<ubyte>>) -> uint | Err<String> {
	let mut value = 0_ui;
	let mut i = 0_ul;
	if (text.length == 0_ul) {
		return Err(string_from_str("Expected an integer, got an empty value"));
	};
	while (i < text.length) {
		let byte = text:at(i);
		if (byte < 48_ub || byte > 57_ub || value > 429496729_ui || (value == 429496729_ui && byte > 53_ub)) {
			return Err(fmt("Invalid integer: {0}", (text:bytes(),)));
		};
		value = value * 10_ui + uint(byte - 48_ub);
		i = i + 1_ul;
	};
	value
}

// Copy exactly the bounded view before calling C; embedded NULs/trailing bytes fail.
fn argument_number(text: Ref<Span<ubyte>>) -> float32 | Err<String> {
	let terminated = string_from_bytes(text);
	let data = terminated:get().data;
	let mut end = Ptr<ubyte>(0_ul);
	let value = strtod(data, &end);
	if (text.length == 0_ul || ulong(end) - ulong(data) != text.length || !(value >= -3.4e38_d && value <= 3.4e38_d)) {
		return Err(fmt("Invalid finite number: {0}", (text:bytes(),)));
	};
	float32(value)
}
