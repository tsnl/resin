//! GPU ownership, typed pipelines, allocations, and command recording.
//! Submission waits for recorded work; borrowed shader views do not own host resources.

export { GpuRayScene, GpuRayTracingPipeline, create_ray_scene, create_ray_tracing_pipeline, supports_ray_tracing, trace_rays, trace_ray, ray_hit_info, Gpu, GpuPtr, GpuPtrMut, GpuSpan, GpuSpanMut, GpuComputePipeline, GpuGraphicsPipeline, GpuImage, GpuPipelineOwner, GpuCommands, memory_default, memory_gpu, memory_readback, ResinGpu, ResinGpuDeviceInfo, ResinImage, ResinPipeline, ResinCommandBuffer, load, store, replace, slice, read_only, write_only, at, copy_to, copy_from, native, compute_workgroup_size, gpu_device_count, gpu_enumerate_devices, gpu_new, gpu_new_at, gpu_new_for_window, create, alloc, alloc_in, malloc, create_compute_pipeline, create_graphics_pipeline, create_image, start_command_recording, present, width, height, context, dispatch, begin_rendering, end_rendering, draw, copy_image_to_buffer, submit, cancel, clone };

extern {
	"resin_runtime.h": {
		fn resin_gpu_supports_ray_tracing(gpu: PtrMut<ResinGpu>) -> u32;
		fn resin_gpu_create_ray_scene(gpu: PtrMut<ResinGpu>, vertices: PtrMut<f32>, vertex_count: u32, transforms: PtrMut<f32>, instance_count: u32, scene: PtrMut<PtrMut<ResinRayScene>>) -> i32;
		fn resin_gpu_free_ray_scene(scene: PtrMut<ResinRayScene>);
		fn resin_gpu_create_ray_pipeline(gpu: PtrMut<ResinGpu>, scene: PtrMut<ResinRayScene>, generation: Ptr<u8>, generation_length: u64, miss: Ptr<u8>, miss_length: u64, hit: Ptr<u8>, hit_length: u64, pipeline: PtrMut<PtrMut<ResinPipeline>>) -> i32;
		fn resin_gpu_device_count(count: PtrMut<u32>) -> i32;
		fn resin_gpu_enumerate_devices(infos: PtrMut<ResinGpuDeviceInfo>, count: u32) -> i32;
		fn resin_gpu_create(gpu: PtrMut<PtrMut<ResinGpu>>) -> i32;
		fn resin_gpu_create_at(index: u32, gpu: PtrMut<PtrMut<ResinGpu>>) -> i32;
		fn resin_gpu_destroy(gpu: PtrMut<ResinGpu>) -> ();
		fn resin_gpu_compute_workgroup_size(gpu: PtrMut<ResinGpu>) -> u32;
		fn resin_gpu_create_compute_pipeline(gpu: PtrMut<ResinGpu>, code: Ptr<u8>, length: u64, pipeline: PtrMut<PtrMut<ResinPipeline>>) -> i32;
		fn resin_gpu_create_graphics_pipeline(gpu: PtrMut<ResinGpu>, vertex: Ptr<u8>, vertex_length: u64, fragment: Ptr<u8>, fragment_length: u64, pipeline: PtrMut<PtrMut<ResinPipeline>>) -> i32;
		fn resin_gpu_free_pipeline(gpu: PtrMut<ResinGpu>, pipeline: PtrMut<ResinPipeline>) -> ();
		fn resin_gpu_create_image(gpu: PtrMut<ResinGpu>, width: u32, height: u32, image: PtrMut<PtrMut<ResinImage>>) -> i32;
		fn resin_gpu_free_image(gpu: PtrMut<ResinGpu>, image: PtrMut<ResinImage>) -> ();
		fn resin_image_width(image: PtrMut<ResinImage>) -> u32;
		fn resin_image_height(image: PtrMut<ResinImage>) -> u32;
		fn resin_gpu_start_command_recording(gpu: PtrMut<ResinGpu>, commands: PtrMut<PtrMut<ResinCommandBuffer>>) -> i32;
		fn resin_gpu_set_pipeline(commands: PtrMut<ResinCommandBuffer>, pipeline: PtrMut<ResinPipeline>) -> i32;
		fn resin_gpu_begin_rendering(commands: PtrMut<ResinCommandBuffer>, image: PtrMut<ResinImage>, r: f32, g: f32, b: f32, a: f32) -> i32;
		fn resin_gpu_end_rendering(commands: PtrMut<ResinCommandBuffer>) -> i32;
		fn resin_gpu_draw(commands: PtrMut<ResinCommandBuffer>, root: u64, count: u32) -> i32;
		fn resin_gpu_submit(gpu: PtrMut<ResinGpu>, commands: PtrMut<ResinCommandBuffer>) -> i32;
		fn resin_gpu_cancel_command_buffer(gpu: PtrMut<ResinGpu>, commands: PtrMut<ResinCommandBuffer>) -> ();
		fn resin_gpu_create_for_window(window: PtrMut<ResinWindow>, gpu: PtrMut<PtrMut<ResinGpu>>) -> i32;
		fn resin_gpu_present(gpu: PtrMut<ResinGpu>, image: PtrMut<ResinImage>) -> i32;
	},
};

import { "status.resin", "internal/status_codes.resin", "window.resin", "shared.resin", "span.resin" };

extern type ResinRayScene;

// ResinMemory values from resin_runtime/gpu.h.
const (
	memory_default: i32 = iota;
	memory_gpu: i32 = iota;
	memory_readback: i32 = iota;
);

// Resin GPU view permissions from resin_runtime/gpu.h.
const (
	access_read: u32 = 1 << iota;
	access_write: u32 = 1 << iota;
);
const max_allocation_bytes = ~u64(0);
// A pointer view derives its available capacity from the retained allocation.
const allocation_capacity = ~u64(0);

extern type ResinGpu;
extern type ResinGpuDeviceInfo;
extern type ResinImage;
extern type ResinPipeline;
extern type ResinCommandBuffer;

// GPU views retain their allocation. Mut permits writes, without unique borrowing.
// Source wrappers project to borrowed physical pointers and spans for shaders.
/// A retained, read-only view of one GPU value.
struct GpuPtr<T> {
	view: GpuView,
}
/// A retained, read-only range of GPU elements.
struct GpuSpan<T> {
	data: GpuPtr<T>,
	length: u64,
}

intrinsic "gpu_pointer_projection" fn pointer_projection<T>(value: GpuPtr<T>) -> Ptr<T>;
intrinsic "gpu_span_projection" fn span_projection<T>(value: GpuSpan<T>) -> Span<T>;

fn load<T>(self: Ref<GpuPtr<T>>) -> T {
	gpu_view_load::<T>(self.view)
}
fn load<T>(self: Ref<GpuSpan<T>>, index: u64) -> T {
	let value = self:at(index);
	value:load()
}

fn slice<T>(self: Ref<GpuPtr<T>>, start: u64, length: u64) -> GpuSpan<T> {
	GpuSpan<T> { data = GpuPtr<T> { view = gpu_view_range::<T>(self.view, allocation_capacity, start, length) }, length = length }
}

fn at<T>(self: Ref<GpuSpan<T>>, index: u64) -> GpuPtr<T> {
	GpuPtr<T> { view = gpu_view_range::<T>(self.data.view, self.length, index, u64(1)) }
}

fn slice<T>(self: Ref<GpuSpan<T>>, start: u64, length: u64) -> GpuSpan<T> {
	GpuSpan<T> { data = GpuPtr<T> { view = gpu_view_range::<T>(self.data.view, self.length, start, length) }, length = length }
}

fn copy_to<T>(self: Ref<GpuSpan<T>>, destination: SpanMut<T>) {
	gpu_view_copy_to(self.data.view, self.length, destination.data, destination.length);
}

fn clone<T>(value: Ref<GpuPtr<T>>) -> GpuPtr<T> {
	GpuPtr<T> { view = value.view }
}
fn clone<T>(value: Ref<GpuSpan<T>>) -> GpuSpan<T> {
	GpuSpan<T> { data = value.data, length = value.length }
}

/// A retained, writable view of one GPU value. Aliases may share the allocation.
struct GpuPtrMut<T> {
	view: GpuView,
}
/// A retained, writable range of GPU elements.
struct GpuSpanMut<T> {
	data: GpuPtrMut<T>,
	length: u64,
}

intrinsic "gpu_pointer_projection" fn pointer_projection<T>(value: GpuPtrMut<T>) -> PtrMut<T>;
intrinsic "gpu_span_projection" fn span_projection<T>(value: GpuSpanMut<T>) -> SpanMut<T>;

fn load<T>(self: Ref<GpuPtrMut<T>>) -> T {
	gpu_view_load::<T>(self.view)
}
fn load<T>(self: Ref<GpuSpanMut<T>>, index: u64) -> T {
	let value = self:at(index);
	value:load()
}

fn slice<T>(self: Ref<GpuPtrMut<T>>, start: u64, length: u64) -> GpuSpanMut<T> {
	GpuSpanMut<T> { data = GpuPtrMut<T> { view = gpu_view_range::<T>(self.view, allocation_capacity, start, length) }, length = length }
}

fn at<T>(self: Ref<GpuSpanMut<T>>, index: u64) -> GpuPtrMut<T> {
	GpuPtrMut<T> { view = gpu_view_range::<T>(self.data.view, self.length, index, u64(1)) }
}

fn slice<T>(self: Ref<GpuSpanMut<T>>, start: u64, length: u64) -> GpuSpanMut<T> {
	GpuSpanMut<T> { data = GpuPtrMut<T> { view = gpu_view_range::<T>(self.data.view, self.length, start, length) }, length = length }
}

fn copy_to<T>(self: Ref<GpuSpanMut<T>>, destination: SpanMut<T>) {
	gpu_view_copy_to(self.data.view, self.length, destination.data, destination.length);
}

fn store<T>(self: Ref<GpuPtrMut<T>>, value: T) {
	gpu_view_store(self.view, value);
}
fn store<T>(self: Ref<GpuSpanMut<T>>, index: u64, value: T) {
	let destination = self:at(index);
	destination:store(value);
}

fn replace<T>(self: Ref<GpuPtrMut<T>>, value: T) -> T {
	gpu_view_replace(self.view, value)
}

fn copy_from<T>(self: Ref<GpuSpanMut<T>>, source: Span<T>) {
	gpu_view_copy_from(self.data.view, self.length, source.data, source.length);
}

/// Retain a read-only view without changing other aliases.
fn read_only<T>(self: Ref<GpuPtrMut<T>>) -> GpuPtr<T> {
	GpuPtr<T> { view = gpu_view_restrict(self.view, access_read) }
}

/// Retain a read-only range without changing other aliases.
fn read_only<T>(self: Ref<GpuSpanMut<T>>) -> GpuSpan<T> {
	GpuSpan<T> { data = self.data:read_only(), length = self.length }
}

/// Restrict this view at runtime; loading from it traps.
fn write_only<T>(self: Ref<GpuPtrMut<T>>) -> GpuPtrMut<T> {
	GpuPtrMut<T> { view = gpu_view_restrict(self.view, access_write) }
}

/// Restrict this view at runtime; loading from it traps.
fn write_only<T>(self: Ref<GpuSpanMut<T>>) -> GpuSpanMut<T> {
	GpuSpanMut<T> { data = self.data:write_only(), length = self.length }
}

struct GpuComputePipeline<Root, Owner> {
	contract: GpuPipelineContract,
}
struct GpuGraphicsPipeline<Root, Owner> {
	contract: GpuPipelineContract,
}
intrinsic "gpu_compute_pipeline_type" fn compute_type<Root, Owner>(contract: GpuPipelineContract) -> GpuComputePipeline<Root, Owner>;
intrinsic "gpu_graphics_pipeline_type" fn graphics_type<Root, Owner>(contract: GpuPipelineContract) -> GpuGraphicsPipeline<Root, Owner>;

struct GpuOwner {
	handle: PtrMut<ResinGpu>,
	window: Window | None,
}
fn drop(self: RefMut<GpuOwner>) {
	if (u64(self.handle) != u64(0)) {
		resin_gpu_destroy(self.handle);
	};
}

struct Gpu {
	owner: ArcPtr<GpuOwner>,
}
fn native(self: Ref<Gpu>) -> PtrMut<ResinGpu> {
	self.owner:get().handle
}

fn compute_workgroup_size(self: Ref<Gpu>) -> u64 {
	u64(resin_gpu_compute_workgroup_size(self:native()))
}

fn gpu_device_count() -> (u32 | Err<RuntimeError>) {
	let count = arc_ptr_alloc(u32(0))?;
	runtime_status_from_code(resin_gpu_device_count(count:get()))?;
	count:get().*
}

fn gpu_enumerate_devices(infos: PtrMut<ResinGpuDeviceInfo>, count: u32) -> (() | Err<RuntimeError>) {
	runtime_status_from_code(resin_gpu_enumerate_devices(infos, count))
}

fn gpu_new() -> (Gpu | Err<RuntimeError>) {
	let mut owner = arc_ptr_alloc::<GpuOwner>(GpuOwner { handle = PtrMut<ResinGpu>(u64(0)), window = None })?;
	runtime_status_from_code(resin_gpu_create(&owner:get().handle))?;
	(Gpu { owner = owner })
}

fn gpu_new_at(index: u32) -> (Gpu | Err<RuntimeError>) {
	let mut owner = arc_ptr_alloc::<GpuOwner>(GpuOwner { handle = PtrMut<ResinGpu>(u64(0)), window = None })?;
	runtime_status_from_code(resin_gpu_create_at(index, &owner:get().handle))?;
	(Gpu { owner = owner })
}

fn gpu_new_for_window(window: Ref<Window>) -> (Gpu | Err<RuntimeError>) {
	let mut owner = arc_ptr_alloc::<GpuOwner>(GpuOwner { handle = PtrMut<ResinGpu>(u64(0)), window = window:clone() })?;
	runtime_status_from_code(resin_gpu_create_for_window(window:native(), &owner:get().handle))?;
	(Gpu { owner = owner })
}

fn create<T>(self: Ref<Gpu>, initial: T) -> (GpuPtrMut<T> | Err<RuntimeError>) {
	let mut allocated = self:alloc::<T>(u64(1))?;
	allocated.data:store(initial);
	(allocated.data)
}

fn alloc<T>(self: Ref<Gpu>, count: u64) -> (GpuSpanMut<T> | Err<RuntimeError>) {
	self:alloc_in::<T>(count, memory_default)
}

fn alloc_in<T>(self: Ref<Gpu>, count: u64, memory: i32) -> (GpuSpanMut<T> | Err<RuntimeError>) {
	let mut size = size_of(T);
	if (count > max_allocation_bytes / size) {
		return Err(OutOfMemory {});
	};
	let mut view = self:malloc(count * size, align_of(T), memory)?;
	(GpuSpanMut<T> { data = GpuPtrMut<T> { view = gpu_view_range::<T>(view, count, u64(0), count) }, length = count })
}

@gpu_allocator
fn malloc(self: Ref<Gpu>, bytes: u64, alignment: u64, memory: i32) -> (GpuView | Err<RuntimeError>) {
	let mut allocation = gpu_view_allocate(self:native(), self.owner.owner, bytes, alignment, memory);
	runtime_status_from_code(allocation.1)?;
	(allocation.0!)
}

@gpu_compute_pipeline
fn create_compute_pipeline(self: Ref<Gpu>, code: (Ptr<u8>, u64)) -> (GpuPipelineOwner | Err<RuntimeError>) {
	let mut owner = arc_ptr_alloc::<PipelineOwner>(PipelineOwner { handle = PtrMut<ResinPipeline>(u64(0)), gpu = self:clone() })?;
	runtime_status_from_code(resin_gpu_create_compute_pipeline(self:native(), code.0, code.1, &owner:get().handle))?;
	(GpuPipelineOwner { owner = owner })
}

@gpu_graphics_pipeline
fn create_graphics_pipeline(self: Ref<Gpu>, vertex: (Ptr<u8>, u64), fragment: (Ptr<u8>, u64)) -> (GpuPipelineOwner | Err<RuntimeError>) {
	let mut owner = arc_ptr_alloc::<PipelineOwner>(PipelineOwner { handle = PtrMut<ResinPipeline>(u64(0)), gpu = self:clone() })?;
	runtime_status_from_code(resin_gpu_create_graphics_pipeline(self:native(), vertex.0, vertex.1, fragment.0, fragment.1, &owner:get().handle))?;
	(GpuPipelineOwner { owner = owner })
}

fn create_image(self: Ref<Gpu>, width: u32, height: u32) -> (GpuImage | Err<RuntimeError>) {
	let mut owner = arc_ptr_alloc::<ImageOwner>(ImageOwner { handle = PtrMut<ResinImage>(u64(0)), gpu = self:clone() })?;
	runtime_status_from_code(resin_gpu_create_image(self:native(), width, height, &owner:get().handle))?;
	(GpuImage { owner = owner })
}

fn start_command_recording(self: Ref<Gpu>) -> (GpuCommands | Err<RuntimeError>) {
	let mut owner = arc_ptr_alloc::<CommandsOwner>(CommandsOwner { handle = PtrMut<ResinCommandBuffer>(u64(0)), gpu = self:clone(), retained = None })?;
	runtime_status_from_code(resin_gpu_start_command_recording(self:native(), &owner:get().handle))?;
	(GpuCommands { owner = owner })
}

fn present(self: Ref<Gpu>, image: Ref<GpuImage>) -> (bool | Err<RuntimeError>) {
	let mut code = resin_gpu_present(self:native(), image:native());
	if (code == status_incomplete) {
		(1 == 0)
	} else {
		runtime_status_from_code(code)?;
		(1 == 1)
	}
}

struct ImageOwner {
	handle: PtrMut<ResinImage>,
	gpu: Gpu,
}
fn drop(self: RefMut<ImageOwner>) {
	if (u64(self.handle) != u64(0)) {
		resin_gpu_free_image(self.gpu:native(), self.handle);
	};
}

struct GpuImage {
	owner: ArcPtr<ImageOwner>,
}
fn native(self: Ref<GpuImage>) -> PtrMut<ResinImage> {
	self.owner:get().handle
}

fn width(self: Ref<GpuImage>) -> u32 {
	resin_image_width(self:native())
}

fn height(self: Ref<GpuImage>) -> u32 {
	resin_image_height(self:native())
}

struct PipelineOwner {
	handle: PtrMut<ResinPipeline>,
	gpu: Gpu,
}
fn drop(self: RefMut<PipelineOwner>) {
	if (u64(self.handle) != u64(0)) {
		resin_gpu_free_pipeline(self.gpu:native(), self.handle);
	};
}

struct GpuPipelineOwner {
	owner: ArcPtr<PipelineOwner>,
}
fn native(self: Ref<GpuPipelineOwner>) -> PtrMut<ResinPipeline> {
	self.owner:get().handle
}

@gpu_pipeline_context
fn context(self: Ref<GpuPipelineOwner>) -> Ref<Gpu> {
	self.owner:get().gpu
}

// Allocate retention nodes before recording native commands, so an allocation
// failure cannot leave commands borrowing resources that have already expired.
struct RecordedResources {
	pipeline: GpuPipelineOwner | None,
	image: GpuImage | None,
	previous: ArcPtr<RecordedResources> | None,
}
struct CommandsOwner {
	handle: PtrMut<ResinCommandBuffer>,
	gpu: Gpu,
	retained: ArcPtr<RecordedResources> | None,
}
fn drop(self: RefMut<CommandsOwner>) {
	if (u64(self.handle) != u64(0)) {
		resin_gpu_cancel_command_buffer(self.gpu:native(), self.handle);
	};
}

fn retain(self: PtrMut<CommandsOwner>, pipeline: GpuPipelineOwner | None, image: GpuImage | None) -> (() | Err<OutOfMemory>) {
	let node = arc_ptr_alloc::<RecordedResources>(RecordedResources { pipeline = pipeline, image = image, previous = None })?;
	node:get().previous = replace(&self.retained, None);
	self.retained = node;
	(())
}

struct GpuCommands {
	owner: ArcPtr<CommandsOwner>,
}
fn native(self: Ref<GpuCommands>) -> PtrMut<ResinCommandBuffer> {
	self.owner:get().handle
}

@gpu_dispatch
fn dispatch(self: Ref<GpuCommands>, pipeline: Ref<GpuPipelineOwner>, root: GpuArguments, x: u32, y: u32, z: u32) -> (() | Err<RuntimeError>) {
	self.owner:get():retain(pipeline:clone(), None)?;
	runtime_status_from_code(resin_gpu_set_pipeline(self:native(), pipeline:native()))?;
	runtime_status_from_code(root:dispatch_native(PtrMut<u8>(self:native()), x, y, z))
}

fn begin_rendering(self: Ref<GpuCommands>, image: Ref<GpuImage>, r: f32, g: f32, b: f32, a: f32) -> (() | Err<RuntimeError>) {
	self.owner:get():retain(None, image:clone())?;
	runtime_status_from_code(resin_gpu_begin_rendering(self:native(), image:native(), r, g, b, a))
}

fn end_rendering(self: Ref<GpuCommands>) -> (() | Err<RuntimeError>) {
	runtime_status_from_code(resin_gpu_end_rendering(self:native()))
}

@gpu_draw
fn draw(self: Ref<GpuCommands>, pipeline: Ref<GpuPipelineOwner>, root: GpuArguments | None, count: u32) -> (() | Err<RuntimeError>) {
	self.owner:get():retain(pipeline:clone(), None)?;
	runtime_status_from_code(resin_gpu_set_pipeline(self:native(), pipeline:native()))?;
	match (root) {
		GpuArguments(arguments) => {
			runtime_status_from_code(arguments:draw_native(PtrMut<u8>(self:native()), count))
		},
		None => {
			runtime_status_from_code(resin_gpu_draw(self:native(), u64(0), count))
		},
	}
}

fn copy_image_to_buffer(self: Ref<GpuCommands>, image: Ref<GpuImage>, buffer: Ref<GpuSpanMut<u8>>) -> (() | Err<RuntimeError>) {
	self.owner:get():retain(None, image:clone())?;
	runtime_status_from_code(gpu_view_copy_image(buffer.data.view, buffer.length, PtrMut<u8>(self:native()), PtrMut<u8>(image:native())))
}

fn submit(self: Ref<GpuCommands>) -> (() | Err<RuntimeError>) {
	let mut state = self.owner:get();
	let mut recording = (&state.handle):replace(PtrMut<ResinCommandBuffer>(u64(0)));
	let mut code = resin_gpu_submit(state.gpu:native(), recording);
	state.retained = None;
	runtime_status_from_code(code)
}

fn cancel(self: Ref<GpuCommands>) {
	let mut state = self.owner:get();
	let mut recording = (&state.handle):replace(PtrMut<ResinCommandBuffer>(u64(0)));
	resin_gpu_cancel_command_buffer(state.gpu:native(), recording);
	state.retained = None;
}

intrinsic "gpu_view_allocate" fn gpu_view_allocate<N>(gpu: PtrMut<N>, owner: StrongOwner, bytes: u64, alignment: u64, memory: i32) -> (GpuView | None, i32);
intrinsic "gpu_view_replace" fn gpu_view_replace<T>(view: GpuView, value: T) -> T;
intrinsic "gpu_view_range" fn gpu_view_range<T>(view: GpuView, capacity: u64, start: u64, length: u64) -> GpuView;
intrinsic "gpu_view_copy_to" fn gpu_view_copy_to<T>(view: GpuView, count: u64, destination: PtrMut<T>, capacity: u64) -> ();
intrinsic "gpu_view_restrict" fn gpu_view_restrict(view: GpuView, mask: u32) -> GpuView;
intrinsic "gpu_view_copy_from" fn gpu_view_copy_from<T>(view: GpuView, capacity: u64, source: Ptr<T>, count: u64) -> ();
intrinsic "gpu_view_copy_image" fn gpu_view_copy_image(view: GpuView, length: u64, commands: PtrMut<u8>, image: PtrMut<u8>) -> i32;

fn clone(value: Ref<Gpu>) -> Gpu {
	Gpu { owner = value.owner:clone() }
}

fn clone(value: Ref<GpuImage>) -> GpuImage {
	GpuImage { owner = value.owner:clone() }
}

fn clone(value: Ref<GpuPipelineOwner>) -> GpuPipelineOwner {
	GpuPipelineOwner { owner = value.owner:clone() }
}

fn clone(value: Ref<GpuCommands>) -> GpuCommands {
	GpuCommands { owner = value.owner:clone() }
}

fn clone<T>(value: Ref<GpuPtrMut<T>>) -> GpuPtrMut<T> {
	GpuPtrMut<T> { view = value.view }
}

fn clone<T>(value: Ref<GpuSpanMut<T>>) -> GpuSpanMut<T> {
	GpuSpanMut<T> { data = value.data:clone(), length = value.length }
}

fn clone<Root, Owner>(value: Ref<GpuComputePipeline<Root, Owner>>) -> GpuComputePipeline<Root, Owner> {
	GpuComputePipeline<Root, Owner> { contract = value.contract }
}

fn clone<Root, Owner>(value: Ref<GpuGraphicsPipeline<Root, Owner>>) -> GpuGraphicsPipeline<Root, Owner> {
	GpuGraphicsPipeline<Root, Owner> { contract = value.contract }
}

// Opaque triangles, one mesh, and row-major affine instances. Builds finish before returning.
struct RaySceneOwner {
	handle: PtrMut<ResinRayScene>,
	gpu: Gpu,
}
fn drop(self: RefMut<RaySceneOwner>) {
	resin_gpu_free_ray_scene(self.handle);
}
struct GpuRayScene {
	owner: ArcPtr<RaySceneOwner>,
}
struct GpuRayTracingPipeline<Root, Owner> {
	contract: GpuPipelineContract,
}
intrinsic "gpu_ray_tracing_pipeline_type" fn ray_tracing_type<Root, Owner>(contract: GpuPipelineContract) -> GpuRayTracingPipeline<Root, Owner>;

/// Whether this GPU enables Vulkan ray tracing pipelines and acceleration structures.
fn supports_ray_tracing(self: Ref<Gpu>) -> bool {
	resin_gpu_supports_ray_tracing(self:native()) != 0
}

/// Copy non-indexed XYZ triangles and affine 3x4 instance transforms; wait for the builds.
fn create_ray_scene(self: Ref<Gpu>, vertices: SpanMut<f32>, transforms: SpanMut<f32>) -> (GpuRayScene | Err<RuntimeError>) {
	if (vertices.length == 0 || vertices.length % 9 != 0 || vertices.length / 3 > 4294967295 || transforms.length == 0 || transforms.length % 12 != 0 || transforms.length / 12 > 16777216) {
		return Err(InvalidArgument {});
	};
	let owner = arc_ptr_alloc(RaySceneOwner { handle = PtrMut<ResinRayScene>(u64(0)), gpu = self:clone() })?;
	runtime_status_from_code(resin_gpu_create_ray_scene(self:native(), vertices.data, u32(vertices.length / 3), transforms.data, u32(transforms.length / 12), &owner:get().handle))?;
	GpuRayScene { owner = owner }
}

/// Link direct ray-generation, miss, and closest-hit declarations; retain the scene.
@gpu_ray_tracing_pipeline
fn create_ray_tracing_pipeline(self: Ref<GpuRayScene>, generation: (Ptr<u8>, u64), miss: (Ptr<u8>, u64), hit: (Ptr<u8>, u64)) -> (GpuPipelineOwner | Err<RuntimeError>) {
	let owner = arc_ptr_alloc(PipelineOwner { handle = PtrMut<ResinPipeline>(u64(0)), gpu = self.owner:get().gpu:clone() })?;
	runtime_status_from_code(resin_gpu_create_ray_pipeline(self.owner:get().gpu:native(), self.owner:get().handle, generation.0, generation.1, miss.0, miss.1, hit.0, hit.1, &owner:get().handle))?;
	GpuPipelineOwner { owner = owner }
}

/// Record a ray launch with typed, retained root arguments. Dimensions count rays.
@gpu_trace_rays
fn trace_rays(self: Ref<GpuCommands>, pipeline: Ref<GpuPipelineOwner>, root: GpuArguments, x: u32, y: u32, z: u32) -> (() | Err<RuntimeError>) {
	self.owner:get():retain(pipeline:clone(), None)?;
	runtime_status_from_code(resin_gpu_set_pipeline(self:native(), pipeline:native()))?;
	runtime_status_from_code(root:trace_rays_native(PtrMut<u8>(self:native()), x, y, z))
}

/// Ray-generation only. Direction need not be normalized; min/max are ray parameters.
intrinsic "trace_ray" fn trace_ray<Payload>(ox: f32, oy: f32, oz: f32, dx: f32, dy: f32, dz: f32, minimum: f32, maximum: f32, initial: Payload) -> Payload;
/// Closest-hit only: distance parameter, primitive index, instance index, barycentric u/v.
intrinsic "ray_hit_info" fn ray_hit_info() -> (f32, u32, u32, f32, f32);

fn clone(value: Ref<GpuRayScene>) -> GpuRayScene {
	GpuRayScene { owner = value.owner:clone() }
}

fn clone<Root, Owner>(value: Ref<GpuRayTracingPipeline<Root, Owner>>) -> GpuRayTracingPipeline<Root, Owner> {
	GpuRayTracingPipeline<Root, Owner> { contract = value.contract }
}

intrinsic "gpu_view_load" fn gpu_view_load<T>(view: GpuView) -> T;
intrinsic "gpu_view_store" fn gpu_view_store<T>(view: GpuView, value: T) -> ();
