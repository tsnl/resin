export {
	Gpu,
	GpuBuffer,
	GpuImage,
	GpuPipeline,
	GpuCommands,
	Memory,
	ResinGpu,
	ResinGpuDeviceInfo,
	ResinAllocation,
	ResinImage,
	ResinPipeline,
	ResinCommandBuffer,
};

import { "status.resin", "window.resin" };

extern type ResinGpu;
extern type ResinGpuDeviceInfo;
extern type ResinAllocation;
extern type ResinImage;
extern type ResinPipeline;
extern type ResinCommandBuffer;

struct Memory {};
struct GpuOwner { handle: Ptr<ResinGpu>, window: Window | None };
type Gpu = Arc<GpuOwner>;
impl GpuOwner {
	def drop(self: Ptr<GpuOwner>) = {
		resin_gpu_destroy(self.handle);
	};

	def device_count() -> Result<uint, RuntimeError> = {
		var count = uint(0);
		RuntimeStatus.from_code(resin_gpu_device_count(&count))?;
		ok(count)
	};
	def enumerate_devices(infos: Ptr<ResinGpuDeviceInfo>, count: uint) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_gpu_enumerate_devices(infos, count))
	};
	def new() -> Result<Gpu, RuntimeError> = {
		var gpu = Ptr<ResinGpu>(ulong(0));
		RuntimeStatus.from_code(resin_gpu_create(&gpu))?;
		ok(Gpu { handle = gpu, window = None })
	};
	def new_at(index: uint) -> Result<Gpu, RuntimeError> = {
		var gpu = Ptr<ResinGpu>(ulong(0));
		RuntimeStatus.from_code(resin_gpu_create_at(index, &gpu))?;
		ok(Gpu { handle = gpu, window = None })
	};
	def malloc(self: Gpu, bytes: ulong, alignment: ulong, memory: int) -> Result<GpuBuffer, RuntimeError> = {
		var allocation = Ptr<ResinAllocation>(ulong(0));
		RuntimeStatus.from_code(resin_gpu_malloc(self.handle, bytes, alignment, memory, &allocation))?;
		ok(GpuBuffer { handle = allocation, gpu = self })
	};
	def host_to_device_pointer(self: Gpu, host: Ptr<ubyte>) -> Result<Ptr<ubyte>, RuntimeError> = {
		var device = ulong(0);
		RuntimeStatus.from_code(resin_gpu_host_to_device_pointer(self.handle, host, &device))?;
		ok(Ptr<ubyte>(device))
	};
	def create_compute_pipeline(self: Gpu, code: Span<ubyte>) -> Result<GpuPipeline, RuntimeError> = {
		var pipeline = Ptr<ResinPipeline>(ulong(0));
		RuntimeStatus.from_code(resin_gpu_create_compute_pipeline(self.handle, code.data, code.length, &pipeline))?;
		ok(GpuPipeline { handle = pipeline, gpu = self })
	};
	def create_graphics_pipeline(self: Gpu, vertex: Span<ubyte>, fragment: Span<ubyte>) -> Result<GpuPipeline, RuntimeError> = {
		var pipeline = Ptr<ResinPipeline>(ulong(0));
		RuntimeStatus.from_code(resin_gpu_create_graphics_pipeline(self.handle, vertex.data, vertex.length, fragment.data, fragment.length, &pipeline))?;
		ok(GpuPipeline { handle = pipeline, gpu = self })
	};
	def create_image(self: Gpu, width: uint, height: uint) -> Result<GpuImage, RuntimeError> = {
		var image = Ptr<ResinImage>(ulong(0));
		RuntimeStatus.from_code(resin_gpu_create_image(self.handle, width, height, &image))?;
		ok(GpuImage { handle = image, gpu = self })
	};
	def start_command_recording(self: Gpu) -> Result<GpuCommands, RuntimeError> = {
		var commands = Ptr<ResinCommandBuffer>(ulong(0));
		RuntimeStatus.from_code(resin_gpu_start_command_recording(self.handle, &commands))?;
		ok(GpuCommands { handle = commands, gpu = self, retained = None })
	};
	def new_for_window(window: Window) -> Result<Gpu, RuntimeError> = {
		var gpu = Ptr<ResinGpu>(ulong(0));
		RuntimeStatus.from_code(resin_gpu_create_for_window(window.handle, &gpu))?;
		ok(Gpu { handle = gpu, window = window })
	};
	def present(self: Gpu, image: GpuImage) -> Result<bool, RuntimeError> = {
		var code = resin_gpu_present(self.handle, image.handle);
		if (code == 7) {
			ok(1 == 0)
		} else {
			RuntimeStatus.from_code(code)?;
			ok(1 == 1)
		}
	};
}

struct BufferOwner { handle: Ptr<ResinAllocation>, gpu: Gpu };
type GpuBuffer = Arc<BufferOwner>;
impl BufferOwner {
	def drop(self: Ptr<BufferOwner>) = {
		resin_gpu_free(self.gpu.handle, self.handle);
	};

	def host_pointer(self: Ptr<BufferOwner>) -> Ptr<ubyte> = {
		resin_allocation_host_pointer(self.handle)
	};
	def device_pointer(self: Ptr<BufferOwner>) -> Ptr<ubyte> = {
		Ptr<ubyte>(resin_allocation_device_pointer(self.handle))
	};
	def size(self: GpuBuffer) -> ulong = {
		resin_allocation_size(self.handle)
	};
}

struct ImageOwner { handle: Ptr<ResinImage>, gpu: Gpu };
type GpuImage = Arc<ImageOwner>;
impl ImageOwner {
	def drop(self: Ptr<ImageOwner>) = {
		resin_gpu_free_image(self.gpu.handle, self.handle);
	};

	def width(self: GpuImage) -> uint = {
		resin_image_width(self.handle)
	};
	def height(self: GpuImage) -> uint = {
		resin_image_height(self.handle)
	};
}

struct PipelineOwner { handle: Ptr<ResinPipeline>, gpu: Gpu };
type GpuPipeline = Arc<PipelineOwner>;
impl PipelineOwner {
	def drop(self: Ptr<PipelineOwner>) = {
		resin_gpu_free_pipeline(self.gpu.handle, self.handle);
	};
}

// Retain resources mentioned by recorded commands until synchronous submit or cancellation.
struct RecordedResources {
	pipeline: GpuPipeline | None,
	image: GpuImage | None,
	buffer: GpuBuffer | None,
	previous: Arc<RecordedResources> | None,
};
struct CommandsOwner { handle: Ptr<ResinCommandBuffer>, gpu: Gpu, retained: Arc<RecordedResources> | None };
type GpuCommands = Arc<CommandsOwner>;
impl CommandsOwner {
	def drop(self: Ptr<CommandsOwner>) = {
		resin_gpu_cancel_command_buffer(self.gpu.handle, self.handle);
	};
	def retain(self: Ptr<CommandsOwner>, pipeline: GpuPipeline | None, image: GpuImage | None, buffer: GpuBuffer | None) = {
		self.retained := Arc<RecordedResources> { pipeline = pipeline, image = image, buffer = buffer, previous = self.retained };
	};

	def set_pipeline(self: GpuCommands, pipeline: GpuPipeline) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_gpu_set_pipeline(self.handle, pipeline.handle))?;
		self.retain(pipeline, None, None);
		ok(())
	};
	def dispatch(self: GpuCommands, root: GpuBuffer, x: uint, y: uint, z: uint) -> Result<(), RuntimeError> = {
		var address = command_root_address(self.gpu.handle, root)?;
		RuntimeStatus.from_code(resin_gpu_dispatch(self.handle, address, x, y, z))?;
		self.retain(None, None, root);
		ok(())
	};
	def begin_rendering(self: GpuCommands, image: GpuImage, r: float32, g: float32, b: float32, a: float32) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_gpu_begin_rendering(self.handle, image.handle, r, g, b, a))?;
		self.retain(None, image, None);
		ok(())
	};
	def end_rendering(self: GpuCommands) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_gpu_end_rendering(self.handle))
	};
	def draw(self: GpuCommands, root: GpuBuffer | None, count: uint) -> Result<(), RuntimeError> = {
		match (root) {
			GpuBuffer(buffer) => {
				var address = command_root_address(self.gpu.handle, buffer)?;
				RuntimeStatus.from_code(resin_gpu_draw(self.handle, address, count))?;
				self.retain(None, None, buffer);
				ok(())
			},
			None => {
				RuntimeStatus.from_code(resin_gpu_draw(self.handle, 0_ul, count))
			},
		}
	};
	def copy_image_to_buffer(self: GpuCommands, image: GpuImage, buffer: GpuBuffer) -> Result<(), RuntimeError> = {
		RuntimeStatus.from_code(resin_gpu_copy_image_to_buffer(self.handle, image.handle, buffer.handle))?;
		self.retain(None, image, buffer);
		ok(())
	};
	def submit(self: Ptr<CommandsOwner>) -> Result<(), RuntimeError> = {
		var recording = (&self.handle).replace(Ptr<ResinCommandBuffer>(0_ul));
		var code = resin_gpu_submit(self.gpu.handle, recording);
		self.retained := None;
		RuntimeStatus.from_code(code)
	};
	def cancel(self: Ptr<CommandsOwner>) = {
		var recording = (&self.handle).replace(Ptr<ResinCommandBuffer>(0_ul));
		resin_gpu_cancel_command_buffer(self.gpu.handle, recording);
		self.retained := None;
	};
}

def command_root_address(gpu: Ptr<ResinGpu>, root: GpuBuffer) -> Result<ulong, RuntimeError> = {
	if (gpu == root.gpu.handle) {
		ok(resin_allocation_device_pointer(root.handle))
	} else {
		err(InvalidArgument {})
	}
};

impl Memory {
	def default() -> int = {
		0
	};
	def gpu() -> int = {
		1
	};
	def readback() -> int = {
		2
	};
}

extern "resin_runtime.h" def resin_gpu_device_count(count: Ptr<uint>) -> int;
extern "resin_runtime.h" def resin_gpu_enumerate_devices(infos: Ptr<ResinGpuDeviceInfo>, count: uint) -> int;
extern "resin_runtime.h" def resin_gpu_create(gpu: Ptr<Ptr<ResinGpu>>) -> int;
extern "resin_runtime.h" def resin_gpu_create_at(index: uint, gpu: Ptr<Ptr<ResinGpu>>) -> int;
extern "resin_runtime.h" def resin_gpu_destroy(gpu: Ptr<ResinGpu>) -> ();
extern "resin_runtime.h" def resin_gpu_malloc(gpu: Ptr<ResinGpu>, bytes: ulong, alignment: ulong, memory: int, allocation: Ptr<Ptr<ResinAllocation>>) -> int;
extern "resin_runtime.h" def resin_gpu_free(gpu: Ptr<ResinGpu>, allocation: Ptr<ResinAllocation>) -> ();
extern "resin_runtime.h" def resin_allocation_host_pointer(allocation: Ptr<ResinAllocation>) -> Ptr<ubyte>;
extern "resin_runtime.h" def resin_allocation_device_pointer(allocation: Ptr<ResinAllocation>) -> ulong;
extern "resin_runtime.h" def resin_allocation_size(allocation: Ptr<ResinAllocation>) -> ulong;
extern "resin_runtime.h" def resin_gpu_host_to_device_pointer(gpu: Ptr<ResinGpu>, host: Ptr<ubyte>, device: Ptr<ulong>) -> int;
extern "resin_runtime.h" def resin_gpu_create_compute_pipeline(gpu: Ptr<ResinGpu>, code: Ptr<ubyte>, length: ulong, pipeline: Ptr<Ptr<ResinPipeline>>) -> int;
extern "resin_runtime.h" def resin_gpu_create_graphics_pipeline(gpu: Ptr<ResinGpu>, vertex: Ptr<ubyte>, vertex_length: ulong, fragment: Ptr<ubyte>, fragment_length: ulong, pipeline: Ptr<Ptr<ResinPipeline>>) -> int;
extern "resin_runtime.h" def resin_gpu_free_pipeline(gpu: Ptr<ResinGpu>, pipeline: Ptr<ResinPipeline>) -> ();
extern "resin_runtime.h" def resin_gpu_create_image(gpu: Ptr<ResinGpu>, width: uint, height: uint, image: Ptr<Ptr<ResinImage>>) -> int;
extern "resin_runtime.h" def resin_gpu_free_image(gpu: Ptr<ResinGpu>, image: Ptr<ResinImage>) -> ();
extern "resin_runtime.h" def resin_image_width(image: Ptr<ResinImage>) -> uint;
extern "resin_runtime.h" def resin_image_height(image: Ptr<ResinImage>) -> uint;
extern "resin_runtime.h" def resin_gpu_start_command_recording(gpu: Ptr<ResinGpu>, commands: Ptr<Ptr<ResinCommandBuffer>>) -> int;
extern "resin_runtime.h" def resin_gpu_set_pipeline(commands: Ptr<ResinCommandBuffer>, pipeline: Ptr<ResinPipeline>) -> int;
extern "resin_runtime.h" def resin_gpu_dispatch(commands: Ptr<ResinCommandBuffer>, root: ulong, x: uint, y: uint, z: uint) -> int;
extern "resin_runtime.h" def resin_gpu_begin_rendering(commands: Ptr<ResinCommandBuffer>, image: Ptr<ResinImage>, r: float32, g: float32, b: float32, a: float32) -> int;
extern "resin_runtime.h" def resin_gpu_end_rendering(commands: Ptr<ResinCommandBuffer>) -> int;
extern "resin_runtime.h" def resin_gpu_draw(commands: Ptr<ResinCommandBuffer>, root: ulong, count: uint) -> int;
extern "resin_runtime.h" def resin_gpu_copy_image_to_buffer(commands: Ptr<ResinCommandBuffer>, image: Ptr<ResinImage>, buffer: Ptr<ResinAllocation>) -> int;
extern "resin_runtime.h" def resin_gpu_submit(gpu: Ptr<ResinGpu>, commands: Ptr<ResinCommandBuffer>) -> int;
extern "resin_runtime.h" def resin_gpu_cancel_command_buffer(gpu: Ptr<ResinGpu>, commands: Ptr<ResinCommandBuffer>) -> ();
extern "resin_runtime.h" def resin_gpu_create_for_window(window: Ptr<ResinWindow>, gpu: Ptr<Ptr<ResinGpu>>) -> int;
extern "resin_runtime.h" def resin_gpu_present(gpu: Ptr<ResinGpu>, image: Ptr<ResinImage>) -> int;
