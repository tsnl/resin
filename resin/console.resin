export {
	Console,
	InputLine,
	InputError,
	EndOfInput,
	InputReadError,
	InputOutOfMemory,
	InputWriteError,
};

extern {
	"stdio.h": {
		def getchar() -> int;
		def putchar(byte: int) -> int;
	},
	"resin_runtime/console.h": {
		def resin_stdin_error() -> int;
		def resin_stdout_flush() -> int;
	},
	"stdlib.h": {
		def realloc(memory: Ptr<ubyte>, bytes: ulong) -> Ptr<ubyte>;
		def free(memory: Ptr<ubyte>);
	},
};

import { "span.resin", "shared.resin" };

const initial_input_capacity = 128_ul;
const max_input_capacity = ~0_ul;
const line_feed: int = 10;
const carriage_return: ubyte = 13;

// Owns length bytes followed by a NUL. Copies retain the allocation.
struct InputLineOwner {
	data: Ptr<ubyte>,
	length: ulong,
	def drop(self: Ptr<InputLineOwner>) = {
		if (ulong(self.data) != 0_ul) {
			free(self.data);
		};
	};
};
struct InputLine {
	owner: ArcPtr<InputLineOwner>,
	def get(self: Ptr<InputLine>) -> Span<ubyte> = {
		var data = self.owner.get();
		Span<ubyte> { data = data.data, length = data.length }
	};
	def bytes(self: Ptr<InputLine>) -> { data: Ptr<ubyte>, length: ulong } = {
		var view = self.get();
		{ data = view.data, length = view.length }
	};
};

struct EndOfInput {};
struct InputReadError {};
struct InputOutOfMemory {};
struct InputWriteError {};
type InputError = EndOfInput | InputReadError | InputOutOfMemory;

def resize_input(memory: Ptr<ubyte>, capacity: ulong) -> Result<Ptr<ubyte>, InputOutOfMemory> = {
	var resized = realloc(memory, capacity);
	if (ulong(resized) == 0_ul) {
		err(InputOutOfMemory {})
	} else {
		ok(resized)
	}
};

def check_input_end(byte: int, length: ulong) -> Result<(), EndOfInput | InputReadError> = {
	if (byte < 0 && resin_stdin_error() != 0) {
		err(InputReadError {})
	} else {
		if (byte < 0 && length == 0_ul) {
			err(EndOfInput {})
		} else {
			ok(())
		}
	}
};

struct Console {
	// Writes every byte (including embedded NULs), flushes, and adds no newline.
	def print(line: InputLine) -> Result<(), InputWriteError> = {
		var bytes = line.get();
		var index = 0_ul;
		var written = 0;
		while (index < bytes.length && written >= 0) {
			written := putchar(int(bytes.at(index)));
			index := index + 1_ul;
		};
		var flushed = resin_stdout_flush();
		if (written < 0 || flushed != 0) {
			err(InputWriteError {})
		} else {
			ok(())
		}
	};

	def read_byte() -> Result<ubyte, EndOfInput | InputReadError> = {
		var byte = getchar();
		check_input_end(byte, 0_ul)?;
		ok(ubyte(byte))
	};
	// Reads bytes through LF or EOF; only CR immediately before LF is stripped.
	def read_line() -> Result<InputLine, InputError> = {
		var owner = match (ArcPtr<InputLineOwner>.alloc(InputLineOwner { data = Ptr<ubyte>(0_ul), length = 0_ul })) {
			ok(value) => {
				ok(value)
			},
			err(error) => {
				err(InputOutOfMemory {})
			},
		}?;
		var storage = owner.get();
		storage.data := resize_input(Ptr<ubyte>(0_ul), initial_input_capacity)?;
		storage.length := initial_input_capacity;
		var length = 0_ul;
		var byte = getchar();
		while (byte >= 0 && byte != line_feed) {
			if (length == storage.length - 1_ul) {
				// Reserve the terminator and reject growth that would wrap.
				var grown: Result<ulong, InputOutOfMemory>;
				grown := if (storage.length > max_input_capacity / 2_ul) {
					err(InputOutOfMemory {})
				} else {
					ok(storage.length * 2_ul)
				};
				var capacity = grown?;
				storage.data := resize_input(storage.data, capacity)?;
				storage.length := capacity;
			};
			Span<ubyte> { data = storage.data, length = storage.length }.at(length) := ubyte(byte);
			length := length + 1_ul;
			byte := getchar();
		};
		check_input_end(byte, length)?;
		if (byte == line_feed && length > 0_ul) {
			if (Span<ubyte> { data = storage.data, length = storage.length }.at(length - 1_ul) == carriage_return) {
				length := length - 1_ul;
			};
		};
		Span<ubyte> { data = storage.data, length = storage.length }.at(length) := 0_ub;
		storage.length := length;
		ok(InputLine { owner = owner })
	};
};
