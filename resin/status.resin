export {
	RuntimeError,
	InvalidArgument,
	VulkanUnavailable,
	Unsupported,
	OutOfMemory,
	VulkanError,
	IoError,
	Incomplete,
	WindowUnavailable,
	UnknownRuntimeError,
	RuntimeStatus,
};

import { "internal/status_codes.resin" };

struct InvalidArgument {};
struct VulkanUnavailable {};
struct Unsupported {};
struct OutOfMemory {};
struct VulkanError {};
struct IoError {};
struct Incomplete {};
struct WindowUnavailable {};
struct UnknownRuntimeError { code: int };
type RuntimeError = InvalidArgument | VulkanUnavailable | Unsupported | OutOfMemory | VulkanError | IoError | Incomplete | WindowUnavailable | UnknownRuntimeError;

struct RuntimeStatus {
	def from_code(code: int) -> Result<(), RuntimeError> = {
		if (code == status_invalid_argument) {
			err(InvalidArgument {})
		} else {
			ok(())
		}?;
		if (code == status_vulkan_unavailable) {
			err(VulkanUnavailable {})
		} else {
			ok(())
		}?;
		if (code == status_unsupported) {
			err(Unsupported {})
		} else {
			ok(())
		}?;
		if (code == status_out_of_memory) {
			err(OutOfMemory {})
		} else {
			ok(())
		}?;
		if (code == status_vulkan_error) {
			err(VulkanError {})
		} else {
			ok(())
		}?;
		if (code == status_io_error) {
			err(IoError {})
		} else {
			ok(())
		}?;
		if (code == status_incomplete) {
			err(Incomplete {})
		} else {
			ok(())
		}?;
		if (code == status_window_unavailable) {
			err(WindowUnavailable {})
		} else {
			ok(())
		}?;
		if (code == status_success) {
			ok(())
		} else {
			err(UnknownRuntimeError { code = code })
		}
	};
	def code(error: RuntimeError) -> int = {
		match (error) {
			InvalidArgument(error) => {
				status_invalid_argument
			},
			VulkanUnavailable(error) => {
				status_vulkan_unavailable
			},
			Unsupported(error) => {
				status_unsupported
			},
			OutOfMemory(error) => {
				status_out_of_memory
			},
			VulkanError(error) => {
				status_vulkan_error
			},
			IoError(error) => {
				status_io_error
			},
			Incomplete(error) => {
				status_incomplete
			},
			WindowUnavailable(error) => {
				status_window_unavailable
			},
			UnknownRuntimeError(error) => {
				error.code
			},
		}
	};
	def message(error: RuntimeError) -> Ptr<ubyte> = {
		resin_status_string(RuntimeStatus.code(error))
	};
};

extern "resin_runtime.h" def resin_status_string(status: int) -> Ptr<ubyte>;
