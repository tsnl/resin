export { Io, Output, WriteError };

extern {
	"resin_runtime/print.h": {
		def resin_stream_write(stream: uint, data: Ptr<ubyte>, length: ulong) -> int;
	},
};

import { "span.resin", "string.resin" };

struct WriteError {};
struct Output {
	stream: uint,
	// Writes bytes verbatim and flushes. No formatting or newline is added.
	def write(self: Output, text: str | Span<ubyte> | String) -> Result<(), WriteError> = {
		var status = match (text) {
			str(literal) => {
				resin_stream_write(self.stream, literal.data, literal.length)
			},
			Span<ubyte>(bytes) => {
				resin_stream_write(self.stream, bytes.data, bytes.length)
			},
			String(string) => {
				resin_stream_write(self.stream, string.get().data, string.get().length)
			},
		};
		if (status == 0) {
			ok(())
		} else {
			err(WriteError {})
		}
	};
};
struct Io {
	def stdout() -> Output = {
		Output { stream = 0_ui }
	};
	def stderr() -> Output = {
		Output { stream = 1_ui }
	};
};
