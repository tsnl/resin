export { Io, Output, WriteError, write, io_stdout, io_stderr };

extern {
	"resin_runtime/print.h": {
		fn resin_stream_write(stream: uint, data: Ptr<ubyte>, length: ulong) -> int;
	},
};

import { "span.resin", "string.resin" };

// Native stream selectors for resin_stream_write.
const (
	stream_stdout: uint = iota;
	stream_stderr: uint = iota;
);

struct WriteError {}
struct Output {
	stream: uint,
	// Writes bytes verbatim and flushes. No formatting or newline is added.
}
fn write(self: Ref<Output>, text: str | Span<ubyte> | String) -> (() | Err<WriteError>) {
	let mut status = match (text) {
		str(literal) => {
			resin_stream_write(self.stream, literal.data, literal.length)
		},
		Span<ubyte>(bytes) => {
			resin_stream_write(self.stream, bytes.data, bytes.length)
		},
		String(string) => {
			resin_stream_write(self.stream, string:get().data, string:get().length)
		},
	};
	if (status == 0) {
		(())
	} else {
		Err(WriteError {})
	}
}

struct Io {}
fn io_stdout() -> Output {
	Output { stream = stream_stdout }
}

fn io_stderr() -> Output {
	Output { stream = stream_stderr }
}
