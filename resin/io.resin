export { Io, Output, WriteError };

import { "span.resin", "string.resin" };

// Native stream selectors for resin_stream_write.
const (
	stream_stdout: uint = iota;
	stream_stderr;
);

struct WriteError {};
struct Output {
	stream: uint,
	// Writes bytes verbatim and flushes. No formatting or newline is added.
	def write(self: Output, text: str | Span<ubyte> | String) -> Result<(), WriteError> = {
		var status = match (text) {
			str(literal) => {
				resin_stream_write(self.stream, literal.data, literal.length)
			},
			Span<ubyte>(bytes) => {
				resin_stream_write(self.stream, bytes.data, bytes.length)
			},
			String(string) => {
				resin_stream_write(self.stream, string.get().data, string.get().length)
			},
		};
		if (status == 0) {
			ok(())
		} else {
			err(WriteError {})
		}
	};
};
struct Io {
	def stdout() -> Output = {
		Output { stream = stream_stdout }
	};
	def stderr() -> Output = {
		Output { stream = stream_stderr }
	};
};

extern "resin_runtime/print.h" def resin_stream_write(stream: uint, data: Ptr<ubyte>, length: ulong) -> int;
