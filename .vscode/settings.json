{
    "files.associations": {
        ".clang-tidy": "yaml",
        ".clang-format": "yaml"
    },
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "editor.tabSize": 4,
    "editor.rulers": [
        88
    ],
    "[c][cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    }
}